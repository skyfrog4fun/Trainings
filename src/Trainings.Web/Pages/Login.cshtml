@page "/login"

@model Trainings.Web.Pages.LoginModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Trainings</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-12 col-sm-8 col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h2 class="card-title text-center mb-4"><img class="icon-login" src="logo.svg" alt="T" />rainings</h2>
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }
                        <form method="post">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control form-control-lg" id="email" name="Email" value="@Model.Email" required autofocus />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control form-control-lg" id="password" name="Password" required />
                            </div>
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>
                        </form>
                        <div class="row mt-2">
                            <a href="/register" class="col-6 text-start text-decoration-none small">Register</a>
                            <a href="/forgot-password" class="col-6 text-end text-decoration-none small">Forgot password?</a>
                        </div>
                        @if (Model.ShowInitialCredentials)
                        {
                            <div class="alert alert-info mt-3 small">
                                <strong>Initial Setup</strong><br />
                                No users exist yet. Use these default credentials to log in:<br />
                                <strong>Email:</strong> @Model.SeedEmail<br />
                                <strong>Password:</strong> Admin123!
                            </div>
                        }
                        <div class="text-end mt-2">
                            <small class="text-muted">v@(Model.AppVersion)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
