@inject IUserService UserService
@inject IDateTimeFormatService DateTimeFormatService

<div class="list-group">
    @foreach (var t in Trainings)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="mb-1">@t.Title</h6>
                    <small class="text-muted">@FormatTrainingDate(t) · @(t.LocationName ?? "-")</small>
                    <br/><small><i class="fa-solid fa-users me-1" aria-hidden="true"></i>@t.RegisteredCount / @t.Capacity · <i class="fa-solid fa-user me-1" aria-hidden="true"></i>@t.TrainerName</small>
                </div>
                <div>
                    <a href="/trainings/@t.Id" class="btn btn-sm btn-outline-primary">Details</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<TrainingDto> Trainings { get; set; } = new();
    [Parameter] public bool ShowActions { get; set; } = false;
    [Parameter] public bool ShowRegisterButton { get; set; } = false;
    [Parameter] public int CurrentUserId { get; set; }
    private string _userCountry = "CH";

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentUserId > 0)
        {
            _userCountry = (await UserService.GetByIdAsync(CurrentUserId))?.CountryCode ?? DateTimeFormatService.GetDefaultCountry();
        }
    }

    private string FormatTrainingDate(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return training.DateTime.ToString("g", culture);
    }
}
