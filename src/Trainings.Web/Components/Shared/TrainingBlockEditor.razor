@inject ITrainingService TrainingService
@inject ITrainingBlockService TrainingBlockService
@inject ITrainingBlockLibraryService TrainingBlockLibraryService
@inject ITagAdminService TagAdminService
@inject IGameAdminService GameAdminService

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<PageTitleComponent Icon="@AppIcons.BookOpen"
                    Text="@Localizer["TrainingBlockEditor_Heading"]"
                    ButtonText="@Localizer["TrainingBlockEditor_NewButton"]"
                    ButtonIcon="@AppIcons.Plus"
                    ButtonDisabled="@(_isLoading || IsWriteBlocked || !_hasTrainingContext)"
                    OnButtonClick="OpenNewPanel"
                    SecondaryButtonText="@Localizer["TrainingBlockEditor_AddButton"]"
                    SecondaryButtonIcon="@AppIcons.BookOpen"
                    SecondaryButtonCssClass="btn btn-outline-secondary"
                    SecondaryButtonDisabled="@(_isLoading || IsWriteBlocked || !_hasTrainingContext)"
                    OnSecondaryButtonClick="OpenAddPanel" />

@if (_isLoading)
{
    <LoadingSpinner />
}
else if (!_hasTrainingContext)
{
    <div class="alert alert-info mb-3">@Localizer["TrainingBlockEditor_PreviewNotice"]</div>
}
else
{
    @if (_panel == EditorPanel.Add)
    {
        <CardComponent CssClass="mb-3" IsCollapsable="false" ShowFooter="true">
            <Title>@Localizer["TrainingBlockEditor_AddSectionTitle"]</Title>
            <Body>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label">@Localizer["TrainingBlockEditor_TagFilterLabel"]</label>
                        <SelectDropdownComponent TItem="TagDto"
                                                 TValue="int?"
                                                 @bind-Value="_libraryTagId"
                                                 Items="_tags"
                                                 ValueSelector="tag => (int?)tag.Id"
                                                 TextSelector="tag => tag.Name"
                                                 PlaceholderText="@Localizer["TrainingBlockEditor_AllTagsOption"]" />
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label">@Localizer["TrainingBlockEditor_CreatorFilterLabel"]</label>
                        <SelectDropdownComponent TItem="TrainingBlockLibraryCreatorDto"
                                                 TValue="int?"
                                                 @bind-Value="_libraryCreatorId"
                                                 Items="_libraryCreators"
                                                 ValueSelector="creator => (int?)creator.CreatorId"
                                                 TextSelector="creator => creator.CreatorName"
                                                 PlaceholderText="@Localizer["TrainingBlockEditor_AllCreatorsOption"]" />
                    </div>
                    <div class="col-6 col-xl-2">
                        <label class="form-label">@Localizer["TrainingBlockEditor_MinDurationLabel"]</label>
                        <InputNumber class="form-control" @bind-Value="_libraryMinDuration" />
                    </div>
                    <div class="col-6 col-xl-2">
                        <label class="form-label">@Localizer["TrainingBlockEditor_MaxDurationLabel"]</label>
                        <InputNumber class="form-control" @bind-Value="_libraryMaxDuration" />
                    </div>
                    <div class="col-12 col-xl-2">
                        <label class="form-label">@Localizer["TrainingBlockEditor_SearchLabel"]</label>
                        <InputText class="form-control" @bind-Value="_librarySearchText" placeholder="@Localizer["TrainingBlockEditor_SearchPlaceholder"]" />
                    </div>
                </div>
            </Body>
            <Footer>
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" @onclick="SearchLibraryAsync" disabled="@IsWriteBlocked">
                        <i class="@AppIcons.Filter me-1" aria-hidden="true"></i>@Localizer["TrainingBlockEditor_SearchButton"]
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ClosePanel">
                        <i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]
                    </button>
                </div>
            </Footer>
        </CardComponent>

        <CardComponent CssClass="mb-3" IsCollapsable="false">
            <Title>@Localizer["TrainingBlockEditor_LibraryResultsTitle"]</Title>
            <Body>
                @if (!_librarySearchPerformed)
                {
                    <div class="alert alert-info mb-0">@Localizer["TrainingBlockEditor_LibrarySearchPrompt"]</div>
                }
                else if (_libraryResults.Count == 0)
                {
                    <div class="alert alert-info mb-0">@Localizer["TrainingBlockEditor_NoLibraryResults"]</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var definition in _libraryResults)
                        {
                            <div class="card tb-card @GetStripeCssClass(definition.TagColorToken)">
                                <div class="card-body d-flex justify-content-between gap-3">
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between gap-2 align-items-start">
                                            <div class="fw-semibold text-truncate">@definition.Title</div>
                                            <div class="text-muted text-nowrap small"><i class="@AppIcons.Stopwatch me-1" aria-hidden="true"></i>@definition.DurationMinutes</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(definition.Description))
                                        {
                                            <div class="text-muted small tb-card-description">@definition.Description</div>
                                        }
                                        <div class="text-muted small mt-2">@definition.CreatorName</div>
                                    </div>
                                    <div class="d-flex flex-column justify-content-between align-items-end tb-card-action-column">
                                        <button type="button"
                                                class="btn btn-sm btn-app-outline btn-app-icon tb-card-icon-button"
                                                @onclick="() => AddDefinitionAsync(definition.Id)"
                                                aria-label="@string.Format(Localizer["TrainingBlockEditor_AddLibraryItemAria"].Value, definition.Title)"
                                                disabled="@IsWriteBlocked">
                                            <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                        </button>
                                        <div class="tb-tag-text text-muted text-end">@FormatDefinitionType(definition)</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_libraryHasMore)
                    {
                        <div class="text-center mt-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="LoadMoreLibraryAsync" disabled="@IsWriteBlocked">@Localizer["TrainingBlockEditor_LoadMoreButton"]</button>
                        </div>
                    }
                }
            </Body>
        </CardComponent>
    }

    @if (_panel == EditorPanel.New)
    {
        <EditForm Model="_createForm" OnValidSubmit="CreateBlockAsync">
            <DataAnnotationsValidator />
            <CardComponent CssClass="mb-3" IsCollapsable="false" ShowFooter="true">
                <Title>@Localizer["TrainingBlockEditor_NewSectionTitle"]</Title>
                <Body>
                    <div class="row g-2">
                        <div class="col-12 @(_createForm.RequiresGame ? "col-md-4" : "")">
                            <label class="form-label">@Localizer["TrainingBlockEditor_TagLabel"]</label>
                            <SelectDropdownComponent TItem="TagDto"
                                                     TValue="int?"
                                                     @bind-Value="_createForm.TagId"
                                                     @bind-Value:after="OnCreateTagChangedAsync"
                                                     Items="_tags"
                                                     ValueSelector="tag => (int?)tag.Id"
                                                     TextSelector="tag => tag.Name"
                                                     PlaceholderText="@Localizer["TrainingBlockEditor_SelectTagPlaceholder"]" />
                            <ValidationMessage For="() => _createForm.TagId" class="text-danger small" />
                        </div>

                        @if (_createForm.RequiresGame)
                        {
                            <div class="@(_createForm.GameId is null ? "col-6 col-md-4" : "col-12 col-md-8")">
                                <label class="form-label">@Localizer["TrainingBlockEditor_GameLabel"]</label>
                                <SelectDropdownComponent TItem="GameDto"
                                                         TValue="int?"
                                                         @bind-Value="_createForm.GameId"
                                                         Items="_games"
                                                         ValueSelector="game => (int?)game.Id"
                                                         TextSelector="game => game.DisplayText"
                                                         Searchable="true"
                                                         SearchPlaceholder="@Localizer["TrainingBlockEditor_GameSearchPlaceholder"]"
                                                         NoResultsText="@Localizer["TrainingBlockEditor_NoGamesFound"]"
                                                         PlaceholderText="@Localizer["TrainingBlockEditor_SelectGamePlaceholder"]" />
                                <ValidationMessage For="() => _createForm.GameId" class="text-danger small" />
                            </div>
                            @if (_createForm.GameId is null)
                            {
                                <div class="col-6 col-md-4">
                                    <label class="form-label d-block">&nbsp;</label>
                                    <InputText class="form-control" @bind-Value="_createForm.NewGameName" placeholder="@Localizer["TrainingBlockEditor_NewGamePlaceholder"]" />
                                </div>
                                <div class="col-12">
                                    <div class="form-text">@Localizer["TrainingBlockEditor_NewGameHelp"]</div>
                                </div>
                            }
                        }

                        <div class="col-12">
                            <label class="form-label">@Localizer["TrainingBlockEditor_TitleLabel"]</label>
                            <InputText class="form-control" maxlength="64" @bind-Value="_createForm.Title" />
                            <ValidationMessage For="() => _createForm.Title" class="text-danger small" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["TrainingBlockEditor_DescriptionLabel"]</label>
                            <InputTextArea class="form-control" rows="3" maxlength="512" @bind-Value="_createForm.Description" />
                            <ValidationMessage For="() => _createForm.Description" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer["TrainingBlockEditor_DurationFieldLabel"]</label>
                            <InputNumber class="form-control" @bind-Value="_createForm.DurationMinutes" />
                            <ValidationMessage For="() => _createForm.DurationMinutes" class="text-danger small" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label">@Localizer["TrainingBlockEditor_MinParticipantsLabel"]</label>
                            <InputNumber class="form-control" @bind-Value="_createForm.MinParticipants" />
                            <ValidationMessage For="() => _createForm.MinParticipants" class="text-danger small" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label">@Localizer["TrainingBlockEditor_MaxParticipantsLabel"]</label>
                            <InputNumber class="form-control" @bind-Value="_createForm.MaxParticipants" />
                            <ValidationMessage For="() => _createForm.MaxParticipants" class="text-danger small" />
                        </div>
                    </div>
                </Body>
                <Footer>
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@IsWriteBlocked">
                            <i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="ClosePanel">
                            <i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]
                        </button>
                    </div>
                </Footer>
            </CardComponent>
        </EditForm>
    }

    @if (_executions.Count == 0)
    {
        <div class="alert alert-info mb-3">@Localizer["TrainingBlockEditor_NoBlocksMessage"]</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-3">
            @foreach (var block in _executions)
            {
                <div class="card tb-card @GetStripeCssClass(block.TagColorToken)">
                    <div class="card-body">
                        @if (_editingExecutionId == block.Id)
                        {
                            <EditForm Model="_editForm" OnValidSubmit="SaveExecutionAsync">
                                <DataAnnotationsValidator />
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_TitleLabel"]</label>
                                        <InputText class="form-control" maxlength="64" @bind-Value="_editForm.Title" />
                                        <ValidationMessage For="() => _editForm.Title" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_DurationFieldLabel"]</label>
                                        <InputNumber class="form-control" @bind-Value="_editForm.PlannedDurationMinutes" />
                                        <ValidationMessage For="() => _editForm.PlannedDurationMinutes" class="text-danger small" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_DescriptionLabel"]</label>
                                        <InputTextArea class="form-control" rows="3" maxlength="512" @bind-Value="_editForm.Description" />
                                        <ValidationMessage For="() => _editForm.Description" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_MinParticipantsLabel"]</label>
                                        <InputNumber class="form-control" @bind-Value="_editForm.MinParticipants" />
                                        <ValidationMessage For="() => _editForm.MinParticipants" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_MaxParticipantsLabel"]</label>
                                        <InputNumber class="form-control" @bind-Value="_editForm.MaxParticipants" />
                                        <ValidationMessage For="() => _editForm.MaxParticipants" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_EffectiveDurationLabel"]</label>
                                        <InputNumber class="form-control" @bind-Value="_editForm.EffectiveDurationMinutes" />
                                        <ValidationMessage For="() => _editForm.EffectiveDurationMinutes" class="text-danger small" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">@Localizer["TrainingBlockEditor_TrainerCommentLabel"]</label>
                                        <InputTextArea class="form-control" rows="2" @bind-Value="_editForm.TrainerComment" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
                                    <button type="submit" class="btn btn-primary" disabled="@IsWriteBlocked">
                                        <i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="CancelEditExecution">
                                        <i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]
                                    </button>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between gap-3">
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div class="fw-semibold text-truncate">@block.OrderIndex. @block.Title</div>
                                        <div class="tb-tag-text text-muted text-nowrap d-flex align-items-center gap-1">
                                            <i class="@AppIcons.Stopwatch" aria-hidden="true"></i>@block.PlannedDurationMinutes
                                            <span>@FormatExecutionType(block)</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(block.Description))
                                    {
                                        <div class="text-muted mt-1">
                                            <ExpandableTextComponent Text="@block.Description"
                                                                      MaxLines="2"
                                                                      StartCollapsed="true"
                                                                      ShowMoreLabel="@Localizer["Shared_ShowMore"]"
                                                                      ShowLessLabel="@Localizer["Shared_ShowLess"]" />
                                        </div>
                                    }
                                </div>
                                <div class="d-flex gap-2 tb-card-actions">
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-app-icon tb-card-icon-button" @onclick="() => StartEditExecution(block)" disabled="@IsWriteBlocked" aria-label="@string.Format(Localizer["TrainingBlockEditor_AdjustExecutionAria"].Value, block.Title)">
                                            <i class="@AppIcons.TrainingBlockAdjust" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-app-icon tb-card-icon-button" @onclick="() => DeleteExecutionAsync(block.Id)" disabled="@IsWriteBlocked" aria-label="@string.Format(Localizer["TrainingBlockEditor_DeleteExecutionAria"].Value, block.Title)">
                                            <i class="@AppIcons.TrainingBlockDelete" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div class="d-flex flex-column gap-2 tb-card-move-buttons">
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-app-icon tb-card-icon-button" @onclick="() => MoveExecutionUpAsync(block.Id)" disabled="@(IsWriteBlocked || block.OrderIndex == 1)" aria-label="@string.Format(Localizer["TrainingBlockEditor_MoveUpAria"].Value, block.Title)">
                                            <i class="@AppIcons.TrainingBlockMoveUp" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-app-icon tb-card-icon-button" @onclick="() => MoveExecutionDownAsync(block.Id)" disabled="@(IsWriteBlocked || block.OrderIndex == _executions.Count)" aria-label="@string.Format(Localizer["TrainingBlockEditor_MoveDownAria"].Value, block.Title)">
                                            <i class="@AppIcons.TrainingBlockMoveDown" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center text-muted small flex-wrap gap-2 mb-3">
        <span>@string.Format(Localizer["TrainingBlockEditor_TotalPlannedSummary"].Value, TotalPlannedMinutes)</span>
        @if (RemainingMinutes >= 0)
        {
            <span>@string.Format(Localizer["TrainingBlockEditor_RemainingSummary"].Value, RemainingMinutes)</span>
        }
        else
        {
            <span class="text-danger fw-semibold">@string.Format(Localizer["TrainingBlockEditor_OverbookedSummary"].Value, -RemainingMinutes)</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <ActionAlert IsSuccess="false" Message="@_errorMessage" />
    }
}

@code {
    [Parameter] public int TrainingId { get; set; }
    [Parameter] public bool IsWriteBlocked { get; set; }

    private enum EditorPanel
    {
        None,
        New,
        Add
    }

    private ToastComponent? _toast;
    private EditorPanel _panel;
    private bool _isLoading;
    private bool _hasTrainingContext;
    private int _loadedTrainingId;
    private int _trainingDurationMinutes;
    private int _trainingGroupId;
    private string? _errorMessage;
    private List<TrainingBlockDto> _executions = [];
    private List<TagDto> _tags = [];
    private List<GameDto> _games = [];
    private List<TrainingBlockDefinitionDto> _libraryResults = [];
    private List<TrainingBlockLibraryCreatorDto> _libraryCreators = [];
    private bool _libraryHasMore;
    private bool _librarySearchPerformed;
    private const int LibraryPageSize = 5;
    private int? _libraryTagId;
    private int? _libraryCreatorId;
    private int? _libraryMinDuration;
    private int? _libraryMaxDuration;
    private string? _librarySearchText;
    private int? _appliedLibraryTagId;
    private int? _appliedLibraryCreatorId;
    private int? _appliedLibraryMinDuration;
    private int? _appliedLibraryMaxDuration;
    private string? _appliedLibrarySearchText;
    private int _editingExecutionId;
    private readonly TrainingBlockCreateFormModel _createForm = new();
    private readonly TrainingBlockExecutionEditFormModel _editForm = new();

    private int TotalPlannedMinutes => _executions.Sum(block => block.PlannedDurationMinutes);
    private int RemainingMinutes => (_trainingDurationMinutes > 0 ? _trainingDurationMinutes : 0) - TotalPlannedMinutes;

    protected override async Task OnParametersSetAsync()
    {
        if (TrainingId == _loadedTrainingId)
        {
            return;
        }

        _loadedTrainingId = TrainingId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _panel = EditorPanel.None;
        _editingExecutionId = 0;

        if (TrainingId <= 0)
        {
            _hasTrainingContext = false;
            _executions.Clear();
            _tags.Clear();
            _games.Clear();
            _libraryResults.Clear();
            _libraryCreators.Clear();
            _trainingDurationMinutes = 0;
            _trainingGroupId = 0;
            _isLoading = false;
            return;
        }

        var training = await TrainingService.GetByIdAsync(TrainingId);
        if (training is null)
        {
            _hasTrainingContext = false;
            _isLoading = false;
            return;
        }

        _hasTrainingContext = true;
        _trainingDurationMinutes = training.DurationMinutes ?? 0;
        _trainingGroupId = training.GroupId;
        _tags = (await TagAdminService.GetActiveForSelectionAsync()).ToList();
        _games = (await GameAdminService.GetActiveForSelectionAsync()).ToList();
        _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
        _isLoading = false;
    }

    private async Task OpenAddPanel()
    {
        _panel = _panel == EditorPanel.Add ? EditorPanel.None : EditorPanel.Add;
        _editingExecutionId = 0;
        _errorMessage = null;
        if (_panel == EditorPanel.Add)
        {
            _libraryTagId = null;
            _libraryCreatorId = null;
            _libraryMinDuration = null;
            _libraryMaxDuration = null;
            _librarySearchText = null;
            _libraryResults.Clear();
            _libraryHasMore = false;
            _librarySearchPerformed = false;
            await RefreshLibraryCreatorOptionsAsync();
        }
    }

    /// <summary>
    /// Fetches the Creator filter's dropdown options without running a full (result-producing) library search.
    /// </summary>
    private async Task RefreshLibraryCreatorOptionsAsync()
    {
        var result = await TrainingBlockLibraryService.SearchAsync(new TrainingBlockLibrarySearchDto
        {
            GroupId = _trainingGroupId,
            Skip = 0,
            Take = 0
        });
        _libraryCreators = result.CreatorOptions.ToList();
    }

    private async Task OpenNewPanel()
    {
        _panel = _panel == EditorPanel.New ? EditorPanel.None : EditorPanel.New;
        _editingExecutionId = 0;
        _errorMessage = null;
        _createForm.Reset();
        if (_panel == EditorPanel.New)
        {
            _games = (await GameAdminService.GetActiveForSelectionAsync()).ToList();
        }
    }

    private void ClosePanel()
    {
        _panel = EditorPanel.None;
        _createForm.Reset();
        _errorMessage = null;
    }

    private async Task OnCreateTagChangedAsync()
    {
        var selectedTag = _tags.FirstOrDefault(tag => tag.Id == _createForm.TagId);
        _createForm.RequiresGame = string.Equals(selectedTag?.Key, Trainings.Application.Constants.TrainingBlockCatalog.TagKeys.Game, StringComparison.Ordinal);
        if (!_createForm.RequiresGame)
        {
            _createForm.GameId = null;
            _createForm.NewGameName = string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SearchLibraryAsync()
    {
        _appliedLibraryTagId = _libraryTagId;
        _appliedLibraryCreatorId = _libraryCreatorId;
        _appliedLibraryMinDuration = _libraryMinDuration;
        _appliedLibraryMaxDuration = _libraryMaxDuration;
        _appliedLibrarySearchText = _librarySearchText;
        _librarySearchPerformed = true;
        await LoadLibraryAsync(reset: true);
    }

    private Task LoadMoreLibraryAsync() => LoadLibraryAsync(reset: false);

    private async Task LoadLibraryAsync(bool reset)
    {
        var skip = reset ? 0 : _libraryResults.Count;
        var result = await TrainingBlockLibraryService.SearchAsync(new TrainingBlockLibrarySearchDto
        {
            GroupId = _trainingGroupId,
            TagId = _appliedLibraryTagId,
            CreatorId = _appliedLibraryCreatorId,
            MinDurationMinutes = _appliedLibraryMinDuration,
            MaxDurationMinutes = _appliedLibraryMaxDuration,
            SearchText = string.IsNullOrWhiteSpace(_appliedLibrarySearchText) ? null : _appliedLibrarySearchText.Trim(),
            Skip = skip,
            Take = LibraryPageSize
        });

        _libraryCreators = result.CreatorOptions.ToList();
        _libraryHasMore = result.HasMore;
        if (reset)
        {
            _libraryResults = result.Items.ToList();
            return;
        }

        _libraryResults.AddRange(result.Items);
    }

    private async Task AddDefinitionAsync(int definitionId)
    {
        try
        {
            await TrainingBlockService.AddExecutionFromDefinitionAsync(new AddTrainingBlockFromDefinitionDto
            {
                TrainingId = TrainingId,
                DefinitionId = definitionId
            });
            _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
            await ShowToastAsync(Localizer["TrainingBlockEditor_BlockAddedToast"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task CreateBlockAsync()
    {
        try
        {
            await TrainingBlockService.CreateDefinitionAndAddExecutionAsync(new CreateTrainingBlockDto
            {
                TrainingId = TrainingId,
                TagId = _createForm.TagId ?? 0,
                GameId = _createForm.GameId,
                NewGameName = string.IsNullOrWhiteSpace(_createForm.NewGameName) ? null : _createForm.NewGameName.Trim(),
                Title = _createForm.Title,
                Description = string.IsNullOrWhiteSpace(_createForm.Description) ? null : _createForm.Description.Trim(),
                DurationMinutes = _createForm.DurationMinutes ?? 0,
                MinParticipants = _createForm.MinParticipants ?? 0,
                MaxParticipants = _createForm.MaxParticipants ?? 0
            });

            _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
            _games = (await GameAdminService.GetActiveForSelectionAsync()).ToList();
            _createForm.Reset();
            _panel = EditorPanel.None;
            await ShowToastAsync(Localizer["TrainingBlockEditor_BlockCreatedToast"], ToastComponent.ToastVariant.Success);
            await ShowToastAsync(Localizer["TrainingBlockEditor_BlockAddedToast"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void StartEditExecution(TrainingBlockDto block)
    {
        _panel = EditorPanel.None;
        _editingExecutionId = block.Id;
        _editForm.LoadFrom(block);
        _errorMessage = null;
    }

    private async Task SaveExecutionAsync()
    {
        try
        {
            await TrainingBlockService.UpdateExecutionAsync(new UpdateTrainingBlockExecutionDto
            {
                Id = _editingExecutionId,
                Title = _editForm.Title,
                Description = string.IsNullOrWhiteSpace(_editForm.Description) ? null : _editForm.Description.Trim(),
                PlannedDurationMinutes = _editForm.PlannedDurationMinutes ?? 0,
                MinParticipants = _editForm.MinParticipants ?? 0,
                MaxParticipants = _editForm.MaxParticipants ?? 0,
                EffectiveDurationMinutes = _editForm.EffectiveDurationMinutes,
                TrainerComment = string.IsNullOrWhiteSpace(_editForm.TrainerComment) ? null : _editForm.TrainerComment.Trim()
            });

            _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
            _editingExecutionId = 0;
            await ShowToastAsync(Localizer["TrainingBlockEditor_BlockUpdatedToast"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void CancelEditExecution()
    {
        _editingExecutionId = 0;
        _errorMessage = null;
    }

    private async Task DeleteExecutionAsync(int executionId)
    {
        try
        {
            await TrainingBlockService.DeleteExecutionAsync(executionId);
            _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
            await ShowToastAsync(Localizer["TrainingBlockEditor_BlockDeletedToast"], ToastComponent.ToastVariant.Info);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task MoveExecutionUpAsync(int executionId)
    {
        await TrainingBlockService.MoveExecutionUpAsync(executionId);
        _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
    }

    private async Task MoveExecutionDownAsync(int executionId)
    {
        await TrainingBlockService.MoveExecutionDownAsync(executionId);
        _executions = (await TrainingBlockService.GetExecutionsAsync(TrainingId)).ToList();
    }

    private string FormatDefinitionType(TrainingBlockDefinitionDto definition)
        => definition.GameDisplayText is null
            ? definition.TagDisplayText
            : string.Format(Localizer["TrainingBlockEditor_TagGameValue"].Value, definition.TagDisplayText, definition.GameDisplayText);

    private string FormatExecutionType(TrainingBlockDto block)
        => block.GameDisplayText is null
            ? block.TagDisplayText
            : string.Format(Localizer["TrainingBlockEditor_TagGameValue"].Value, block.TagDisplayText, block.GameDisplayText);

    private static string GetStripeCssClass(string colorToken) => colorToken switch
    {
        "--brand-community" => "tb-tag-stripe-community",
        "--brand-accent" => "tb-tag-stripe-accent",
        "--brand-accent-40" => "tb-tag-stripe-accent-40",
        "--brand-innovation" => "tb-tag-stripe-innovation",
        "--brand-appreciation-dark" => "tb-tag-stripe-appreciation-dark",
        _ => "tb-tag-stripe-tradition-60"
    };

    private async Task ShowToastAsync(string message, ToastComponent.ToastVariant variant)
    {
        _errorMessage = null;
        if (_toast is not null)
        {
            await _toast.Show(message, variant);
        }
    }
}
