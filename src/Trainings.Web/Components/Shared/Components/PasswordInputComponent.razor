<div class="input-group">
    <input class="form-control @CssClass" type="@(_showPassword ? "text" : "password")"
           value="@Value"
           disabled="@Disabled"
           @onchange="OnInputChanged"
           @attributes="AdditionalAttributes" />
    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleVisibility" title="@Localizer["Shared_TogglePasswordVisibility"]">
        <i class="@(_showPassword ? AppIcons.EyeSlash : AppIcons.Eye)" aria-hidden="true"></i>
    </button>
    @if (ShowGenerateButton)
    {
        <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePasswordAsync" title="@Localizer["Shared_GeneratePassword"]">
            <i class="@AppIcons.Wand" aria-hidden="true"></i>
        </button>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>When true, renders a "Generate password" button that fills the field with a strong random password using <see cref="PasswordPolicy"/>.</summary>
    [Parameter] public bool ShowGenerateButton { get; set; }

    /// <summary>Raised after a password has been generated via the Generate button, so callers can mirror the value into related fields (e.g. a confirm-password field) or clear stale validation messages.</summary>
    [Parameter] public EventCallback<string> OnGenerated { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _showPassword;

    private Task OnInputChanged(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString());

    private void ToggleVisibility() => _showPassword = !_showPassword;

    private async Task GeneratePasswordAsync()
    {
        var generated = PasswordPolicy.Generate();
        _showPassword = true;
        await ValueChanged.InvokeAsync(generated);
        await OnGenerated.InvokeAsync(generated);
    }
}
