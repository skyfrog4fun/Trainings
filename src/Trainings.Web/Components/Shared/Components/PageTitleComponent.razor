<div class="d-flex justify-content-between align-items-center my-3 gap-2 flex-wrap">
    <h2 class="mb-0"><i class="@Icon me-2" aria-hidden="true"></i>@Text</h2>
    <div class="d-flex align-items-center gap-2">
        @if (ShowFilterButton)
        {
            <button type="button" class="btn btn-app-outline" @onclick="HandleFilterButtonClick">
                <i class="@AppIcons.Filter" aria-hidden="true"></i>
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(ButtonText))
        {
            <button type="button" class="btn btn-success" @onclick="HandleButtonClick" disabled="@ButtonDisabled"><i class="@ButtonIcon me-1" aria-hidden="true"></i>@ButtonText</button>
        }
    </div>
</div>

@if (Filter is not null)
{
    @Filter
}

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public string? ButtonIcon { get; set; }
    [Parameter] public bool ButtonDisabled { get; set; }
    [Parameter] public EventCallback OnButtonClick { get; set; }

    [Parameter] public bool ShowFilterButton { get; set; }
    [Parameter] public EventCallback OnFilterButtonClick { get; set; }
    [Parameter] public RenderFragment? Filter { get; set; }

    private Task HandleButtonClick() => OnButtonClick.InvokeAsync();
    private Task HandleFilterButtonClick() => OnFilterButtonClick.InvokeAsync();
}
