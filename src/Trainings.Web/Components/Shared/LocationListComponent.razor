@if (AlwaysShow || Locations.Count > 0)
{
    <CardComponent Collapsed="!DefaultExpanded">
        <Title>@Title</Title>
        <TitleMeta>@Locations.Count</TitleMeta>
        <Body>
            @if (Locations.Count == 0)
            {
                <p class="text-muted mb-0">@EmptyText</p>
            }
            else
            {
                @foreach (var location in Locations)
                {
                    <div class="card-list-row d-flex justify-content-between align-items-center">
                        <div>
                            @location.Name
                            @if (!string.IsNullOrWhiteSpace(location.CityName))
                            {
                                <br /><small class="text-muted">@location.CityName</small>
                            }
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnEdit.InvokeAsync(location)">
                                <i class="@AppIcons.Edit" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                }
            }
        </Body>
    </CardComponent>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public List<LocationDto> Locations { get; set; } = new();
    [Parameter] public bool AlwaysShow { get; set; }
    [Parameter] public string EmptyText { get; set; } = string.Empty;
    [Parameter] public EventCallback<LocationDto> OnEdit { get; set; }
    [Parameter] public bool DefaultExpanded { get; set; } = true;
}
