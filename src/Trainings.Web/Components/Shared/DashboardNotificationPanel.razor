<div class="card collapsible-card mb-4">
    <div class="card-header collapsible-card-header dashboard-card-header">
        <button type="button" class="collapsible-card-toggle" @onclick="HandleToggleAsync">
            <span class="fw-bold">@Localizer["DashboardNotificationPanel_NotificationActivity"]</span>
            <i class="@(IsExpanded ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
        </button>
        <div class="collapsible-card-meta small">
            <span class="dashboard-card-counter me-3">
                <i class="@AppIcons.Bell" aria-hidden="true"></i> @Math.Min(Logs.Count, DisplayLimit)/@Logs.Count
            </span>
            <span class="text-success me-3"><i class="@AppIcons.Check" aria-hidden="true"></i> @SuccessCount</span>
            <span class="text-danger"><i class="@AppIcons.XMark" aria-hidden="true"></i> @FailureCount</span>
        </div>
    </div>
    @if (IsExpanded)
    {
        <div class="card-body">
            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnReset">@Localizer["DashboardNotificationPanel_ResetPointer"]</button>
            </div>

            @if (Logs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>@Localizer["DashboardNotificationPanel_LogId"]</th><th>@Localizer["DashboardNotificationPanel_DateUtc"]</th><th>@Localizer["DashboardNotificationPanel_Action"]</th><th>@Localizer["DashboardNotificationPanel_Recipient"]</th><th>@Localizer["Shared_Status"]</th><th>@Localizer["DashboardNotificationPanel_Error"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Logs.Take(DisplayLimit))
                            {
                                <tr>
                                    <td class="small">#@log.Id</td>
                                    <td class="small">@log.CreatedAt.ToString("MMM d, HH:mm") UTC</td>
                                    <td class="small">@log.Action</td>
                                    <td class="small text-muted">@log.RecipientEmail</td>
                                    <td>
                                        @if (log.IsSuccess)
                                        {
                                            <i class="@AppIcons.Check text-success" aria-hidden="true"></i>
                                        }
                                        else
                                        {
                                            <i class="@AppIcons.XMark text-danger" aria-hidden="true"></i>
                                        }
                                    </td>
                                    <td class="small text-danger">@log.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted">@Localizer["DashboardNotificationPanel_NoNotificationActivitySinceReset"]</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<Trainings.Domain.Entities.NotificationLog> Logs { get; set; } = Array.Empty<Trainings.Domain.Entities.NotificationLog>();
    [Parameter] public int SuccessCount { get; set; }
    [Parameter] public int FailureCount { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public int DisplayLimit { get; set; } = 10;
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private async Task HandleToggleAsync()
    {
        if (OnToggle.HasDelegate)
        {
            await OnToggle.InvokeAsync();
        }
    }
}
