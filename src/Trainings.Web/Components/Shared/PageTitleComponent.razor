<div class="d-flex justify-content-between align-items-center my-3">
    <h2 class="mb-0"><i class="@Icon me-2" aria-hidden="true"></i>@Text</h2>
    @if (!string.IsNullOrWhiteSpace(ButtonText))
    {
        <button type="button" class="btn btn-success" @onclick="HandleButtonClick"><i class="@ButtonIcon me-1" aria-hidden="true"></i>@ButtonText</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public string? ButtonIcon { get; set; }
    [Parameter] public EventCallback OnButtonClick { get; set; }

    private Task HandleButtonClick() => OnButtonClick.InvokeAsync();
}
