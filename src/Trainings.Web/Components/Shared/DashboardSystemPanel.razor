<div class="card h-100">
    <div class="card-header dashboard-card-header">
        <span class="fw-bold">@Localizer["SystemOverview"]</span>
        <span class="dashboard-card-counter">
            <i class="@AppIcons.Gear" aria-hidden="true"></i> 5
        </span>
    </div>
    <div class="card-body py-2">
        <div class="system-row">
            <span>@Localizer["MailConfigurationCount", MailConfigurationCount]</span>
            <div class="d-flex gap-1">
                <a class="btn btn-primary btn-sm" href="/config/mail" title='@Localizer["OpenMailConfigurationOverview"]'>
                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                </a>
                <a class="btn btn-success btn-sm" href="/config/mail?create=true" title='@Localizer["CreateMailConfiguration"]'>
                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="system-row">
            <span>@Localizer["LocationsCount", LocationCount]</span>
            <div class="d-flex gap-1">
                <a class="btn btn-primary btn-sm" href="/config/locations" title='@Localizer["OpenLocationsOverview"]'>
                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                </a>
                <a class="btn btn-success btn-sm" href="/config/locations?create=true" title='@Localizer["CreateLocation"]'>
                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="system-row">
            <span>@Localizer["GroupsCount", GroupCount]</span>
            <div class="d-flex gap-1">
                <a class="btn btn-primary btn-sm" href="/groups" title='@Localizer["OpenGroupsOverview"]'>
                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                </a>
                <a class="btn btn-success btn-sm" href="/groups/new" title='@Localizer["DashboardSystemPanel_CreateGroup"]'>
                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="system-row">
            <span>@Localizer["UsersCount", UserCount]</span>
            <div class="d-flex gap-1">
                <a class="btn btn-primary btn-sm" href="/users" title='@Localizer["OpenUsersOverview"]'>
                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                </a>
                <a class="btn btn-success btn-sm" href="/users/new" title='@Localizer["CreateUser"]'>
                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center py-2">
            <span>@Localizer["TrainingsCount", TrainingCount]</span>
            <div class="d-flex gap-1">
                <a class="btn btn-primary btn-sm" href="/trainings" title='@Localizer["OpenTrainingsOverview"]'>
                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                </a>
                <a class="btn btn-success btn-sm" href="/trainings/create" title='@Localizer["CreateTraining"]'>
                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int MailConfigurationCount { get; set; }
    [Parameter] public int LocationCount { get; set; }
    [Parameter] public int GroupCount { get; set; }
    [Parameter] public int UserCount { get; set; }
    [Parameter] public int TrainingCount { get; set; }
}
