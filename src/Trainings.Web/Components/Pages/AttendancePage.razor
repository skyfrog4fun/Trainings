@page "/trainings/{TrainingId:int}/attendance"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupTrainer")]
@inject ITrainingService TrainingService
@inject IRegistrationService RegistrationService
@inject IAttendanceService AttendanceService
@inject IGroupService GroupService
@inject IUserService UserService
@inject IDateTimeFormatService DateTimeFormatService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Attendance</PageTitle>

<div class="container px-2 px-md-4">
    <div class="my-3">
        <BackButton Href="@($"/trainings/{TrainingId}")" />
    </div>

    @if (_training != null)
    {
        <h2>Attendance: @(string.IsNullOrWhiteSpace(_training.Title) ? "In planning ..." : _training.Title)</h2>
        <p class="text-muted">@FormatTrainingDate(_training) · @(_training.LocationName ?? "-")</p>
        @if (_training.AttendanceLocked && _training.AttendanceLockedAt.HasValue)
        {
            <div class="alert alert-success py-2">
                <i class="@AppIcons.Check me-1" aria-hidden="true"></i>Attendance finalized on @FormatAttendanceLockedAt(_training)
            </div>
        }
        else if (_training.DateTime > DateTime.UtcNow)
        {
            <div class="alert alert-info py-2">
                <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>Training hasn't started yet. You can save a draft, but cannot finalize attendance until after start time.
            </div>
        }
    }

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (_message != null)
        {
            <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")">@_message</div>
        }

        <div class="list-group mt-3">
            @foreach (var member in _participants)
            {
                var status = _attendanceMap.TryGetValue(member.UserId, out var s) ? s : (AttendanceStatus?)null;
                var isRegistered = _registeredUserIds.Contains(member.UserId);
                <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold">@member.UserDisplayName</span>
                        @if (isRegistered)
                        {
                            <i class="@AppIcons.ClipboardCheck text-success small" title="Pre-registered" aria-label="Pre-registered"></i>
                        }
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Attendance for @member.UserDisplayName">
                        <button type="button"
                                class="btn @(status == AttendanceStatus.Present ? "btn-success" : "btn-outline-secondary")"
                                title="Present"
                                @onclick="() => SetAttendance(member.UserId, AttendanceStatus.Present)">
                            <i class="@AppIcons.Check" aria-hidden="true"></i><i class="@AppIcons.Check" aria-hidden="true"></i>
                        </button>
                        <button type="button"
                                class="btn @(status == AttendanceStatus.PartiallyPresent ? "btn-warning" : "btn-outline-secondary")"
                                title="Partially present"
                                @onclick="() => SetAttendance(member.UserId, AttendanceStatus.PartiallyPresent)">
                            <i class="@AppIcons.Check" aria-hidden="true"></i>
                        </button>
                        <button type="button"
                                class="btn @(status == AttendanceStatus.Absent ? "btn-danger" : "btn-outline-secondary")"
                                title="Absent"
                                @onclick="() => SetAttendance(member.UserId, AttendanceStatus.Absent)">
                            <i class="@AppIcons.XMark" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (!_participants.Any())
        {
            <div class="alert alert-info mt-3">No group members found for this training.</div>
        }

        @if (_participants.Any())
        {
            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary" @onclick="SaveDraftAsync" disabled="@(_saving || (_training?.AttendanceLocked ?? false))">
                    <i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@(_saving ? "Saving…" : "Save Draft")
                </button>
                <button type="button" class="btn btn-primary" @onclick="FinalizeAttendanceAsync"
                        disabled="@(_saving || (_training?.AttendanceLocked ?? false) || (_training?.DateTime > DateTime.UtcNow))">
                    <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@(_saving ? "Saving…" : "Finalize Attendance")
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int TrainingId { get; set; }

    private TrainingDto? _training;
    private List<GroupMembershipDto> _participants = new();
    private HashSet<int> _registeredUserIds = new();
    private Dictionary<int, AttendanceStatus> _attendanceMap = new();
    private bool _loading = true;
    private bool _saving;
    private int _trainerId;
    private string? _message;
    private bool _messageIsError;
    private string _userCountry = "CH";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _trainerId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (_trainerId > 0)
        {
            _userCountry = (await UserService.GetByIdAsync(_trainerId))?.CountryCode ?? DateTimeFormatService.GetDefaultCountry();
        }

        _training = await TrainingService.GetByIdAsync(TrainingId);

        if (_training?.GroupId is { } groupId)
        {
            var members = await GroupService.GetMembersAsync(groupId);
            _participants = members
                .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
                .GroupBy(m => m.UserId)
                .Select(g => g.First())
                .OrderBy(m => m.UserFirstName)
                .ThenBy(m => m.UserLastName)
                .ToList();
        }

        var registrations = await RegistrationService.GetByTrainingIdAsync(TrainingId);
        _registeredUserIds = registrations
            .Where(r => r.Status == RegistrationStatus.Registered)
            .Select(r => r.UserId)
            .ToHashSet();

        var existingAttendance = await AttendanceService.GetByTrainingIdAsync(TrainingId);
        _attendanceMap = existingAttendance.ToDictionary(a => a.UserId, a => a.Status);

        _loading = false;
    }

    private void SetAttendance(int userId, AttendanceStatus status)
    {
        _attendanceMap[userId] = status;
        StateHasChanged();
    }

    private async Task SaveDraftAsync()
    {
        _saving = true;
        _message = null;
        try
        {
            await AttendanceService.BulkSaveAsync(TrainingId, _attendanceMap, _trainerId);
            _message = "Attendance draft saved.";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task FinalizeAttendanceAsync()
    {
        if (_training?.DateTime > DateTime.UtcNow)
        {
            _message = "Cannot finalize attendance before the training has started.";
            _messageIsError = true;
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            await AttendanceService.BulkSaveAsync(TrainingId, _attendanceMap, _trainerId);
            await TrainingService.LockAttendanceAsync(TrainingId);
            _training = await TrainingService.GetByIdAsync(TrainingId);
            _message = "Attendance finalized successfully.";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private string FormatTrainingDate(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return training.DateTime.ToString("g", culture);
    }

    private string FormatAttendanceLockedAt(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return (training.AttendanceLockedAt ?? DateTime.UtcNow).ToString("g", culture);
    }
}
