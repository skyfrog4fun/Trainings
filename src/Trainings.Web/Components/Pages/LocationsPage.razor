@page "/config/locations"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "SuperAdmin")]
@inject ILocationService LocationService
@inject IGroupService GroupService
@inject ICountryService CountryService

<PageTitle>Locations</PageTitle>

<div class="container px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2><i class="@AppIcons.Location me-2" aria-hidden="true"></i>Locations</h2>
        <button class="btn btn-success" @onclick="ShowCreateForm"><i class="@AppIcons.Plus me-1" aria-hidden="true"></i>New Location</button>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@(_editId == 0 ? "Create Location" : "Edit Location")</h5>
                <div class="row g-2">
                    <div class="col-12 col-md-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_formName" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">City Name</label>
                        <input class="form-control" @bind="_formCityName" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Country</label>
                        <select class="form-select" @bind="_formCountryId">
                            <option value="">Select country</option>
                            @foreach (var country in _countries)
                            {
                                <option value="@country.Id">@country.Code — @country.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="form-check mt-4">
                            <input class="form-check-input" id="isSystemWide" type="checkbox" @bind="_formIsSystemWide" />
                            <label class="form-check-label" for="isSystemWide">System wide (Outside / Special)</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>Save</button>
                    <button class="btn btn-secondary" @onclick="Cancel"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>Cancel</button>
                </div>
            </div>
        </div>
    }

    @{
        var activeLocations = _locations.Where(l => l.IsActive && !l.IsSystemWide).ToList();
        var systemWideLocations = _locations.Where(l => l.IsSystemWide).ToList();
        var inactiveLocations = _locations.Where(l => !l.IsActive).ToList();
    }

    @RenderLocationGroup("Active Locations", "active-locations", activeLocations, true)
    @RenderLocationGroup("System Wide", "system-wide-locations", systemWideLocations, true)
    @RenderLocationGroup("Inactive", "inactive-locations", inactiveLocations, false)

    <h4 class="mt-4">Group Location Access</h4>
    @foreach (var group in _groups)
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">@group.Name</div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var location in _locations.Where(l => !l.IsSystemWide))
                    {
                        var key = $"{group.Id}:{location.Id}";
                        <div class="col-12 col-md-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="grp-loc-@group.Id-@location.Id"
                                       checked="@_groupLocationAssignments.Contains(key)"
                                       @onchange="e => ToggleGroupLocation(group.Id, location.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="grp-loc-@group.Id-@location.Id">
                                    @location.Name
                                    @if (!string.IsNullOrWhiteSpace(location.CityName))
                                    {
                                        <br /><small class="text-muted">@location.CityName</small>
                                    }
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LocationDto> _locations = new();
    private List<GroupDto> _groups = new();
    private List<CountryDto> _countries = new();
    private HashSet<string> _groupLocationAssignments = new();
    private HashSet<string> _expandedLocationGroupIds = new(StringComparer.Ordinal);

    private bool _showForm;
    private int _editId;
    private string _formName = string.Empty;
    private string _formCityName = string.Empty;
    private bool _formIsSystemWide;
    private int? _formCountryId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _locations = (await LocationService.GetAllAsync()).ToList();
        _groups = (await GroupService.GetAllAsync()).ToList();
        _countries = (await CountryService.GetAllAsync()).ToList();

        _groupLocationAssignments = _groups
            .SelectMany(g => g.AllowedLocationIds.Select(id => $"{g.Id}:{id}"))
            .ToHashSet(StringComparer.Ordinal);

        if (_expandedLocationGroupIds.Count == 0)
        {
            _expandedLocationGroupIds.Add("active-locations");
            _expandedLocationGroupIds.Add("system-wide-locations");
        }
    }

    private RenderFragment RenderLocationGroup(string title, string collapseId, List<LocationDto> locations, bool defaultOpen) => __builder =>
    {
        if (locations.Count == 0)
        {
            return;
        }

        var isExpanded = _expandedLocationGroupIds.Contains(collapseId);
        var chevronClass = isExpanded ? AppIcons.ChevronUp : AppIcons.ChevronDown;
        <div class="card collapsible-card mb-3">
            <div class="card-header collapsible-card-header">
                <button type="button" class="btn btn-link collapsible-card-toggle" @onclick="() => ToggleLocationGroup(collapseId)">
                    <span>@title</span>
                    <i class="@chevronClass" aria-hidden="true"></i>
                </button>
                <div class="collapsible-card-meta">@locations.Count</div>
            </div>
            @if (isExpanded)
            {
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>City</th>
                                    <th>Country</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var location in locations)
                                {
                                    <tr>
                                        <td>@location.Name</td>
                                        <td>@location.CityName</td>
                                        <td>@(location.CountryCode ?? "—")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => Edit(location)"><i class="@AppIcons.Edit" aria-hidden="true"></i></button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(location.Id)" disabled="@location.IsSystemWide"><i class="@AppIcons.Trash" aria-hidden="true"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>;
    };

    private void ShowCreateForm()
    {
        _editId = 0;
        _formName = string.Empty;
        _formCityName = string.Empty;
        _formIsSystemWide = false;
        _formCountryId = null;
        _showForm = true;
    }

    private void Edit(LocationDto location)
    {
        _editId = location.Id;
        _formName = location.Name;
        _formCityName = location.CityName;
        _formIsSystemWide = location.IsSystemWide;
        _formCountryId = location.CountryId;
        _showForm = true;
    }

    private async Task Save()
    {
        if (_editId == 0)
        {
            await LocationService.CreateAsync(new CreateLocationDto
            {
                Name = _formName,
                CityName = _formCityName,
                IsSystemWide = _formIsSystemWide,
                CountryId = _formCountryId
            });
        }
        else
        {
            var existing = _locations.First(x => x.Id == _editId);
            await LocationService.UpdateAsync(new UpdateLocationDto
            {
                Id = _editId,
                Name = _formName,
                CityName = _formCityName,
                IsSystemWide = _formIsSystemWide,
                IsActive = existing.IsActive,
                CountryId = _formCountryId
            });
        }

        _showForm = false;
        await LoadData();
    }

    private async Task Delete(int id)
    {
        await LocationService.DeleteAsync(id);
        await LoadData();
    }

    private void Cancel() => _showForm = false;

    private void ToggleLocationGroup(string collapseId)
    {
        if (!_expandedLocationGroupIds.Add(collapseId))
        {
            _expandedLocationGroupIds.Remove(collapseId);
        }
    }

    private async Task ToggleGroupLocation(int groupId, int locationId, bool selected)
    {
        var group = _groups.First(g => g.Id == groupId);
        var allowed = group.AllowedLocationIds.ToHashSet();
        if (selected)
        {
            allowed.Add(locationId);
        }
        else
        {
            allowed.Remove(locationId);
        }

        await GroupService.UpdateAsync(new UpdateGroupDto
        {
            Id = group.Id,
            Name = group.Name,
            Slug = group.Slug,
            Description = group.Description,
            Weekday = group.Weekday,
            LocationId = group.LocationId,
            StartTime = group.StartTime,
            DurationMinutes = group.DurationMinutes,
            MaxParticipants = group.MaxParticipants,
            CountryId = group.CountryId,
            AllowedLocationIds = allowed.ToList(),
            IsActive = group.IsActive
        });

        await LoadData();
    }
}
