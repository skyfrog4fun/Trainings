@page "/my-registrations"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupMember")]
@inject IRegistrationService RegistrationService
@inject IUserService UserService
@inject IDateTimeFormatService DateTimeFormatService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Registrations</PageTitle>

<div class="container px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center my-3 gap-2 flex-wrap">
        <h2 class="mb-0">My Registrations</h2>
        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleFilter">
            <i class="fa-solid fa-filter" aria-hidden="true"></i>
        </button>
    </div>

    @if (_showFilter)
    {
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <select class="form-select" @bind="_filterGroupName">
                    <option value="">All groups</option>
                    @foreach (var group in _filterGroups)
                    {
                        <option value="@group">@group</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <select class="form-select" @bind="_filterTrainerName">
                    <option value="">All trainers</option>
                    @foreach (var trainer in _filterTrainers)
                    {
                        <option value="@trainer">@trainer</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <select class="form-select" @bind="_filterAvailability">
                    <option value="all">All</option>
                    <option value="available">Available</option>
                    <option value="full">Full</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">
                    <i class="fa-solid fa-filter-circle-xmark me-1" aria-hidden="true"></i>Clear filters
                </button>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else if (FilteredRegistrations.Any())
    {
        <div class="row g-3">
            @foreach (var reg in FilteredRegistrations)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm @GetCardCssClass(reg)">
                        <div class="card-body d-flex flex-column">
                            <div class="training-card-title text-truncate">@reg.TrainingTitle</div>
                            <div class="d-flex justify-content-between align-items-center gap-2 text-muted small mt-2">
                                <span class="text-truncate">@FormatTrainingDate(reg)</span>
                                <span class="text-nowrap"><i class="fa-solid fa-stopwatch me-1" aria-hidden="true"></i>@FormatDuration(reg.TrainingDurationMinutes)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2 small mt-2">
                                <span class="text-truncate"><i class="fa-solid fa-object-group me-1" aria-hidden="true"></i>@(reg.TrainingGroupName ?? "-")</span>
                                <span class="text-truncate text-end">@(reg.TrainingLocationName ?? "-")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2 small mt-2">
                                <span class="text-truncate">@(reg.TrainingTrainerName ?? "-")</span>
                                <span class="text-nowrap">@reg.TrainingRegisteredCount/@reg.TrainingCapacity</span>
                            </div>
                            <div class="small text-muted text-truncate mt-2">@reg.TrainingDescription</div>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                            <span class="badge @(reg.Status == RegistrationStatus.Registered ? "bg-success" : "bg-secondary")">@reg.Status</span>
                            <a href="/trainings/@reg.TrainingId" class="btn btn-sm btn-outline-primary ms-auto">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_registrations.Any())
    {
        <div class="alert alert-info">No registrations match the current filters.</div>
    }
    else
    {
        <div class="alert alert-info">You have no registrations yet. <a href="/trainings">Browse trainings</a></div>
    }
</div>

@code {
    private List<RegistrationDto> _registrations = new();
    private List<string> _filterGroups = new();
    private List<string> _filterTrainers = new();
    private bool _loading = true;
    private bool _showFilter;
    private int _userId;
    private string _userCountry = "CH";
    private string _filterGroupName = string.Empty;
    private string _filterTrainerName = string.Empty;
    private string _filterAvailability = "all";
    private int? _nextUpcomingTrainingId;

    private List<RegistrationDto> FilteredRegistrations => ApplyFilters(_registrations);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        _userCountry = (await UserService.GetByIdAsync(_userId))?.CountryCode ?? DateTimeFormatService.GetDefaultCountry();
        _registrations = (await RegistrationService.GetByUserIdAsync(_userId))
            .OrderBy(registration => registration.TrainingDateTime)
            .ToList();
        _filterGroups = _registrations
            .Select(registration => registration.TrainingGroupName)
            .OfType<string>()
            .Where(group => !string.IsNullOrWhiteSpace(group))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group)
            .ToList();
        _filterTrainers = _registrations
            .Select(registration => registration.TrainingTrainerName)
            .OfType<string>()
            .Where(trainer => !string.IsNullOrWhiteSpace(trainer))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(trainer => trainer)
            .ToList();
        _nextUpcomingTrainingId = _registrations
            .Where(registration => registration.Status == RegistrationStatus.Registered && registration.TrainingDateTime > DateTime.Now)
            .OrderBy(registration => registration.TrainingDateTime)
            .Select(registration => (int?)registration.TrainingId)
            .FirstOrDefault();
        _loading = false;
    }

    private List<RegistrationDto> ApplyFilters(IEnumerable<RegistrationDto> registrations)
    {
        var query = registrations;

        if (!string.IsNullOrWhiteSpace(_filterGroupName))
        {
            query = query.Where(registration => string.Equals(registration.TrainingGroupName, _filterGroupName, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_filterTrainerName))
        {
            query = query.Where(registration => string.Equals(registration.TrainingTrainerName, _filterTrainerName, StringComparison.OrdinalIgnoreCase));
        }

        query = _filterAvailability switch
        {
            "available" => query.Where(registration => registration.TrainingRegisteredCount < registration.TrainingCapacity),
            "full" => query.Where(registration => registration.TrainingRegisteredCount >= registration.TrainingCapacity),
            _ => query
        };

        return query.ToList();
    }

    private string FormatTrainingDate(RegistrationDto registration)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(_userCountry);
        return registration.TrainingDateTime.ToString("g", culture);
    }

    private string GetCardCssClass(RegistrationDto registration)
    {
        if (registration.Status == RegistrationStatus.Cancelled)
        {
            return "training-card-status-cancelled";
        }

        if (registration.TrainingDateTime < DateTime.Now)
        {
            return "training-card-status-past";
        }

        return registration.TrainingId == _nextUpcomingTrainingId
            ? "training-card-status-next"
            : "training-card-status-future";
    }

    private static string FormatDuration(int? durationMinutes) =>
        durationMinutes.HasValue ? $"{durationMinutes.Value} min" : "-";

    private void ToggleFilter()
    {
        _showFilter = !_showFilter;
    }

    private void ClearFilters()
    {
        _filterGroupName = string.Empty;
        _filterTrainerName = string.Empty;
        _filterAvailability = "all";
    }
}
