@page "/users"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupTrainer")]

@inject IUserService UserService
@inject IUserRegistrationService UserRegistrationService
@inject IGroupService GroupService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppRuntimeModeService AppRuntimeModeService
@inject IAuthorizationHelper AuthorizationHelper

<PageTitle>@Localizer["Shared_Users"]</PageTitle>

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<div class="container px-2 px-md-4">
    <PageTitleComponent Icon="@AppIcons.Users"
                        Text="@Localizer["Shared_Users"]"
                        ButtonText="@(_canManage ? Localizer["Shared_Add"].Value : null)"
                        ButtonIcon="@AppIcons.Plus"
                        ButtonDisabled="@IsWriteBlocked"
                        OnButtonClick="GoToCreateUser"
                        ShowFilterButton="true"
                        OnFilterButtonClick="ToggleFilter">
        <Filter>
            @if (_showFilter)
            {
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-4">
                        <select class="form-select" @bind="_pendingGroupId">
                            <option value="">@Localizer["UsersPage_AllGroups"]</option>
                            <option value="none">@Localizer["UsersPage_NoGroup"]</option>
                            @foreach (var group in _availableGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="_pendingRole">
                            <option value="">@Localizer["UsersPage_AllRoles"]</option>
                            <option value="SuperAdmin">@Localizer["Enum_Role_SuperAdmin"]</option>
                            <option value="GroupAdmin">@Localizer["Enum_Role_GroupAdmin"]</option>
                            <option value="Trainer">@Localizer["Enum_Role_Trainer"]</option>
                            <option value="User">@Localizer["Enum_Role_User"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="_pendingStatus">
                            <option value="">@Localizer["UsersPage_AllStatuses"]</option>
                            <option value="Active">@Localizer["Shared_Active"]</option>
                            <option value="Inactive">@Localizer["UsersPage_Inactive"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-primary flex-fill" @onclick="ApplyFilters">
                            <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["Shared_Apply"]
                        </button>
                        <button type="button" class="btn btn-app-outline btn-filter-clear" @onclick="ClearFilters" title="@Localizer["Shared_ClearFilters"]" aria-label="@Localizer["Shared_ClearFilters"]">
                            <i class="@AppIcons.FilterClear" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </Filter>
    </PageTitleComponent>

    @if (IsWriteBlocked)
    {
        <div class="alert alert-warning">
            @Localizer["UsersPage_ReadOnlyModeSuperAdminOnly"]
        </div>
    }

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (_canManage)
        {
            <CardComponent @key="_pendingRows.Count == 0" Collapsed="_pendingRows.Count == 0">
                <Title>@Localizer["UsersPage_PendingApprovals"]</Title>
                <TitleMeta>@_pendingRows.Count</TitleMeta>
                <Body>
                    @if (_pendingRows.Count == 0)
                    {
                        <p class="text-muted mb-0">@Localizer["UsersPage_NoPendingApprovals"]</p>
                    }
                    else
                    {
                        <div class="app-overview-grid">
                            @foreach (var row in _pendingRows)
                            {
                                <div class="app-overview-card">
                                    <a href="/users/@row.UserId" class="app-overview-main text-decoration-none text-reset">
                                        <div class="app-overview-title text-break">@row.DisplayName</div>
                                        <div class="app-overview-meta text-break mt-1"><i class="@AppIcons.UserGroup me-1" aria-hidden="true"></i>@row.GroupName</div>
                                        <div class="app-overview-meta mt-1"><i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@Localizer["UsersPage_RequestDate"]: @row.RequestedAt.ToString("dd.MM.yyyy")</div>
                                    </a>
                                    <div class="app-overview-actions">
                                        <button type="button" class="btn btn-success" title="@Localizer["UsersPage_ApproveMembership"]" aria-label="@Localizer["UsersPage_ApproveMembership"]" disabled="@IsWriteBlocked" @onclick="() => ApproveRow(row)">
                                            <i class="@AppIcons.Check" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-danger" title="@Localizer["UsersPage_DeclineMembership"]" aria-label="@Localizer["UsersPage_DeclineMembership"]" disabled="@IsWriteBlocked" @onclick="() => DeclineRow(row)">
                                            <i class="@AppIcons.XMark" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </Body>
            </CardComponent>
        }

        @if (FilteredUsers.Count == 0)
        {
            <div class="alert alert-info">@Localizer["UsersPage_NoUsersMatchCurrentFilters"]</div>
        }
        else
        {
            <div class="app-overview-grid">
                @foreach (var user in FilteredUsers)
                {
                    <a href="/users/@user.Id" class="app-overview-card app-overview-card-link text-decoration-none text-reset">
                        <div class="app-overview-main">
                            <div class="app-overview-title text-break">@user.DisplayName</div>
                            <div class="app-overview-meta text-break mt-1"><i class="@AppIcons.UserGroup me-1" aria-hidden="true"></i>@FormatApprovedGroups(user.Id)</div>
                            <div class="app-overview-meta mt-1"><i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@Localizer["UsersPage_EntryDate"]: @FormatEntryDate(user.EntryDate)</div>
                        </div>
                        <div class="app-overview-actions">
                            <BadgeStatusComponent IsActive="user.IsActive" />
                        </div>
                    </a>
                }
            </div>
        }
    }
</div>

@code {
    private sealed record PendingApprovalRow(int MembershipId, int UserId, string DisplayName, int GroupId, string GroupName, DateTime RequestedAt);

    private List<UserDto> _users = new();
    private List<UserDto> _pendingUsers = new();
    private List<PendingApprovalRow> _pendingRows = new();
    private Dictionary<int, List<GroupMembershipDto>> _membershipsByUser = new();
    private List<GroupDto> _availableGroups = new();
    private HashSet<int> _adminGroupIds = new();
    private HashSet<int> _listingGroupIds = new();
    private AppRuntimeModeDto _runtimeMode = new();
    private bool _isSuperAdmin;
    private bool _loading = true;
    private ToastComponent? _toast;

    private bool _showFilter;
    private string _pendingGroupId = string.Empty;
    private string _pendingRole = string.Empty;
    private string _pendingStatus = string.Empty;
    private string _appliedGroupId = string.Empty;
    private string _appliedRole = string.Empty;
    private string _appliedStatus = string.Empty;

    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;

    private bool _canManage => _isSuperAdmin || _adminGroupIds.Count > 0;

    private List<UserDto> FilteredUsers
    {
        get
        {
            IEnumerable<UserDto> query = _users;

            if (_appliedGroupId == "none")
            {
                query = query.Where(user => !GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive));
            }
            else if (int.TryParse(_appliedGroupId, out var groupId))
            {
                query = query.Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive &&
                    m.GroupId == groupId));
            }

            if (!string.IsNullOrEmpty(_appliedRole))
            {
                query = query.Where(user => GetRoleKey(user) == _appliedRole);
            }

            if (!string.IsNullOrEmpty(_appliedStatus))
            {
                var wantActive = _appliedStatus == "Active";
                query = query.Where(user => user.IsActive == wantActive);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        _isSuperAdmin = AuthorizationHelper.IsSuperAdmin(currentUser);
        _adminGroupIds = AuthorizationHelper.GetGroupIdsForRole(currentUser, "Admin").ToHashSet();
        var trainerGroupIds = AuthorizationHelper.GetGroupIdsForRole(currentUser, "Trainer").ToHashSet();
        _listingGroupIds = _adminGroupIds.Concat(trainerGroupIds).ToHashSet();

        var allGroups = (await GroupService.GetAllAsync()).OrderBy(g => g.Name).ToList();
        _availableGroups = _isSuperAdmin
            ? allGroups
            : allGroups.Where(g => _listingGroupIds.Contains(g.Id)).ToList();

        var allUsers = (await UserService.GetAllAsync()).ToList();
        _pendingUsers = _canManage
            ? (await UserRegistrationService.GetPendingApprovalsAsync()).ToList()
            : new List<UserDto>();

        await LoadMembershipsAsync(allUsers.Select(u => u.Id).Concat(_pendingUsers.Select(u => u.Id)));

        _users = _isSuperAdmin
            ? allUsers
            : allUsers
                .Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive &&
                    _listingGroupIds.Contains(m.GroupId)))
                .ToList();

        _pendingRows = BuildPendingRows();

        _loading = false;
    }

    private List<PendingApprovalRow> BuildPendingRows()
    {
        var rows = new List<PendingApprovalRow>();

        foreach (var user in _pendingUsers)
        {
            var pendingMemberships = GetMemberships(user.Id)
                .Where(m => m.Status == GroupMembershipStatus.Pending && (_isSuperAdmin || _adminGroupIds.Contains(m.GroupId)));

            foreach (var membership in pendingMemberships)
            {
                var groupName = _availableGroups.FirstOrDefault(g => g.Id == membership.GroupId)?.Name ?? $"Group #{membership.GroupId}";
                rows.Add(new PendingApprovalRow(membership.Id, user.Id, user.DisplayName, membership.GroupId, groupName, membership.RequestedAt));
            }
        }

        return rows.OrderBy(r => r.RequestedAt).ToList();
    }

    private async Task LoadMembershipsAsync(IEnumerable<int> userIds)
    {
        _membershipsByUser.Clear();
        foreach (var userId in userIds.Distinct())
        {
            _membershipsByUser[userId] = (await GroupService.GetAllMembershipsForUserAsync(userId)).ToList();
        }
    }

    private List<GroupMembershipDto> GetMemberships(int userId) =>
        _membershipsByUser.TryGetValue(userId, out var memberships) ? memberships : [];

    private void GoToCreateUser()
    {
        if (!IsWriteBlocked)
        {
            NavigationManager.NavigateTo("/users/new");
        }
    }

    private void ToggleFilter()
    {
        _showFilter = !_showFilter;
    }

    private void ApplyFilters()
    {
        _appliedGroupId = _pendingGroupId;
        _appliedRole = _pendingRole;
        _appliedStatus = _pendingStatus;
    }

    private void ClearFilters()
    {
        _pendingGroupId = string.Empty;
        _pendingRole = string.Empty;
        _pendingStatus = string.Empty;
        _appliedGroupId = string.Empty;
        _appliedRole = string.Empty;
        _appliedStatus = string.Empty;
    }

    private async Task ApproveRow(PendingApprovalRow row)
    {
        try
        {
            await GroupService.ApproveMemberAsync(row.MembershipId);
            await LoadUsers();
            await ShowToastAsync(
                string.Format(Localizer["UsersPage_MembershipApprovedToast"].Value, row.DisplayName, row.GroupName),
                ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(
                string.Format(Localizer["UsersPage_MembershipActionFailed"].Value, ex.Message),
                ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task DeclineRow(PendingApprovalRow row)
    {
        try
        {
            await GroupService.DeclineMemberAsync(row.MembershipId);
            await LoadUsers();
            await ShowToastAsync(
                string.Format(Localizer["UsersPage_MembershipDeclinedToast"].Value, row.DisplayName, row.GroupName),
                ToastComponent.ToastVariant.Info);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(
                string.Format(Localizer["UsersPage_MembershipActionFailed"].Value, ex.Message),
                ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task ShowToastAsync(string message, ToastComponent.ToastVariant variant)
    {
        if (_toast is not null)
        {
            await _toast.Show(message, variant);
        }
    }

    private string FormatApprovedGroups(int userId)
    {
        var names = GetMemberships(userId)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .Select(m => _availableGroups.FirstOrDefault(g => g.Id == m.GroupId)?.Name ?? $"Group #{m.GroupId}")
            .Distinct()
            .ToList();

        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private static string FormatEntryDate(DateTime? entryDate) => entryDate.HasValue ? entryDate.Value.ToString("dd.MM.yyyy") : "N/A";

    private string GetRoleKey(UserDto user)
    {
        if (user.Role == UserRole.SuperAdmin)
        {
            return "SuperAdmin";
        }

        var memberships = GetMemberships(user.Id)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .ToList();

        if (memberships.Any(m => m.Role == GroupMemberRole.Admin))
        {
            return "GroupAdmin";
        }

        if (memberships.Any(m => m.Role == GroupMemberRole.Trainer))
        {
            return "Trainer";
        }

        return "User";
    }
}
