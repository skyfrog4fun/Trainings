@page "/users"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupAdmin")]

@inject IUserService UserService
@inject IUserRegistrationService UserRegistrationService
@inject IGroupService GroupService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppRuntimeModeService AppRuntimeModeService

<PageTitle>@Localizer["Shared_Users"]</PageTitle>

<div class="container px-2 px-md-4">
    <PageTitleComponent Icon="@AppIcons.Users"
                        Text="@Localizer["Shared_Users"]"
                        ButtonText="@Localizer["Shared_Add"]"
                        ButtonIcon="@AppIcons.Plus"
                        ButtonDisabled="@IsWriteBlocked"
                        OnButtonClick="GoToCreateUser"
                        ShowFilterButton="true"                        
                        OnFilterButtonClick="ToggleFilter">
        <Filter>
            @if (_showFilter)
            {
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-4">
                        <select class="form-select" @bind="_pendingGroupId">
                            <option value="">@Localizer["UsersPage_AllGroups"]</option>
                            @foreach (var group in _availableGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="_pendingRole">
                            <option value="">@Localizer["UsersPage_AllRoles"]</option>
                            <option value="SuperAdmin">@Localizer["Enum_Role_SuperAdmin"]</option>
                            <option value="GroupAdmin">@Localizer["Enum_Role_GroupAdmin"]</option>
                            <option value="Trainer">@Localizer["Enum_Role_Trainer"]</option>
                            <option value="User">@Localizer["Enum_Role_User"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="_pendingStatus">
                            <option value="">@Localizer["UsersPage_AllStatuses"]</option>
                            <option value="Active">@Localizer["Shared_Active"]</option>
                            <option value="Inactive">@Localizer["UsersPage_Inactive"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-primary flex-fill" @onclick="ApplyFilters">
                            <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["Shared_Apply"]
                        </button>
                        <button type="button" class="btn btn-app-outline" @onclick="ClearFilters" title="@Localizer["Shared_ClearFilters"]" aria-label="@Localizer["Shared_ClearFilters"]">
                            <i class="@AppIcons.FilterClear" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </Filter>
    </PageTitleComponent>

    @if (IsWriteBlocked)
    {
        <div class="alert alert-warning">
            @Localizer["UsersPage_ReadOnlyModeSuperAdminOnly"]
        </div>
    }

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (_pendingUsers.Any())
        {
            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning text-dark fw-bold">
                    @Localizer["UsersPage_PendingApprovals", _pendingUsers.Count]
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th></th><th>@Localizer["UsersPage_Name"]</th><th>@Localizer["UsersPage_RequestedGroup"]</th><th>@Localizer["UsersPage_RegistrationDate"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _pendingUsers)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title='@Localizer["UsersPage_ToggleDetails"]' @onclick="() => TogglePendingExpand(user.Id)">
                                            <i class="@(_expandedPendingUserIds.Contains(user.Id) ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                    <td>@user.DisplayName</td>
                                    <td>@FormatPendingGroups(user.Id)</td>
                                    <td>@user.CreationDate.ToString("MMM d, yyyy")</td>
                                </tr>
                                @if (_expandedPendingUserIds.Contains(user.Id))
                                {
                                    <tr class="table-light">
                                        <td colspan="4">
                                            <div class="row g-2">
                                                <div class="col-12 col-md-6"><strong>@Localizer["Shared_Email"]:</strong> @user.Email</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Shared_Country"]:</strong> @(GetCountryLabel(user.CountryId))</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Shared_City"]:</strong> @(string.IsNullOrWhiteSpace(user.City) ? "—" : user.City)</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Shared_Mobile"]:</strong> @(string.IsNullOrWhiteSpace(user.Mobile) ? "—" : user.Mobile)</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["UsersPage_Gender"]:</strong> @user.Gender</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["UsersPage_EmailVerified"]:</strong> @(user.EmailConfirmedAt.HasValue ? Localizer["Enum_Decision_Yes"] : Localizer["Enum_Decision_No"])</div>
                                                <div class="col-12 text-end">
                                                    <button type="button" class="btn btn-sm btn-success me-1" @onclick="() => ApproveUser(user)" disabled="@IsWriteBlocked">
                                                        <i class="@AppIcons.Check" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => RejectUser(user)" disabled="@IsWriteBlocked">
                                                        <i class="@AppIcons.XMark" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (FilteredUsers.Count == 0)
        {
            <div class="alert alert-info">@Localizer["UsersPage_NoUsersMatchCurrentFilters"]</div>
        }
        else
        {
            <div class="app-overview-grid">
                @foreach (var user in FilteredUsers)
                {
                    <a href="/users/@user.Id" class="app-overview-card app-overview-card-link text-decoration-none text-reset">
                        <div class="app-overview-main">
                            <div class="app-overview-title text-break">@user.DisplayName</div>
                            <div class="app-overview-meta text-break mt-1"><i class="@AppIcons.UserGroup me-1" aria-hidden="true"></i>@FormatApprovedGroups(user.Id)</div>
                            <div class="app-overview-meta mt-1"><i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@Localizer["UsersPage_EntryDate"]: @FormatEntryDate(user.EntryDate)</div>
                        </div>
                        <div class="app-overview-actions">
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? Localizer["Shared_Active"] : Localizer["UsersPage_Inactive"])</span>
                            <i class="fa-solid fa-chevron-right text-muted" aria-hidden="true"></i>
                        </div>
                    </a>
                }
            </div>
        }
    }
</div>

@code {
    private List<UserDto> _users = new();
    private List<UserDto> _pendingUsers = new();
    private Dictionary<int, List<GroupMembershipDto>> _membershipsByUser = new();
    private List<GroupDto> _availableGroups = new();
    private List<CountryDto> _countries = new();
    private readonly HashSet<int> _expandedPendingUserIds = new();
    private HashSet<int> _managedGroupIds = new();
    private AppRuntimeModeDto _runtimeMode = new();
    private bool _isSuperAdmin;
    private bool _loading = true;

    private bool _showFilter;
    private string _pendingGroupId = string.Empty;
    private string _pendingRole = string.Empty;
    private string _pendingStatus = string.Empty;
    private string _appliedGroupId = string.Empty;
    private string _appliedRole = string.Empty;
    private string _appliedStatus = string.Empty;

    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;

    private List<UserDto> FilteredUsers
    {
        get
        {
            IEnumerable<UserDto> query = _users;

            if (int.TryParse(_appliedGroupId, out var groupId))
            {
                query = query.Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive &&
                    m.GroupId == groupId));
            }

            if (!string.IsNullOrEmpty(_appliedRole))
            {
                query = query.Where(user => GetRoleKey(user) == _appliedRole);
            }

            if (!string.IsNullOrEmpty(_appliedStatus))
            {
                var wantActive = _appliedStatus == "Active";
                query = query.Where(user => user.IsActive == wantActive);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        _expandedPendingUserIds.Clear();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        _isSuperAdmin = currentUser.HasClaim("SuperAdmin", "true");
        _managedGroupIds = currentUser.Claims
            .Where(c => c.Type.StartsWith("GroupRole::", StringComparison.Ordinal) && c.Value == "Admin")
            .Select(c => int.TryParse(c.Type["GroupRole::".Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();

        var allGroups = (await GroupService.GetAllAsync()).OrderBy(g => g.Name).ToList();
        _availableGroups = _isSuperAdmin
            ? allGroups
            : allGroups.Where(g => _managedGroupIds.Contains(g.Id)).ToList();

        _countries = (await CountryService.GetAllAsync()).ToList();

        var allUsers = (await UserService.GetAllAsync()).ToList();
        var pendingUsers = (await UserRegistrationService.GetPendingApprovalsAsync()).ToList();
        await LoadMembershipsAsync(allUsers.Select(u => u.Id).Concat(pendingUsers.Select(u => u.Id)));

        if (_isSuperAdmin)
        {
            _users = allUsers;
            _pendingUsers = pendingUsers;
        }
        else
        {
            _users = allUsers
                .Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive &&
                    _managedGroupIds.Contains(m.GroupId)))
                .ToList();

            _pendingUsers = pendingUsers
                .Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Pending &&
                    _managedGroupIds.Contains(m.GroupId)))
                .ToList();
        }

        _loading = false;
    }

    private async Task LoadMembershipsAsync(IEnumerable<int> userIds)
    {
        _membershipsByUser.Clear();
        foreach (var userId in userIds.Distinct())
        {
            _membershipsByUser[userId] = (await GroupService.GetAllMembershipsForUserAsync(userId)).ToList();
        }
    }

    private List<GroupMembershipDto> GetMemberships(int userId) =>
        _membershipsByUser.TryGetValue(userId, out var memberships) ? memberships : [];

    private void GoToCreateUser()
    {
        if (!IsWriteBlocked)
        {
            NavigationManager.NavigateTo("/users/new");
        }
    }

    private void ToggleFilter()
    {
        _showFilter = !_showFilter;
    }

    private void ApplyFilters()
    {
        _appliedGroupId = _pendingGroupId;
        _appliedRole = _pendingRole;
        _appliedStatus = _pendingStatus;
    }

    private void ClearFilters()
    {
        _pendingGroupId = string.Empty;
        _pendingRole = string.Empty;
        _pendingStatus = string.Empty;
        _appliedGroupId = string.Empty;
        _appliedRole = string.Empty;
        _appliedStatus = string.Empty;
    }

    private async Task ApproveUser(UserDto user)
    {
        await UserRegistrationService.ApproveUserAsync(user.Id, 0);
        await LoadUsers();
    }

    private async Task RejectUser(UserDto user)
    {
        await UserRegistrationService.RejectUserAsync(user.Id, 0);
        await LoadUsers();
    }

    private void TogglePendingExpand(int userId)
    {
        if (_expandedPendingUserIds.Contains(userId))
        {
            _expandedPendingUserIds.Remove(userId);
        }
        else
        {
            _expandedPendingUserIds.Add(userId);
        }
    }

    private string FormatApprovedGroups(int userId)
    {
        var names = GetMemberships(userId)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .Select(m => _availableGroups.FirstOrDefault(g => g.Id == m.GroupId)?.Name ?? $"Group #{m.GroupId}")
            .Distinct()
            .ToList();

        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private string FormatPendingGroups(int userId)
    {
        var names = GetMemberships(userId)
            .Where(m => m.Status == GroupMembershipStatus.Pending)
            .Select(m => _availableGroups.FirstOrDefault(g => g.Id == m.GroupId)?.Name ?? $"Group #{m.GroupId}")
            .Distinct()
            .ToList();

        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private string GetCountryLabel(int? countryId)
    {
        if (!countryId.HasValue)
        {
            return "—";
        }

        var country = _countries.FirstOrDefault(c => c.Id == countryId.Value);
        return country is null ? "—" : $"{country.Code} — {country.Name}";
    }

    private static string FormatEntryDate(DateTime? entryDate) =>
        entryDate.HasValue ? entryDate.Value.ToString("yyyy-MM-dd") : "—";

    private string GetRoleKey(UserDto user)
    {
        if (user.Role == UserRole.SuperAdmin)
        {
            return "SuperAdmin";
        }

        var memberships = GetMemberships(user.Id)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .ToList();

        if (memberships.Any(m => m.Role == GroupMemberRole.Admin))
        {
            return "GroupAdmin";
        }

        if (memberships.Any(m => m.Role == GroupMemberRole.Trainer))
        {
            return "Trainer";
        }

        return "User";
    }
}
