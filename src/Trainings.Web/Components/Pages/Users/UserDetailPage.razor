@page "/users/{Id:int}"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupTrainer")]

@inject IUserService UserService
@inject IUserRegistrationService UserRegistrationService
@inject IGroupService GroupService
@inject IRegistrationService RegistrationService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationHelper AuthorizationHelper

<PageTitle>@Localizer["UserDetailPage_PageTitle"]</PageTitle>

<div class="container px-2 px-md-4">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_user is null)
    {
        <div class="alert alert-danger">@Localizer["UserDetailPage_UserNotFound"]</div>
    }
    else if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["UserDetailPage_AccessDenied"]</div>
    }
    else
    {
        <PageTitleComponent Icon="@AppIcons.User" Text="@_user.DisplayName" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />

        <div class="mb-3">
            <ActionAlert IsSuccess="@_actionSuccess" Message="@_actionResult" />
        </div>

        <div class="row g-3 mb-3 align-items-start">
            <div class="col-12 col-lg-6">
                <CardComponent Collapsed="false" ShowFooter="true">
                    <Title>@Localizer["UserDetailPage_ProfileTitle"]</Title>
                    <TitleMeta><BadgeStatusComponent IsActive="_user.IsActive" /></TitleMeta>
                    <Body>
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_EmailLabel"]</th><td class="text-end">@_user.Email</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_EmailVerifiedLabel"]</th><td class="text-end">@(_user.EmailConfirmedAt.HasValue ? Localizer["Enum_Decision_Yes"] : Localizer["Enum_Decision_No"])</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_MobileLabel"]</th><td class="text-end">@FormatText(_user.Mobile)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_RoleLabel"]</th><td class="text-end">@GetRoleLabel(_user.Role)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_GenderLabel"]</th><td class="text-end">@_user.Gender.Localize(Localizer)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_BirthdayLabel"]</th><td class="text-end">@FormatDate(_user.Birthday)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_CityLabel"]</th><td class="text-end">@FormatText(_user.City)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_CountryLabel"]</th><td class="text-end">@GetCountryLabel(_user.CountryId, _user.CountryCode)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_EntryDateLabel"]</th><td class="text-end">@FormatEntryDate(_user.EntryDate)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_BioWelcomeMessageTitle"]</th><td class="text-end">@FormatText(_user.WelcomeMessage)</td></tr>
                                <tr><th class="text-muted fw-normal">@Localizer["UserDetailPage_CreatedLabel"]</th><td class="text-end">@FormatDateTime(_user.CreationDate)</td></tr>
                            </tbody>
                        </table>
                    </Body>
                    <Footer>
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/users/@_user.Id/edit" class="btn btn-sm btn-primary">
                                    <i class="@AppIcons.Edit me-1" aria-hidden="true"></i>@Localizer["Shared_Edit"]
                                </a>
                                @if (!_user.EmailConfirmedAt.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-app-outline" @onclick="SendAccountMail" disabled="@_sendingMail">
                                        @if (_sendingMail)
                                        {
                                            <LoadingSpinner Inline="true" Small="true" />
                                        }
                                        else
                                        {
                                            <i class="@AppIcons.Envelope me-1" aria-hidden="true"></i>@Localizer["UserDetailPage_Verify"]
                                        }
                                    </button>
                                }
                            </div>
                            @if (_canDelete)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="PromptDelete" disabled="@_deleting">
                                    <i class="@AppIcons.Trash me-1" aria-hidden="true"></i>@Localizer["Shared_Delete"]
                                </button>
                            }
                        </div>
                    </Footer>
                </CardComponent>
            </div>
            <div class="col-12 col-lg-6">
                <CardComponent Collapsed="@(_membershipRows.Count == 0)">
                    <Title>@Localizer["UserDetailPage_GroupMembershipsTitle"]</Title>
                    <TitleMeta>@_membershipRows.Count</TitleMeta>
                    <Body>
                        @if (_membershipRows.Count > 0)
                        {
                            <div class="app-overview-grid">
                                @foreach (var row in _membershipRows)
                                {
                                    <div class="app-overview-card">
                                        <div class="app-overview-main w-100 d-flex flex-column gap-1">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <div class="app-overview-title text-break">@row.GroupName</div>
                                                <div class="fw-semibold text-nowrap">@row.Role.Localize(Localizer)</div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <div class="app-overview-meta">@row.Status.Localize(Localizer)</div>
                                                <div class="app-overview-meta">@row.StatusDate.ToString("dd.MM.yyyy")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">@Localizer["UserDetailPage_NoMemberships"]</div>
                        }
                    </Body>
                </CardComponent>
            </div>
        </div>

        <CardComponent Collapsed="@(_registrations.Count == 0)">
            <Title>@Localizer["UserDetailPage_RegistrationsTitle"]</Title>
            <TitleMeta>@_registrations.Count</TitleMeta>
            <Body>
                @if (_registrations.Count > 0)
                {
                    <div class="app-overview-grid">
                        @foreach (var registration in _registrations)
                        {
                            <a href="/trainings/@registration.TrainingId" class="app-overview-card app-overview-card-link text-decoration-none text-reset">
                                <div class="app-overview-main w-100 d-flex flex-column gap-1">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <div class="app-overview-title text-break">@registration.TrainingTitle</div>
                                        <span class="badge @GetRegistrationStatusBadgeClass(registration.Status)">@registration.Status.Localize(Localizer)</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <div class="app-overview-meta">@FormatText(registration.TrainingGroupName)</div>
                                        <div class="app-overview-meta">@registration.TrainingDateTime.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">@Localizer["UserDetailPage_NoRegistrations"]</div>
                }
            </Body>
        </CardComponent>
    }
</div>

<ConfirmDialogComponent IsVisible="_showDeleteConfirm"
                        Title="@Localizer["UserDetailPage_DeleteConfirmTitle"]"
                        Message="@Localizer["UserDetailPage_DeleteConfirmMessage"]"
                        ConfirmText="@Localizer["Shared_Delete"]"
                        CancelText="@Localizer["Shared_Cancel"]"
                        OnConfirm="ConfirmDeleteAsync"
                        OnCancel="CancelDelete" />

<EmailPreviewModal Preview="_emailPreview" OnClose="CloseEmailPreview" />

@code {
    private sealed record MembershipRow(int GroupId, string GroupName, GroupMemberRole Role, GroupMembershipStatus Status, DateTime StatusDate);

    [Parameter] public int Id { get; set; }

    private UserDto? _user;
    private List<GroupMembershipDto> _memberships = new();
    private List<MembershipRow> _membershipRows = new();
    private List<RegistrationDto> _registrations = new();
    private Dictionary<int, string> _groupNameById = new();
    private Dictionary<int, string> _countryNameById = new();
    private bool _loading = true;
    private bool _isAccessDenied;
    private bool _sendingMail;
    private bool _actionSuccess;
    private string? _actionResult;
    private EmailPreviewDto? _emailPreview;
    private bool _canDelete;
    private bool _showDeleteConfirm;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        var isSuperAdmin = AuthorizationHelper.IsSuperAdmin(currentUser);
        var managedGroupIds = AuthorizationHelper.GetGroupIdsForRole(currentUser, "Admin")
            .Concat(AuthorizationHelper.GetGroupIdsForRole(currentUser, "Trainer"))
            .ToHashSet();

        _user = await UserService.GetByIdAsync(Id);
        if (_user is null)
        {
            _loading = false;
            return;
        }

        _memberships = (await GroupService.GetAllMembershipsForUserAsync(Id))
            .OrderBy(m => m.GroupId)
            .ThenBy(m => m.Status)
            .ToList();

        if (!isSuperAdmin)
        {
            var canAccess = _memberships.Any(m =>
                m.Status == GroupMembershipStatus.Approved &&
                m.IsActive &&
                managedGroupIds.Contains(m.GroupId));

            if (!canAccess)
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }
        }

        _registrations = (await RegistrationService.GetByUserIdAsync(Id))
            .OrderByDescending(r => r.TrainingDateTime)
            .ToList();

        _canDelete = _registrations.Count == 0;

        _groupNameById = (await GroupService.GetAllAsync())
            .ToDictionary(g => g.Id, g => g.Name);

        _countryNameById = (await CountryService.GetAllAsync())
            .ToDictionary(c => c.Id, c => c.Name);

        _membershipRows = BuildMembershipRows(_memberships);

        _loading = false;
    }

    private List<MembershipRow> BuildMembershipRows(IEnumerable<GroupMembershipDto> memberships) =>
        memberships
            .GroupBy(m => m.GroupId)
            .Select(g => g.OrderByDescending(GetLatestActivityTimestamp).First())
            .Select(m => new MembershipRow(m.GroupId, GetGroupLabel(m.GroupId), m.Role, m.Status, GetStatusDate(m)))
            .OrderBy(r => r.GroupName)
            .ToList();

    private static DateTime GetLatestActivityTimestamp(GroupMembershipDto membership) =>
        new[] { membership.JoinedAt, membership.RequestedAt, membership.ApprovedAt ?? DateTime.MinValue, membership.DeclinedAt ?? DateTime.MinValue }.Max();

    private static DateTime GetStatusDate(GroupMembershipDto membership) => membership.Status switch
    {
        GroupMembershipStatus.Approved => membership.JoinedAt,
        GroupMembershipStatus.Declined => membership.DeclinedAt ?? membership.RequestedAt,
        _ => membership.RequestedAt
    };

    private string GetRoleLabel(UserRole role) => Localizer[$"Enum_Role_{role}"];

    private static string GetRegistrationStatusBadgeClass(RegistrationStatus status) =>
        status == RegistrationStatus.Registered ? "bg-success" : "bg-secondary";

    private void GoBack() => NavigationManager.NavigateTo("/users");

    private string GetGroupLabel(int groupId) =>
        _groupNameById.TryGetValue(groupId, out var groupName) ? groupName : string.Format(Localizer["UserDetailPage_GroupNumberFallback"].Value, groupId);

    private string GetCountryLabel(int? countryId, string? countryCode)
    {
        if (countryId.HasValue && _countryNameById.TryGetValue(countryId.Value, out var countryName))
        {
            return countryName;
        }

        return string.IsNullOrWhiteSpace(countryCode) ? "-" : countryCode;
    }

    private static string FormatDate(DateOnly? date) => date.HasValue ? date.Value.ToString("dd.MM.yyyy") : "-";

    private static string FormatEntryDate(DateTime? dateTime) => dateTime.HasValue ? dateTime.Value.ToString("dd.MM.yyyy") : "-";

    private static string FormatDateTime(DateTime? dateTime) => dateTime.HasValue ? dateTime.Value.ToString("dd.MM.yyyy") : "-";

    private static string FormatText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task SendAccountMail()
    {
        if (_user is null)
        {
            return;
        }

        _actionResult = null;
        _sendingMail = true;

        try
        {
            var result = await UserRegistrationService.ResendEmailConfirmationAsync(_user.Id);
            _actionSuccess = true;
            _actionResult = result.Preview is null
                ? Localizer["UserDetailPage_AccountEmailSentTo", _user.Email]
                : Localizer["UserDetailPage_NoEmailModePreviewShown", _user.Email];
            _emailPreview = result.Preview;
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = Localizer["UserDetailPage_FailedMessage", ex.Message];
        }
        finally
        {
            _sendingMail = false;
        }
    }

    private Task CloseEmailPreview()
    {
        _emailPreview = null;
        return Task.CompletedTask;
    }

    private void PromptDelete()
    {
        if (!_canDelete)
        {
            return;
        }

        _showDeleteConfirm = true;
    }

    private void CancelDelete() => _showDeleteConfirm = false;

    private async Task ConfirmDeleteAsync()
    {
        _showDeleteConfirm = false;

        if (_user is null || !_canDelete)
        {
            return;
        }

        _deleting = true;

        try
        {
            foreach (var membership in _memberships)
            {
                await GroupService.RemoveMemberAsync(membership.Id);
            }

            await UserService.DeleteAsync(_user.Id);
            NavigationManager.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = Localizer["UserDetailPage_FailedMessage", ex.Message];
            _deleting = false;
        }
    }
}
