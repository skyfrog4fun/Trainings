@page "/users/new"
@page "/users/{Id:int}/edit"

@using System.ComponentModel.DataAnnotations

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupAdmin")]

@inject IUserService UserService
@inject IGroupService GroupService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppRuntimeModeService AppRuntimeModeService

<PageTitle>@(_isEdit ? Localizer["UserCreateEditPage_EditUser"] : Localizer["UserCreateEditPage_CreateUser"])</PageTitle>

<div class="container px-2 px-md-4">
    
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["UserCreateEditPage_AccessDenied"]</div>
    }
    else
    {
        <PageTitleComponent Icon="@AppIcons.User" Text="@(_isEdit ? Localizer["UserCreateEditPage_EditUser"] : Localizer["UserCreateEditPage_CreateUser"])"
            ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack"/>

        @if (IsWriteBlocked)
        {
            <div class="alert alert-warning">
                @Localizer["UserCreateEditPage_ReadOnlyModeSuperAdminOnly"]
            </div>
        }

        <EditForm Model="_formModel" OnValidSubmit="SaveUserAsync">
            <DataAnnotationsValidator />
            <CardComponent IsCollapsable="false" ShowFooter="true">
                <Title>@(_isEdit ? Localizer["UserCreateEditPage_EditUser"] : Localizer["UserCreateEditPage_CreateUser"])</Title>
                <Body>
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_FirstName"]</label>
                            <InputText class="form-control" placeholder='@Localizer["UserCreateEditPage_FirstNamePlaceholder"]' @bind-Value="_formModel.FirstName" />
                            <ValidationMessage For="() => _formModel.FirstName" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_LastName"]</label>
                            <InputText class="form-control" placeholder='@Localizer["UserCreateEditPage_LastNamePlaceholder"]' @bind-Value="_formModel.LastName" />
                            <ValidationMessage For="() => _formModel.LastName" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_Email"]</label>
                            <InputText class="form-control" type="email" placeholder='@Localizer["UserCreateEditPage_EmailPlaceholder"]' @bind-Value="_formModel.Email" />
                            <ValidationMessage For="() => _formModel.Email" class="text-danger small" />
                        </div>
                        @if (!_isEdit)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer["UserCreateEditPage_Password"]</label>
                                <input class="form-control" type="password" placeholder='@Localizer["UserCreateEditPage_PasswordPlaceholder"]' @bind="_formModel.Password" />
                                <ValidationMessage For="() => _formModel.Password" class="text-danger small" />
                            </div>
                        }
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer["UserCreateEditPage_Role"]</label>
                            @if (_isSuperAdmin)
                            {
                                <select class="form-select" @bind="_formModel.Role">
                                    <option value="User">@Localizer["UserCreateEditPage_User"]</option>
                                    <option value="SuperAdmin">@Localizer["UserCreateEditPage_SuperAdmin"]</option>
                                </select>
                            }
                            else
                            {
                                <select class="form-select" @bind="_formModel.Role">
                                    <option value="User">@Localizer["UserCreateEditPage_User"]</option>
                                </select>
                            }
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer["UserCreateEditPage_Gender"]</label>
                            <select class="form-select" @bind="_formModel.Gender">
                                <option value="Male">@Localizer["Enum_Gender_Male"]</option>
                                <option value="Female">@Localizer["Enum_Gender_Female"]</option>
                                <option value="Other">@Localizer["Enum_Gender_Other"]</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">@Localizer["UserCreateEditPage_Birthday"]</label>
                            <InputDate class="form-control" @bind-Value="_formModel.Birthday" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_Mobile"]</label>
                            <InputText class="form-control" placeholder='@Localizer["UserCreateEditPage_MobilePlaceholder"]' @bind-Value="_formModel.Mobile" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_City"]</label>
                            <InputText class="form-control" placeholder='@Localizer["UserCreateEditPage_CityPlaceholder"]' @bind-Value="_formModel.City" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserCreateEditPage_Country"]</label>
                            <select class="form-select" @bind="_formModel.CountryId">
                                <option value="">@Localizer["UserCreateEditPage_SelectCountry"]</option>
                                @foreach (var country in _countries)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@(_isSuperAdmin ? Localizer["UserCreateEditPage_Groups"] : Localizer["UserCreateEditPage_ManagedGroups"])</label>
                            @if (_availableGroups.Any())
                            {
                                <div class="border rounded p-2 scroll-container-sm">
                                    @foreach (var group in _availableGroups)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="user-group-@group.Id"
                                                   checked="@_selectedGroupIds.Contains(group.Id)"
                                                   @onchange="e => ToggleGroup(group.Id, (bool)(e.Value ?? false))" />
                                            <label class="form-check-label" for="user-group-@group.Id">@group.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="form-text text-muted">@Localizer["UserCreateEditPage_NoGroupsAvailableForAssignment"]</div>
                            }
                        </div>
                        @if (_isEdit)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer["UserCreateEditPage_EntryDate"]</label>
                                <InputDate class="form-control" @bind-Value="_formModel.EntryDate" />
                            </div>
                            <div class="col-12 col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" id="isActive" type="checkbox" @bind="_formModel.IsActive" />
                                    <label class="form-check-label" for="isActive">@Localizer["Shared_Active"]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">@Localizer["UserCreateEditPage_WelcomeMessage"]</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_formModel.WelcomeMessage" placeholder='@Localizer["UserCreateEditPage_WelcomeMessagePlaceholder"]' />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@Localizer["UserCreateEditPage_SetNewPasswordLeaveBlank"]</label>
                                <div class="input-group">
                                    <input class="form-control" type="password" placeholder='@Localizer["UserCreateEditPage_NewPasswordMinCharsPlaceholder"]' @bind="_formModel.NewPassword" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword" title='@Localizer["UserCreateEditPage_GeneratePassword"]'>
                                        <i class="@AppIcons.Wand" aria-hidden="true"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(_passwordValidationError))
                                {
                                    <div class="text-danger small mt-1">@_passwordValidationError</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="mt-2">
                        <ActionAlert IsSuccess="false" Message="@_formError" />
                    </div>
                </Body>
                <Footer>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@(_saving || IsWriteBlocked)"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]</button>
                        <a href="/users" class="btn btn-secondary"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]</a>
                    </div>
                </Footer>
            </CardComponent>
        </EditForm>
    }
</div>

@code {
    private class UserFormModel : IValidatableObject
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = "User";
        public string Gender { get; set; } = "Other";
        public DateTime? Birthday { get; set; }
        public string Mobile { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public int? CountryId { get; set; }
        public string WelcomeMessage { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public DateTime? EntryDate { get; set; }
        public bool IsActive { get; set; } = true;

        internal bool IsEdit { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var localizer = validationContext.GetService(typeof(IStringLocalizer<SharedResources>)) as IStringLocalizer<SharedResources>;

            if (string.IsNullOrWhiteSpace(FirstName))
            {
                yield return new ValidationResult(GetMessage(localizer, "UserCreateEditPage_FirstNameRequired"), new[] { nameof(FirstName) });
            }

            if (string.IsNullOrWhiteSpace(LastName))
            {
                yield return new ValidationResult(GetMessage(localizer, "UserCreateEditPage_LastNameRequired"), new[] { nameof(LastName) });
            }

            if (string.IsNullOrWhiteSpace(Email))
            {
                yield return new ValidationResult(GetMessage(localizer, "UserCreateEditPage_EmailRequired"), new[] { nameof(Email) });
            }
            else if (!new EmailAddressAttribute().IsValid(Email))
            {
                yield return new ValidationResult(GetMessage(localizer, "UserCreateEditPage_EmailInvalid"), new[] { nameof(Email) });
            }

            if (!IsEdit && string.IsNullOrWhiteSpace(Password))
            {
                yield return new ValidationResult(GetMessage(localizer, "UserCreateEditPage_PasswordRequired"), new[] { nameof(Password) });
            }
        }

        private static string GetMessage(IStringLocalizer<SharedResources>? localizer, string key) => localizer is null ? key : localizer[key].Value;
    }

    [Parameter] public int? Id { get; set; }

    private List<GroupDto> _availableGroups = new();
    private List<CountryDto> _countries = new();
    private HashSet<int> _managedGroupIds = new();
    private HashSet<int> _selectedGroupIds = new();
    private AppRuntimeModeDto _runtimeMode = new();
    private bool _isSuperAdmin;
    private bool _loading = true;
    private bool _saving;
    private bool _isAccessDenied;
    private string _passwordValidationError = string.Empty;
    private string? _formError;
    private UserFormModel _formModel = new();

    private bool _isEdit => Id.HasValue;
    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
        _formModel.IsEdit = _isEdit;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        _isSuperAdmin = currentUser.HasClaim("SuperAdmin", "true");
        _managedGroupIds = currentUser.Claims
            .Where(c => c.Type.StartsWith("GroupRole::", StringComparison.Ordinal) && c.Value == "Admin")
            .Select(c => int.TryParse(c.Type["GroupRole::".Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();

        var allGroups = (await GroupService.GetAllAsync()).OrderBy(g => g.Name).ToList();
        _availableGroups = _isSuperAdmin
            ? allGroups
            : allGroups.Where(g => _managedGroupIds.Contains(g.Id)).ToList();

        _countries = (await CountryService.GetAllAsync()).ToList();

        if (_isEdit)
        {
            await LoadForEditAsync();
        }

        _loading = false;
    }

    private async Task LoadForEditAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var user = await UserService.GetByIdAsync(Id.Value);
        if (user is null)
        {
            _formError = Localizer["UserCreateEditPage_UserNotFound"];
            return;
        }

        var memberships = (await GroupService.GetAllMembershipsForUserAsync(user.Id)).ToList();

        if (!_isSuperAdmin)
        {
            var canAccess = memberships.Any(m =>
                m.Status == GroupMembershipStatus.Approved &&
                m.IsActive &&
                _managedGroupIds.Contains(m.GroupId));

            if (!canAccess)
            {
                _isAccessDenied = true;
                return;
            }
        }

        _formModel.FirstName = user.FirstName;
        _formModel.LastName = user.LastName;
        _formModel.Email = user.Email;
        _formModel.Role = user.Role.ToString();
        _formModel.Gender = user.Gender.ToString();
        _formModel.Birthday = user.Birthday?.ToDateTime(TimeOnly.MinValue);
        _formModel.Mobile = user.Mobile ?? string.Empty;
        _formModel.City = user.City ?? string.Empty;
        _formModel.CountryId = user.CountryId;
        _formModel.WelcomeMessage = user.WelcomeMessage ?? string.Empty;
        _formModel.EntryDate = user.EntryDate;
        _formModel.IsActive = user.IsActive;
        _selectedGroupIds = memberships
            .Where(m => _isSuperAdmin || _managedGroupIds.Contains(m.GroupId))
            .Select(m => m.GroupId)
            .ToHashSet();
    }

    private async Task SaveUserAsync()
    {
        if (IsWriteBlocked)
        {
            return;
        }

        _saving = true;
        _formError = null;
        _passwordValidationError = string.Empty;

        if (!_isSuperAdmin && _selectedGroupIds.Count == 0)
        {
            _formError = Localizer["UserCreateEditPage_AssignUserToManagedGroup"];
            _saving = false;
            return;
        }

        try
        {
            var birthday = _formModel.Birthday.HasValue ? DateOnly.FromDateTime(_formModel.Birthday.Value) : (DateOnly?)null;
            int userId;

            if (!_isEdit)
            {
                var createdUser = await UserService.CreateAsync(new CreateUserDto
                {
                    FirstName = _formModel.FirstName,
                    LastName = _formModel.LastName,
                    Email = _formModel.Email,
                    Password = _formModel.Password,
                    Role = Enum.Parse<UserRole>(_formModel.Role),
                    Gender = Enum.Parse<Gender>(_formModel.Gender),
                    Birthday = birthday,
                    Mobile = string.IsNullOrWhiteSpace(_formModel.Mobile) ? null : _formModel.Mobile,
                    City = string.IsNullOrWhiteSpace(_formModel.City) ? null : _formModel.City,
                    CountryId = _formModel.CountryId
                });

                userId = createdUser.Id;
            }
            else
            {
                userId = Id!.Value;
                await UserService.UpdateAsync(new UpdateUserDto
                {
                    Id = userId,
                    FirstName = _formModel.FirstName,
                    LastName = _formModel.LastName,
                    Email = _formModel.Email,
                    Role = Enum.Parse<UserRole>(_formModel.Role),
                    Gender = Enum.Parse<Gender>(_formModel.Gender),
                    IsActive = _formModel.IsActive,
                    Birthday = birthday,
                    Mobile = string.IsNullOrWhiteSpace(_formModel.Mobile) ? null : _formModel.Mobile,
                    City = string.IsNullOrWhiteSpace(_formModel.City) ? null : _formModel.City,
                    CountryId = _formModel.CountryId,
                    EntryDate = _formModel.EntryDate,
                    WelcomeMessage = string.IsNullOrWhiteSpace(_formModel.WelcomeMessage) ? null : _formModel.WelcomeMessage
                });
            }

            await SyncUserGroupsAsync(userId);

            if (_isEdit && !string.IsNullOrWhiteSpace(_formModel.NewPassword))
            {
                if (!ValidatePassword(_formModel.NewPassword, out var pwError))
                {
                    _passwordValidationError = Localizer[pwError];
                    return;
                }

                await UserService.ChangePasswordAsync(userId, _formModel.NewPassword);
            }

            NavigationManager.NavigateTo($"/users/{userId}");
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SyncUserGroupsAsync(int userId)
    {
        var availableGroupIds = _availableGroups.Select(g => g.Id).ToHashSet();
        var memberships = (await GroupService.GetAllMembershipsForUserAsync(userId))
            .Where(m => availableGroupIds.Contains(m.GroupId))
            .ToList();

        foreach (var membership in memberships.Where(m => !_selectedGroupIds.Contains(m.GroupId)))
        {
            await GroupService.RemoveMemberAsync(membership.Id);
        }

        foreach (var groupId in _selectedGroupIds)
        {
            var groupMemberships = memberships.Where(m => m.GroupId == groupId).ToList();
            if (groupMemberships.Any(m => m.Status == GroupMembershipStatus.Approved && m.IsActive))
            {
                continue;
            }

            foreach (var membership in groupMemberships)
            {
                await GroupService.RemoveMemberAsync(membership.Id);
            }

            await GroupService.AddMemberAsync(new AddGroupMemberDto
            {
                GroupId = groupId,
                UserId = userId,
                Role = GroupMemberRole.Participant
            });
        }
    }

    private void GoBack()
    {
        if (_isEdit)
        {
            NavigationManager.NavigateTo($"/users/{Id}");
        }
        else
        {
            NavigationManager.NavigateTo("/users");
        
        }
    }

    private void ToggleGroup(int groupId, bool selected)
    {
        if (selected)
        {
            _selectedGroupIds.Add(groupId);
        }
        else
        {
            _selectedGroupIds.Remove(groupId);
        }
    }

    private void GeneratePassword()
    {
        _formModel.NewPassword = PasswordGenerator.Generate();
        _passwordValidationError = string.Empty;
    }

    private static bool ValidatePassword(string password, out string error)
    {
        error = string.Empty;
        if (password.Length < 8) { error = "UserCreateEditPage_PasswordValidationMinLength"; return false; }
        if (!password.Any(char.IsUpper)) { error = "UserCreateEditPage_PasswordValidationUppercase"; return false; }
        if (!password.Any(char.IsLower)) { error = "UserCreateEditPage_PasswordValidationLowercase"; return false; }
        if (!password.Any(char.IsDigit)) { error = "UserCreateEditPage_PasswordValidationDigit"; return false; }
        if (!password.Any(c => "!@#$%^&*()-_=+[]{}|;:',.<>?".Contains(c))) { error = "UserCreateEditPage_PasswordValidationSpecialCharacter"; return false; }
        return true;
    }
}
