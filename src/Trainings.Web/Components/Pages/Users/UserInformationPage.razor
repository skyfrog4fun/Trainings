@page "/user-information"

@rendermode InteractiveServer

@attribute [Authorize]

@inject IUserService UserService
@inject IGroupService GroupService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@Localizer["UserInformationPage_PageTitle"]</PageTitle>

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<div class="container px-2 px-md-4">
    <PageTitleComponent Icon="@AppIcons.User" Text="@Localizer["UserInformationPage_PageTitle"]" />

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_user is null)
    {
        <div class="alert alert-danger">@Localizer["UserInformationPage_UnableToLoadProfile"]</div>
    }
    else
    {
        <EditForm Model="_profile" OnValidSubmit="SaveProfile">
            <DataAnnotationsValidator />
            <CardComponent IsCollapsable="false" ShowFooter="true">
                <Title>@Localizer["UserInformationPage_ProfileTitle"]</Title>
                <Body>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserInformationPage_FirstName"]</label>
                            <InputText class="form-control" @bind-Value="_profile.FirstName" />
                            <ValidationMessage For="() => _profile.FirstName" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserInformationPage_LastName"]</label>
                            <InputText class="form-control" @bind-Value="_profile.LastName" />
                            <ValidationMessage For="() => _profile.LastName" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["Shared_Email"]</label>
                            <InputText type="email" class="form-control" @bind-Value="_profile.Email" />
                            <ValidationMessage For="() => _profile.Email" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["Shared_Mobile"]</label>
                            <InputText class="form-control" @bind-Value="_profile.Mobile" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserInformationPage_Birthday"]</label>
                            <InputDate class="form-control" @bind-Value="_profile.Birthday" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["UserInformationPage_Gender"]</label>
                            <select class="form-select" @bind="_profile.Gender">
                                <option value="Male">@Localizer["Enum_Gender_Male"]</option>
                                <option value="Female">@Localizer["Enum_Gender_Female"]</option>
                                <option value="Other">@Localizer["Enum_Gender_Other"]</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["Shared_City"]</label>
                            <InputText class="form-control" @bind-Value="_profile.City" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["Shared_Country"]</label>
                            <input class="form-control" value="@_profile.CountryDisplay" readonly />
                            <ValidationMessage For="() => _profile.CountryId" class="text-danger small" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["UserInformationPage_WelcomeMessageBio"]</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_profile.WelcomeMessage" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <ActionAlert IsSuccess="_resultSuccess" Message="@_resultMessage" />
                    </div>
                </Body>
                <Footer>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]</button>
                    </div>
                </Footer>
            </CardComponent>
        </EditForm>

        <CardComponent Collapsed="true" ShowFooter="true">
            <Title>@Localizer["UserInformationPage_ChangePasswordTitle"]</Title>
            <Body>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">@Localizer["UserInformationPage_CurrentPassword"]</label>
                        <div class="input-group">
                            <input class="form-control" type="@(_showCurrentPassword ? "text" : "password")" autocomplete="current-password" @bind="_passwordForm.CurrentPassword" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showCurrentPassword = !_showCurrentPassword" title='@Localizer["UserInformationPage_TogglePasswordVisibility"]'>
                                <i class="@(_showCurrentPassword ? AppIcons.EyeSlash : AppIcons.Eye)" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["UserInformationPage_NewPassword"]</label>
                        <div class="input-group">
                            <input class="form-control" type="@(_showNewPassword ? "text" : "password")" autocomplete="new-password" placeholder='@Localizer["UserInformationPage_NewPasswordPlaceholder"]' @bind="_passwordForm.NewPassword" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showNewPassword = !_showNewPassword" title='@Localizer["UserInformationPage_TogglePasswordVisibility"]'>
                                <i class="@(_showNewPassword ? AppIcons.EyeSlash : AppIcons.Eye)" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword" title='@Localizer["UserInformationPage_GeneratePassword"]'>
                                <i class="@AppIcons.Wand" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["UserInformationPage_ConfirmNewPassword"]</label>
                        <div class="input-group">
                            <input class="form-control" type="@(_showConfirmPassword ? "text" : "password")" autocomplete="new-password" @bind="_passwordForm.ConfirmNewPassword" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showConfirmPassword = !_showConfirmPassword" title='@Localizer["UserInformationPage_TogglePasswordVisibility"]'>
                                <i class="@(_showConfirmPassword ? AppIcons.EyeSlash : AppIcons.Eye)" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <ActionAlert IsSuccess="_passwordResultSuccess" Message="@_passwordResultMessage" />
                </div>
            </Body>
            <Footer>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-primary" @onclick="ChangePassword"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]</button>
                </div>
            </Footer>
        </CardComponent>

        <CardComponent IsCollapsable="false">
            <Title>@Localizer["UserInformationPage_GroupMembershipsTitle"]</Title>
            <Body>
                @if (_memberships.Any())
                {
                    @foreach (var membership in _memberships)
                    {
                        <div class="card-list-row">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-semibold">@membership.GroupName</div>
                                <div>@membership.Role</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">@membership.Status</small>
                                <small class="text-muted">@Localizer["UserInformationPage_Requested"]: @membership.RequestedAt.ToString("MMM d, yyyy")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">@Localizer["UserInformationPage_NoMemberships"]</div>
                }
            </Body>
        </CardComponent>
    }
</div>

@code {
    private UserDto? _user;
    private bool _loading = true;
    private int _userId;
    private ToastComponent? _toast;

    private UserProfileFormModel _profile = new();
    private string? _resultMessage;
    private bool _resultSuccess;

    private ChangePasswordFormModel _passwordForm = new();
    private string? _passwordResultMessage;
    private bool _passwordResultSuccess;
    private bool _showCurrentPassword;
    private bool _showNewPassword;
    private bool _showConfirmPassword;

    private List<CountryDto> _countries = new();
    private List<GroupMembershipRow> _memberships = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        _countries = (await CountryService.GetAllAsync()).ToList();
        _user = await UserService.GetByIdAsync(_userId);
        if (_user is not null)
        {
            _profile = BuildProfileForm(_user);
            _memberships = await LoadMembershipsAsync(_user.Id);
        }

        _loading = false;
    }

    private UserProfileFormModel BuildProfileForm(UserDto user)
    {
        var country = _countries.FirstOrDefault(c => c.Id == user.CountryId);
        return new UserProfileFormModel
        {
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            Mobile = user.Mobile ?? string.Empty,
            Birthday = user.Birthday?.ToDateTime(TimeOnly.MinValue),
            Gender = user.Gender.ToString(),
            City = user.City ?? string.Empty,
            CountryId = user.CountryId,
            CountryDisplay = country?.Name ?? string.Empty,
            WelcomeMessage = user.WelcomeMessage ?? string.Empty
        };
    }

    private async Task<List<GroupMembershipRow>> LoadMembershipsAsync(int userId)
    {
        var memberships = await GroupService.GetAllMembershipsForUserAsync(userId);
        var groups = (await GroupService.GetAllAsync()).ToDictionary(g => g.Id, g => g.Name);

        return memberships
            .Select(m => new GroupMembershipRow
            {
                GroupName = groups.TryGetValue(m.GroupId, out var groupName) ? groupName : string.Format(Localizer["UserInformationPage_GroupNumberFallback"].Value, m.GroupId),
                Role = m.Role,
                Status = m.Status,
                RequestedAt = m.RequestedAt
            })
            .OrderBy(m => m.GroupName)
            .ToList();
    }

    private async Task SaveProfile()
    {
        _resultMessage = null;
        if (_user is null)
        {
            return;
        }

        try
        {
            await UserService.UpdateSelfAsync(new UpdateSelfUserDto
            {
                FirstName = _profile.FirstName,
                LastName = _profile.LastName,
                Email = _profile.Email,
                Gender = Enum.Parse<Gender>(_profile.Gender),
                Birthday = _profile.Birthday.HasValue ? DateOnly.FromDateTime(_profile.Birthday.Value) : null,
                Mobile = string.IsNullOrWhiteSpace(_profile.Mobile) ? null : _profile.Mobile,
                City = string.IsNullOrWhiteSpace(_profile.City) ? null : _profile.City,
                CountryId = _profile.CountryId,
                WelcomeMessage = string.IsNullOrWhiteSpace(_profile.WelcomeMessage) ? null : _profile.WelcomeMessage
            });

            _user = await UserService.GetByIdAsync(_userId);
            await ShowToastAsync(Localizer["UserInformationPage_UpdatedSuccess"]);
        }
        catch (Exception ex)
        {
            _resultSuccess = false;
            _resultMessage = string.Format(Localizer["UserInformationPage_UpdateFailed"].Value, ex.Message);
        }
    }

    private void GeneratePassword()
    {
        var password = PasswordGenerator.Generate();
        _passwordForm.NewPassword = password;
        _passwordForm.ConfirmNewPassword = password;
        _showNewPassword = true;
        _passwordResultMessage = null;
    }

    private async Task ChangePassword()
    {
        _passwordResultMessage = null;
        if (_user is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_passwordForm.CurrentPassword))
        {
            _passwordResultSuccess = false;
            _passwordResultMessage = Localizer["UserInformationPage_CurrentPasswordRequired"];
            return;
        }

        if (_passwordForm.NewPassword != _passwordForm.ConfirmNewPassword)
        {
            _passwordResultSuccess = false;
            _passwordResultMessage = Localizer["UserInformationPage_NewPasswordsDoNotMatch"];
            return;
        }

        if (!ValidatePassword(_passwordForm.NewPassword, out var validationErrorKey))
        {
            _passwordResultSuccess = false;
            _passwordResultMessage = Localizer[validationErrorKey];
            return;
        }

        try
        {
            if (!await UserService.ValidatePasswordAsync(_user.Email, _passwordForm.CurrentPassword))
            {
                _passwordResultSuccess = false;
                _passwordResultMessage = Localizer["UserInformationPage_CurrentPasswordIncorrect"];
                return;
            }

            await UserService.ChangePasswordAsync(_userId, _passwordForm.NewPassword);

            _passwordForm = new ChangePasswordFormModel();
            _showCurrentPassword = false;
            _showNewPassword = false;
            _showConfirmPassword = false;
            await ShowToastAsync(Localizer["UserInformationPage_PasswordChangedSuccess"]);
        }
        catch (Exception ex)
        {
            _passwordResultSuccess = false;
            _passwordResultMessage = string.Format(Localizer["UserInformationPage_PasswordChangeFailed"].Value, ex.Message);
        }
    }

    private async Task ShowToastAsync(string message)
    {
        if (_toast is not null)
        {
            await _toast.Show(message);
        }
    }

    private static bool ValidatePassword(string password, out string errorKey)
    {
        errorKey = string.Empty;
        if (password.Length < 8) { errorKey = "UserInformationPage_PasswordValidationMinLength"; return false; }
        if (!password.Any(char.IsUpper)) { errorKey = "UserInformationPage_PasswordValidationUppercase"; return false; }
        if (!password.Any(char.IsLower)) { errorKey = "UserInformationPage_PasswordValidationLowercase"; return false; }
        if (!password.Any(char.IsDigit)) { errorKey = "UserInformationPage_PasswordValidationDigit"; return false; }
        if (!password.Any(c => "!@#$%^&*()-_=+[]{}|;:',.<>?".Contains(c))) { errorKey = "UserInformationPage_PasswordValidationSpecialCharacter"; return false; }
        return true;
    }
}
