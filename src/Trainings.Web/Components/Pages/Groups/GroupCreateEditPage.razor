@page "/groups/new"
@page "/groups/{Slug}/edit"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupAdmin")]

@inject IGroupService GroupService
@inject ILocationService LocationService
@inject ICountryService CountryService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationHelper AuthorizationHelper

<PageTitle>@(_isEdit ? Localizer["GroupCreateEditPage_EditGroup"] : Localizer["GroupCreateEditPage_CreateGroup"])</PageTitle>

<div class="container px-2 px-md-4">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["GroupCreateEditPage_AccessDenied"]</div>
    }
    else
    {
        <PageTitleComponent Icon="@AppIcons.Group" Text="@(_isEdit ? Localizer["GroupCreateEditPage_EditGroup"] : Localizer["GroupCreateEditPage_CreateGroup"])"
                             ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />

        <EditForm Model="_formModel" OnValidSubmit="SaveGroupAsync">
            <DataAnnotationsValidator />
            <CardComponent IsCollapsable="false" ShowFooter="true">
                <Title>@(_isEdit ? Localizer["GroupCreateEditPage_EditGroup"] : Localizer["GroupCreateEditPage_CreateGroup"])</Title>
                <Body>
                    <div class="row g-2">
                        @if (_isEdit)
                        {
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Localizer["GroupCreateEditPage_Name"]</label>
                                <InputText class="form-control" @bind-Value="_formModel.Name" />
                                <ValidationMessage For="() => _formModel.Name" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Localizer["GroupCreateEditPage_Slug"]</label>
                                <InputText class="form-control" @bind-Value="_formModel.Slug" placeholder='@Localizer["GroupCreateEditPage_SlugPlaceholder"]' />
                                <ValidationMessage For="() => _formModel.Slug" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label d-none d-md-block">&nbsp;</label>
                                <div class="form-check mt-md-2">
                                    <InputCheckbox class="form-check-input" @bind-Value="_formModel.IsActive" id="grpActive" />
                                    <label class="form-check-label" for="grpActive">@Localizer["GroupCreateEditPage_Active"]</label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer["GroupCreateEditPage_Name"]</label>
                                <InputText class="form-control" @bind-Value="_formModel.Name" />
                                <ValidationMessage For="() => _formModel.Name" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Localizer["GroupCreateEditPage_Slug"]</label>
                                <InputText class="form-control" @bind-Value="_formModel.Slug" placeholder='@Localizer["GroupCreateEditPage_SlugPlaceholder"]' />
                                <ValidationMessage For="() => _formModel.Slug" class="text-danger small" />
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label">@Localizer["GroupCreateEditPage_Description"]</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_formModel.Description" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["GroupCreateEditPage_Country"]</label>
                            <SelectDropdownComponent TItem="CountryDto" TValue="int?"
                                                     @bind-Value="_formModel.CountryId"
                                                     @bind-Value:after="OnCountryChanged"
                                                     Items="_countries"
                                                     ValueSelector="c => (int?)c.Id"
                                                     TextSelector="@(c => c.Name)" />
                            <ValidationMessage For="() => _formModel.CountryId" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["GroupCreateEditPage_Location"]</label>
                            <SelectDropdownComponent TItem="LocationDto" TValue="int?"
                                                     @bind-Value="_formModel.LocationId"
                                                     Items="FilteredLocations"
                                                     ValueSelector="l => (int?)l.Id"
                                                     TextSelector="@(l => l.Name)"
                                                     SubTextSelector="@(l => l.CityName)" />
                            <ValidationMessage For="() => _formModel.LocationId" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["GroupCreateEditPage_MaxParticipants"]</label>
                            <InputNumber class="form-control" @bind-Value="_formModel.MaxParticipants" />
                            <ValidationMessage For="() => _formModel.MaxParticipants" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["GroupCreateEditPage_Weekday"]</label>
                            <SelectDropdownComponent TItem="DayOfWeek" TValue="DayOfWeek?"
                                                     @bind-Value="_formModel.Weekday"
                                                     @bind-Value:after="CalculateGroupEndTime"
                                                     Items="_weekdays"
                                                     ValueSelector="d => (DayOfWeek?)d"
                                                     TextSelector="@GetWeekdayLabel"
                                                     PlaceholderText="@Localizer["GroupCreateEditPage_SelectDay"]" />
                            <ValidationMessage For="() => _formModel.Weekday" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["GroupCreateEditPage_Start"]</label>
                            <input class="form-control" type="time" @bind="_formModel.StartTime" @bind:after="CalculateGroupEndTime" />
                            <ValidationMessage For="() => _formModel.StartTime" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["GroupCreateEditPage_DurationMinutes"]</label>
                            <InputNumber class="form-control" @bind-Value="_formModel.DurationMinutes" @bind-Value:after="CalculateGroupEndTime" />
                            <ValidationMessage For="() => _formModel.DurationMinutes" class="text-danger small" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["GroupCreateEditPage_End"]</label>
                            <input class="form-control" type="time" value="@_formEndTime" readonly />
                        </div>
                    </div>
                </Body>
                <Footer>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary" disabled="@_saving"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]</button>
                        <button type="button" class="btn btn-secondary" @onclick="GoBack"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]</button>
                    </div>
                </Footer>
            </CardComponent>
        </EditForm>
        <div class="mt-2">
            <ActionAlert IsSuccess="false" Message="@_formError" />
        </div>
    }
</div>

@code {
    [Parameter] public string? Slug { get; set; }

    private List<LocationDto> _locations = new();
    private List<CountryDto> _countries = new();
    private readonly List<DayOfWeek> _weekdays = Enum.GetValues<DayOfWeek>().ToList();
    private List<int> _allowedLocationIds = new();
    private bool _loading = true;
    private bool _saving;
    private bool _isAccessDenied;
    private string _formEndTime = "20:30";
    private string? _formError;
    private GroupFormModel _formModel = new();
    private int _groupId;

    private bool _isEdit => !string.IsNullOrEmpty(Slug);

    private List<LocationDto> FilteredLocations => _formModel.CountryId is null
        ? new List<LocationDto>()
        : _locations.Where(l => l.CountryId == _formModel.CountryId).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (_isEdit)
        {
            var group = await GroupService.GetBySlugAsync(Slug!);
            if (group is null)
            {
                _formError = Localizer["GroupCreateEditPage_GroupNotFound"];
                _loading = false;
                return;
            }

            _groupId = group.Id;

            if (!AuthorizationHelper.IsGroupAdmin(authState.User, _groupId))
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            _locations = (await LocationService.GetAllAsync())
                .Where(l => l.IsActive && !l.IsSystemWide)
                .OrderBy(l => l.Name)
                .ToList();
            _countries = (await CountryService.GetAllAsync()).ToList();

            LoadForEdit(group);
        }
        else
        {
            if (!AuthorizationHelper.IsSuperAdmin(authState.User))
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            _locations = (await LocationService.GetAllAsync())
                .Where(l => l.IsActive && !l.IsSystemWide)
                .OrderBy(l => l.Name)
                .ToList();
            _countries = (await CountryService.GetAllAsync()).ToList();

            _formModel.CountryId = await GetCurrentUserCountryIdAsync();
            CalculateGroupEndTime();
        }

        _loading = false;
    }

    private async Task<int?> GetCurrentUserCountryIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (userId <= 0)
        {
            return null;
        }

        var user = await UserService.GetByIdAsync(userId);
        return user?.CountryId;
    }

    private void OnCountryChanged()
    {
        if (_formModel.LocationId is not null && !FilteredLocations.Any(l => l.Id == _formModel.LocationId))
        {
            _formModel.LocationId = null;
        }
    }

    private void LoadForEdit(GroupDto group)
    {
        _formModel = new GroupFormModel
        {
            Name = group.Name,
            Slug = group.Slug,
            Description = group.Description ?? string.Empty,
            IsActive = group.IsActive,
            Weekday = group.Weekday,
            LocationId = group.LocationId,
            StartTime = group.StartTime ?? new TimeOnly(19, 0),
            DurationMinutes = group.DurationMinutes ?? 90,
            CountryId = group.CountryId,
            MaxParticipants = group.MaxParticipants
        };
        _allowedLocationIds = group.AllowedLocationIds;
        CalculateGroupEndTime();
    }

    private void CalculateGroupEndTime()
    {
        var duration = _formModel.DurationMinutes.GetValueOrDefault(0);
        if (duration <= 0)
        {
            duration = 1;
        }

        var start = _formModel.StartTime ?? new TimeOnly(19, 0);
        _formEndTime = start.AddMinutes(duration).ToString("HH:mm");
    }

    private static string GetWeekdayLabel(DayOfWeek day) => CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName(day);

    private void GoBack() => NavigationManager.NavigateTo(_isEdit ? $"/groups/{_formModel.Slug}" : "/groups");

    private async Task SaveGroupAsync()
    {
        _saving = true;
        _formError = null;

        try
        {
            GroupDto savedGroup;
            if (!_isEdit)
            {
                savedGroup = await GroupService.CreateAsync(new CreateGroupDto
                {
                    Name = _formModel.Name,
                    Slug = string.IsNullOrWhiteSpace(_formModel.Slug) ? null : _formModel.Slug,
                    Description = string.IsNullOrWhiteSpace(_formModel.Description) ? null : _formModel.Description,
                    Weekday = _formModel.Weekday,
                    LocationId = _formModel.LocationId,
                    StartTime = _formModel.StartTime,
                    DurationMinutes = _formModel.DurationMinutes,
                    MaxParticipants = _formModel.MaxParticipants,
                    CountryId = _formModel.CountryId,
                    AllowedLocationIds = []
                });
            }
            else
            {
                await GroupService.UpdateAsync(new UpdateGroupDto
                {
                    Id = _groupId,
                    Name = _formModel.Name,
                    Slug = string.IsNullOrWhiteSpace(_formModel.Slug) ? null : _formModel.Slug,
                    Description = string.IsNullOrWhiteSpace(_formModel.Description) ? null : _formModel.Description,
                    Weekday = _formModel.Weekday,
                    LocationId = _formModel.LocationId,
                    StartTime = _formModel.StartTime,
                    DurationMinutes = _formModel.DurationMinutes,
                    MaxParticipants = _formModel.MaxParticipants,
                    CountryId = _formModel.CountryId,
                    AllowedLocationIds = _allowedLocationIds,
                    IsActive = _formModel.IsActive
                });
                savedGroup = (await GroupService.GetByIdAsync(_groupId))!;
            }

            NavigationManager.NavigateTo($"/groups/{savedGroup.Slug}");
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
