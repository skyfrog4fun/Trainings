@page "/groups/{Slug}/members"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupAdmin")]

@inject IGroupService GroupService
@inject IUserService UserService

@using Trainings.Domain.Enums

<PageTitle>@Localizer["GroupMembersPage_PageTitle"]</PageTitle>

<div class="container px-2 px-md-4">
    <div class="my-3">
        <a href="/groups" class="btn btn-sm btn-outline-secondary"><i class="@AppIcons.Back me-1" aria-hidden="true"></i>@Localizer["GroupMembersPage_Back"]</a>
    </div>

    @if (_group != null)
    {
        <h2>@string.Format(Localizer["GroupMembersPage_MembersOfGroup"].Value, _group.Name)</h2>
        <p class="text-muted">@_group.Description</p>
    }

    @if (_showAddForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h6>@Localizer["GroupMembersPage_AddMemberTitle"]</h6>
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <select class="form-select" @bind="_addUserId">
                            <option value="0">@Localizer["GroupMembersPage_SelectUser"]</option>
                            @foreach (var user in _allUsers)
                            {
                                <option value="@user.Id">@user.DisplayName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <select class="form-select" @bind="_addRole">
                            <option value="Participant">@Localizer["GroupMembersPage_RoleParticipant"]</option>
                            <option value="Trainer">@Localizer["GroupMembersPage_RoleTrainer"]</option>
                            <option value="Admin">@Localizer["GroupMembersPage_RoleAdmin"]</option>
                        </select>
                    </div>
                </div>
                <div class="mt-2">
                    <button class="btn btn-primary btn-sm me-2" @onclick="AddMember">@Localizer["GroupMembersPage_AddButton"]</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _showAddForm = false">@Localizer["GroupMembersPage_CancelButton"]</button>
                </div>
                @if (_addError != null) { <div class="alert alert-danger mt-2 small">@_addError</div> }
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>@string.Format(Localizer["GroupMembersPage_MembersHeading"].Value, _approvedMembers.Count)</h5>
        <button class="btn btn-success btn-sm" @onclick="() => _showAddForm = true"><i class="@AppIcons.Plus me-1" aria-hidden="true"></i>@Localizer["GroupMembersPage_AddMemberTitle"]</button>
    </div>

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (_pendingMembers.Any())
        {
            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning text-dark fw-bold"><i class="@AppIcons.CircleInfo me-2" aria-hidden="true"></i>@string.Format(Localizer["GroupMembersPage_PendingRequests"].Value, _pendingMembers.Count)</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>@Localizer["GroupMembersPage_ColName"]</th><th>@Localizer["GroupMembersPage_ColEmail"]</th><th>@Localizer["GroupMembersPage_ColRole"]</th><th>@Localizer["GroupMembersPage_ColRequested"]</th><th>@Localizer["GroupMembersPage_ColActions"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _pendingMembers)
                            {
                                <tr>
                                    <td>@m.UserDisplayName</td>
                                    <td class="text-muted small">@m.UserEmail</td>
                                    <td><span class="badge bg-secondary">@m.Role</span></td>
                                    <td class="small">@m.RequestedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveMember(m)"><i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["GroupMembersPage_ApproveButton"]</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeclineMember(m)"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["GroupMembersPage_DeclineButton"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_adminMembers.Any())
        {
            <div class="card mb-3 border-primary">
                <div class="card-header bg-primary text-white fw-bold"><i class="@AppIcons.Users me-2" aria-hidden="true"></i>@string.Format(Localizer["GroupMembersPage_Admins"].Value, _adminMembers.Count)</div>
                @RenderMemberTable(_adminMembers)
            </div>
        }

        @if (_trainerMembers.Any())
        {
            <div class="card mb-3 border-info">
                <div class="card-header bg-info text-dark fw-bold"><i class="@AppIcons.UserCheck me-2" aria-hidden="true"></i>@string.Format(Localizer["GroupMembersPage_Trainers"].Value, _trainerMembers.Count)</div>
                @RenderMemberTable(_trainerMembers)
            </div>
        }

        @if (_participantMembers.Any())
        {
            <div class="card mb-3">
                <div class="card-header fw-bold"><i class="@AppIcons.Users me-2" aria-hidden="true"></i>@string.Format(Localizer["GroupMembersPage_Participants"].Value, _participantMembers.Count)</div>
                @RenderMemberTable(_participantMembers)
            </div>
        }

        @if (!_approvedMembers.Any() && !_pendingMembers.Any())
        {
            <div class="alert alert-info">@Localizer["GroupMembersPage_NoMembers"]</div>
        }
    }

    @if (_actionResult != null)
    {
        <div class="alert @_actionAlertClass mt-2">@_actionResult</div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private GroupDto? _group;
    private List<GroupMembershipDto> _allMembers = new();
    private List<GroupMembershipDto> _pendingMembers = new();
    private List<GroupMembershipDto> _approvedMembers = new();
    private List<GroupMembershipDto> _adminMembers = new();
    private List<GroupMembershipDto> _trainerMembers = new();
    private List<GroupMembershipDto> _participantMembers = new();
    private List<UserDto> _allUsers = new();
    private bool _loading = true, _showAddForm;
    private int _addUserId;
    private string _addRole = "Participant";
    private string? _addError;
    private string _actionAlertClass = "alert-success";
    private string? _actionResult;

    protected override async Task OnInitializedAsync()
    {
        _group = await GroupService.GetBySlugAsync(Slug);
        if (_group == null)
        {
            NavigationManager.NavigateTo("/groups");
            return;
        }
        _allUsers = (await UserService.GetAllAsync()).Where(u => u.IsActive).ToList();
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        _loading = true;
        _allMembers = (await GroupService.GetMembersAsync(_group!.Id)).ToList();
        _pendingMembers = _allMembers.Where(m => m.Status == GroupMembershipStatus.Pending).ToList();
        _approvedMembers = _allMembers.Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive).ToList();
        _adminMembers = _approvedMembers.Where(m => m.Role == GroupMemberRole.Admin).ToList();
        _trainerMembers = _approvedMembers.Where(m => m.Role == GroupMemberRole.Trainer).ToList();
        _participantMembers = _approvedMembers.Where(m => m.Role == GroupMemberRole.Participant).ToList();
        _loading = false;
    }

    private RenderFragment RenderMemberTable(List<GroupMembershipDto> members) => __builder =>
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>@Localizer["GroupMembersPage_ColName"]</th><th>@Localizer["GroupMembersPage_ColEmail"]</th><th>@Localizer["GroupMembersPage_ColActive"]</th><th>@Localizer["GroupMembersPage_ColJoined"]</th><th>@Localizer["GroupMembersPage_ColActions"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in members)
                    {
                        <tr>
                            <td>@m.UserDisplayName</td>
                            <td class="text-muted small">@m.UserEmail</td>
                            <td>
                                @if (m.IsActive)
                                {
                                    <i class="@AppIcons.Check text-success" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="@AppIcons.XMark text-danger" aria-hidden="true"></i>
                                }
                            </td>
                            <td class="small">@m.JoinedAt.ToString("dd.MM.yyyy")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMember(m)"><i class="@AppIcons.UserMinus me-1" aria-hidden="true"></i>@Localizer["GroupMembersPage_RemoveButton"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private async Task AddMember()
    {
        _addError = null;
        if (_addUserId == 0)
        {
            _addError = Localizer["GroupMembersPage_SelectUserError"];
            return;
        }
        try
        {
            await GroupService.AddMemberAsync(new AddGroupMemberDto
            {
                GroupId = _group!.Id,
                UserId = _addUserId,
                Role = Enum.Parse<GroupMemberRole>(_addRole)
            });
            _showAddForm = false;
            _addUserId = 0;
            await LoadMembers();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
    }

    private async Task ApproveMember(GroupMembershipDto m)
    {
        _actionResult = null;
        try
        {
            await GroupService.ApproveMemberAsync(m.Id);
            _actionAlertClass = "alert-success";
            _actionResult = string.Format(Localizer["GroupMembersPage_ApprovedMessage"].Value, m.UserDisplayName);
            await LoadMembers();
        }
        catch (Exception ex)
        {
            _actionAlertClass = "alert-danger";
            _actionResult = string.Format(Localizer["GroupMembersPage_FailedMessage"].Value, ex.Message);
        }
    }

    private async Task DeclineMember(GroupMembershipDto m)
    {
        _actionResult = null;
        try
        {
            await GroupService.DeclineMemberAsync(m.Id);
            _actionAlertClass = "alert-info";
            _actionResult = string.Format(Localizer["GroupMembersPage_DeclinedMessage"].Value, m.UserDisplayName);
            await LoadMembers();
        }
        catch (Exception ex)
        {
            _actionAlertClass = "alert-danger";
            _actionResult = string.Format(Localizer["GroupMembersPage_FailedMessage"].Value, ex.Message);
        }
    }

    private async Task RemoveMember(GroupMembershipDto m)
    {
        await GroupService.RemoveMemberAsync(m.Id);
        await LoadMembers();
    }
}
