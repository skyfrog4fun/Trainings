@page "/groups"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupAdmin")]

@inject IGroupService GroupService
@inject ILocationService LocationService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationHelper AuthorizationHelper

<PageTitle>@Localizer["Shared_Groups"]</PageTitle>

<div class="container px-2 px-md-4">
    <PageTitleComponent Icon="@AppIcons.Group" Text="@Localizer["Shared_Groups"]"
                        ButtonText="@(_isSuperAdmin ? Localizer["Shared_Add"].Value : null)" ButtonIcon="@AppIcons.Plus" OnButtonClick="GoToCreateGroup"
                        ShowFilterButton="true" OnApplyFilters="ApplyFilters" OnClearFilters="ClearFilters">
        <Filter>
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-3">
                    <SelectDropdownComponent TItem="(string Value, string Label)" TValue="string"
                                             @bind-Value="_pendingStatus"
                                             Items="_statusOptions"
                                             ValueSelector="o => o.Value"
                                             TextSelector="@(o => Localizer[o.Label].Value)" />
                </div>
                <div class="col-12 col-md-3">
                    <SelectDropdownComponent TItem="CountryDto" TValue="int?"
                                             @bind-Value="_pendingCountryId"
                                             Items="_countries"
                                             ValueSelector="c => (int?)c.Id"
                                             TextSelector="@(c => c.Name)"
                                             PlaceholderText="@Localizer["GroupsPage_AllCountries"]" />
                </div>
                <div class="col-12 col-md-3">
                    <SelectDropdownComponent TItem="LocationDto" TValue="int?"
                                             @bind-Value="_pendingLocationId"
                                             Items="_locations"
                                             ValueSelector="l => (int?)l.Id"
                                             TextSelector="@(l => l.Name)"
                                             SubTextSelector="@(l => l.CityName)"
                                             PlaceholderText="@Localizer["GroupsPage_AllLocations"]" />
                </div>
                <div class="col-12 col-md-3">
                    <SelectDropdownComponent TItem="DayOfWeek" TValue="DayOfWeek?"
                                             @bind-Value="_pendingWeekday"
                                             Items="_availableWeekdays"
                                             ValueSelector="d => (DayOfWeek?)d"
                                             TextSelector="@GetWeekdayLabel"
                                             PlaceholderText="@Localizer["GroupsPage_AllDays"]" />
                </div>
            </div>
        </Filter>
    </PageTitleComponent>

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (FilteredGroups.Count == 0)
    {
        <div class="alert alert-info">@Localizer["GroupsPage_NoGroupsYet"]</div>
    }
    else
    {
        <div class="app-overview-grid">
            @foreach (var group in FilteredGroups)
            {
                <a href="/groups/@group.Slug" class="app-overview-card app-overview-card-stacked app-overview-card-link text-decoration-none text-reset">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="app-overview-title text-break">@group.Name</div>
                        <BadgeStatusComponent IsActive="group.IsActive" />
                    </div>
                    <div class="app-overview-meta app-overview-description text-break">@(string.IsNullOrWhiteSpace(group.Description) ? "-" : group.Description)</div>
                    <div class="app-overview-meta mt-auto d-flex justify-content-between align-items-center gap-2">
                        <span class="text-truncate">@FormatScheduleSummary(group)</span>
                        <span class="text-nowrap"><i class="@AppIcons.Participants me-1" aria-hidden="true"></i>@group.MemberCount</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<GroupDto> _groups = new();
    private List<CountryDto> _countries = new();
    private List<LocationDto> _locations = new();
    private List<DayOfWeek> _availableWeekdays = new();
    private bool _loading = true;
    private bool _isSuperAdmin;

    private readonly List<(string Value, string Label)> _statusOptions = new()
    {
        ("", "GroupsPage_AllStatuses"),
        ("Active", "Shared_Active"),
        ("Inactive", "GroupsPage_Inactive")
    };

    private string _pendingStatus = string.Empty;
    private int? _pendingCountryId;
    private int? _pendingLocationId;
    private DayOfWeek? _pendingWeekday;
    private string _appliedStatus = string.Empty;
    private int? _appliedCountryId;
    private int? _appliedLocationId;
    private DayOfWeek? _appliedWeekday;

    private List<GroupDto> FilteredGroups
    {
        get
        {
            IEnumerable<GroupDto> query = _groups;

            if (!string.IsNullOrEmpty(_appliedStatus))
            {
                var wantActive = _appliedStatus == "Active";
                query = query.Where(g => g.IsActive == wantActive);
            }

            if (_appliedCountryId is not null)
            {
                query = query.Where(g => g.CountryId == _appliedCountryId);
            }

            if (_appliedLocationId is not null)
            {
                query = query.Where(g => g.LocationId == _appliedLocationId);
            }

            if (_appliedWeekday is not null)
            {
                query = query.Where(g => g.Weekday == _appliedWeekday);
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isSuperAdmin = AuthorizationHelper.IsSuperAdmin(authState.User);

        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        _loading = true;
        _groups = (await GroupService.GetAllAsync()).OrderBy(g => g.Name).ToList();
        _countries = (await CountryService.GetAllAsync()).ToList();
        _locations = (await LocationService.GetAllAsync()).Where(l => l.IsActive && !l.IsSystemWide).OrderBy(l => l.Name).ToList();
        _availableWeekdays = _groups
            .Where(g => g.Weekday.HasValue)
            .Select(g => g.Weekday!.Value)
            .Distinct()
            .OrderBy(d => ((int)d + 6) % 7)
            .ToList();
        _loading = false;
    }

    private static string GetWeekdayLabel(DayOfWeek day) => CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName(day);

    private static string FormatScheduleSummary(GroupDto group)
    {
        var weekday = group.Weekday.HasValue ? GetWeekdayLabel(group.Weekday.Value) : null;
        var location = string.IsNullOrWhiteSpace(group.LocationName) ? null : group.LocationName;

        return (weekday, location) switch
        {
            (not null, not null) => $"{weekday} | {location}",
            (not null, null) => weekday,
            (null, not null) => location,
            _ => "-"
        };
    }

    private void GoToCreateGroup() => NavigationManager.NavigateTo("/groups/new");

    private void ApplyFilters()
    {
        _appliedStatus = _pendingStatus;
        _appliedCountryId = _pendingCountryId;
        _appliedLocationId = _pendingLocationId;
        _appliedWeekday = _pendingWeekday;
    }

    private void ClearFilters()
    {
        _pendingStatus = string.Empty;
        _pendingCountryId = null;
        _pendingLocationId = null;
        _pendingWeekday = null;
        _appliedStatus = string.Empty;
        _appliedCountryId = null;
        _appliedLocationId = null;
        _appliedWeekday = null;
    }
}
