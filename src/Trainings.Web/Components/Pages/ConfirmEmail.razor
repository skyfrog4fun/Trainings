@page "/confirm-email"

@rendermode InteractiveServer

@inject IUserRegistrationService UserRegistrationService
@inject IAppRuntimeModeService AppRuntimeModeService

<PageTitle>Confirm Email</PageTitle>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4 text-center">
                    @if (_loading)
                    {
                        <LoadingSpinner ContainerClass="" SpinnerClass="text-primary mb-3" />
                        <p>Confirming your email...</p>
                    }
                    else if (_success)
                    {
                        <div class="text-success mb-3 icon-display"><i class="@AppIcons.Check" aria-hidden="true"></i></div>
                        <h5>Registration successful</h5>
                        <p class="text-muted mb-2">Your email address was confirmed successfully.</p>
                        <p class="text-muted">Your registration is now being reviewed by the Super Admin. You will be notified by email as soon as the review is complete.</p>
                        <a href="/login" class="btn btn-primary w-100">Back to Login</a>
                    }
                    else
                    {
                        <div class="text-danger mb-3 icon-display"><i class="@AppIcons.XMark" aria-hidden="true"></i></div>
                        <h5>Confirmation Failed</h5>
                        <p class="text-muted">@_message</p>

                        @if (_canResend)
                        {
                            <button class="btn btn-primary w-100 mb-2" @onclick="ResendAsync" disabled="@(_resending || _runtimeMode.IsReadOnly)">
                                @if (_resending)
                                {
                                    <LoadingSpinner Inline="true" Small="true" SpinnerClass="me-1" />
                                }
                                Send New Verification Mail
                            </button>
                            @if (_runtimeMode.IsReadOnly)
                            {
                                <div class="small text-muted mb-2">Read Only mode is active, so a replacement verification mail cannot be created right now.</div>
                            }
                        }

                        <a href="/login" class="btn btn-outline-primary w-100">Back to Login</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<EmailPreviewModal Preview="_emailPreview" OnClose="CloseEmailPreview" />

@code {
    private AppRuntimeModeDto _runtimeMode = new();
    private bool _loading = true;
    private bool _success;
    private bool _canResend;
    private bool _resending;
    private int? _userId;
    private string _message = string.Empty;
    private EmailPreviewDto? _emailPreview;

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var token = query.TryGetValue("token", out var t) ? t.ToString() : string.Empty;

        if (string.IsNullOrEmpty(token))
        {
            _message = "Invalid or missing confirmation token.";
            _loading = false;
            return;
        }

        try
        {
            var result = await UserRegistrationService.ConfirmEmailAsync(token);
            _success = result.IsSuccess;
            _message = result.Message;
            _canResend = result.IsExpired && result.UserId.HasValue;
            _userId = result.UserId;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResendAsync()
    {
        if (!_userId.HasValue)
        {
            return;
        }

        _resending = true;
        try
        {
            var result = await UserRegistrationService.ResendEmailConfirmationAsync(_userId.Value);
            _message = result.Preview is null
                ? "A new verification mail has been sent."
                : "No E-Mail mode is active. Review the preview below and use the new verification link.";
            _emailPreview = result.Preview;
            _canResend = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _resending = false;
        }
    }

    private Task CloseEmailPreview()
    {
        _emailPreview = null;
        return Task.CompletedTask;
    }
}
