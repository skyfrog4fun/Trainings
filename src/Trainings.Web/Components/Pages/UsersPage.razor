@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupAdmin")]
@inject IUserService UserService
@inject IUserRegistrationService UserRegistrationService
@inject IRegistrationService RegistrationService
@inject IGroupService GroupService
@inject ICountryService CountryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAppRuntimeModeService AppRuntimeModeService
@inject IDateTimeFormatService DateTimeFormatService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["Users"]</PageTitle>

<div class="container px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2>@Localizer["Users"]</h2>
        <button class="btn btn-app-primary" @onclick="ShowCreateForm" disabled="@IsWriteBlocked"><i class="@AppIcons.Plus me-1" aria-hidden="true"></i>@Localizer["Add"]</button>
    </div>

    @if (IsWriteBlocked)
    {
        <div class="alert alert-warning">
            @Localizer["ReadOnlyModeSuperAdminOnly"]
        </div>
    }

    @if (_showForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@(_editUserId == 0 ? Localizer["CreateUser"] : Localizer["EditUser"])</h5>
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["FirstNameRequired"]</label>
                        <input class="form-control" placeholder='@Localizer["FirstName"]' @bind="_formFirstName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["LastNameRequired"]</label>
                        <input class="form-control" placeholder='@Localizer["LastName"]' @bind="_formLastName" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["EmailRequired"]</label>
                        <input class="form-control" type="email" placeholder='@Localizer["Email"]' @bind="_formEmail" />
                    </div>
                    @if (_editUserId == 0)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["PasswordRequired"]</label>
                            <input class="form-control" type="password" placeholder='@Localizer["Password"]' @bind="_formPassword" />
                        </div>
                    }
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer["Role"]</label>
                        <AuthorizeView Policy="SuperAdmin">
                            <Authorized>
                                <select class="form-select" @bind="_formRole">
                                    <option value="User">@Localizer["User"]</option>
                                    <option value="SuperAdmin">@Localizer["SuperAdmin"]</option>
                                </select>
                            </Authorized>
                            <NotAuthorized>
                                <select class="form-select" @bind="_formRole">
                                    <option value="User">@Localizer["User"]</option>
                                </select>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer["Gender"]</label>
                        <select class="form-select" @bind="_formGender">
                            <option value="Male">@Localizer["Male"]</option>
                            <option value="Female">@Localizer["Female"]</option>
                            <option value="Other">@Localizer["Other"]</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer["Birthday"]</label>
                        <input class="form-control" type="date" @bind="_formBirthday" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["Mobile"]</label>
                        <input class="form-control" placeholder="+41 79 000 0000" @bind="_formMobile" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["City"]</label>
                        <input class="form-control" placeholder='@Localizer["City"]' @bind="_formCity" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["Country"]</label>
                        <select class="form-select" @bind="_formCountryId">
                            <option value="">@Localizer["SelectCountry"]</option>
                            @foreach (var country in _countries)
                            {
                                <option value="@country.Id">@country.Code — @country.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@(_isSuperAdmin ? Localizer["Groups"] : Localizer["ManagedGroupsRequired"])</label>
                        @if (_availableGroups.Any())
                        {
                            <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                @foreach (var group in _availableGroups)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="user-group-@group.Id"
                                               checked="@_selectedGroupIds.Contains(group.Id)"
                                               @onchange="e => ToggleGroup(group.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label" for="user-group-@group.Id">@group.Name</label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="form-text text-muted">@Localizer["NoGroupsAvailableForAssignment"]</div>
                        }
                    </div>
                    @if (_editUserId != 0)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["EntryDate"]</label>
                            <input class="form-control" type="date" @bind="_formEntryDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["WelcomeMessageBio"]</label>
                            <textarea class="form-control" rows="2" @bind="_formWelcomeMessage" placeholder='@Localizer["BioOrWelcomeMessage"]'></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Localizer["SetNewPasswordLeaveBlank"]</label>
                            <div class="input-group">
                                <input class="form-control" type="password" placeholder='@Localizer["NewPasswordMinChars"]' @bind="_formNewPassword" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword" title='@Localizer["GeneratePassword"]'>
                                    <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(_passwordValidationError))
                            {
                                <div class="text-danger small mt-1">@_passwordValidationError</div>
                            }
                        </div>
                    }
                </div>
                <div class="mt-3 d-flex flex-wrap gap-2 justify-content-between align-items-start">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" @onclick="SaveUser" disabled="@IsWriteBlocked">@Localizer["Save"]</button>
                        <button class="btn btn-secondary" @onclick="CancelForm"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Cancel"]</button>
                    </div>
                    @if (_editUserId != 0)
                    {
                        var editedUser = _users.FirstOrDefault(u => u.Id == _editUserId);
                        if (editedUser is not null)
                        {
                            <div class="d-flex flex-wrap gap-2 ms-md-auto">
                                <button type="button" class="btn btn-outline-secondary"
                                        title='@Localizer["SendVerificationMail"]'
                                        @onclick="() => SendAccountMail(editedUser)"
                                        disabled="@IsWriteBlocked || IsUserBusy(editedUser.Id)">
                                    @if (IsUserBusy(editedUser.Id))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    <i class="@AppIcons.Envelope me-1" aria-hidden="true"></i>@Localizer["VerifyMail"]
                                </button>
                                @if (CanDeleteUser(editedUser.Id))
                                {
                                    <button type="button" class="btn btn-outline-danger"
                                            title='@Localizer["DeleteUser"]'
                                            @onclick="() => DeleteUserAsync(editedUser)"
                                            disabled="@IsWriteBlocked">
                                        <i class="@AppIcons.Trash me-1" aria-hidden="true"></i>@Localizer["DeleteUser"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn @(editedUser.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            title='@(editedUser.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])'
                                            @onclick="() => ToggleActive(editedUser)"
                                            disabled="@IsWriteBlocked">
                                        <i class="@(editedUser.IsActive ? AppIcons.UserSlash : AppIcons.UserCheck) me-1" aria-hidden="true"></i>@(editedUser.IsActive ? Localizer["DeactivateUser"] : Localizer["ActivateUser"])
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
                @if (_formError != null) { <div class="alert alert-danger mt-2">@_formError</div> }
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else
    {
        @if (_pendingUsers.Any())
        {
            <div class="card mb-4 border-warning">
                <div class="card-header bg-warning text-dark fw-bold">
                    @Localizer["PendingApprovals", _pendingUsers.Count]
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th></th><th>@Localizer["Name"]</th><th>@Localizer["RequestedGroup"]</th><th>@Localizer["RegistrationDate"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _pendingUsers)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title='@Localizer["ToggleDetails"]' @onclick="() => TogglePendingExpand(user.Id)">
                                            <i class="@(_expandedPendingUserIds.Contains(user.Id) ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                    <td>@user.DisplayName</td>
                                    <td>@FormatPendingGroups(user.Id)</td>
                                    <td>@user.CreationDate.ToString("MMM d, yyyy")</td>
                                </tr>
                                @if (_expandedPendingUserIds.Contains(user.Id))
                                {
                                    <tr class="table-light">
                                        <td colspan="4">
                                            <div class="row g-2">
                                                <div class="col-12 col-md-6"><strong>@Localizer["Email"]:</strong> @user.Email</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Country"]:</strong> @(GetCountryLabel(user.CountryId))</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["City"]:</strong> @(string.IsNullOrWhiteSpace(user.City) ? "—" : user.City)</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Mobile"]:</strong> @(string.IsNullOrWhiteSpace(user.Mobile) ? "—" : user.Mobile)</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["Gender"]:</strong> @user.Gender</div>
                                                <div class="col-12 col-md-6"><strong>@Localizer["EmailVerified"]:</strong> @(user.EmailConfirmedAt.HasValue ? Localizer["Yes"] : Localizer["No"])</div>
                                                <div class="col-12 text-end">
                                                    <button type="button" class="btn btn-sm btn-success me-1" @onclick="() => ApproveUser(user)" disabled="@IsWriteBlocked">
                                                        <i class="@AppIcons.Check" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => RejectUser(user)" disabled="@IsWriteBlocked">
                                                        <i class="@AppIcons.XMark" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="app-overview-grid">
            @foreach (var user in _users)
            {
                <div class="app-overview-card">
                    <div class="app-overview-main">
                        <div class="app-overview-title text-break">@user.DisplayName</div>
                        <div class="app-overview-meta text-break">@user.Email</div>
                        <div class="app-overview-meta mt-1">@GetDisplayRole(user)</div>
                        <div class="app-overview-meta mt-1">@FormatApprovedGroups(user.Id)</div>
                        <div class="app-overview-meta mt-1">
                            <span class="me-3">@Localizer["EmailVerified"]: @(user.EmailConfirmedAt.HasValue ? Localizer["Yes"] : Localizer["No"])</span>
                            <span>@Localizer["Active"]: @(user.IsActive ? Localizer["Yes"] : Localizer["No"])</span>
                        </div>
                    </div>
                    <div class="app-overview-actions">
                        <button type="button" class="btn btn-sm btn-app-icon btn-app-outline-primary" title='@Localizer["View"]' aria-label='@Localizer["View"]'
                                @onclick="() => EditUser(user)" disabled="@IsWriteBlocked">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-app-icon btn-app-outline-secondary" title='@Localizer["Edit"]' aria-label='@Localizer["Edit"]'
                                @onclick="() => EditUser(user)" disabled="@IsWriteBlocked">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-app-icon btn-app-outline" title='@Localizer["SendAccountMail"]' aria-label='@Localizer["SendAccountMail"]'
                                @onclick="() => SendAccountMail(user)"
                                disabled="@IsWriteBlocked || IsUserBusy(user.Id)">
                            @if (IsUserBusy(user.Id))
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            else
                            {
                                <i class="@AppIcons.Envelope" aria-hidden="true"></i>
                            }
                        </button>
                        @if (CanDeleteUser(user.Id))
                        {
                            <button type="button" class="btn btn-sm btn-app-icon btn-app-outline-danger" title='@Localizer["DeleteUser"]' aria-label='@Localizer["DeleteUser"]'
                                    @onclick="() => DeleteUserAsync(user)"
                                    disabled="@IsWriteBlocked">
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-app-icon btn-app-outline-secondary"
                                    title='@(user.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])'
                                    aria-label='@(user.IsActive ? Localizer["Deactivate"] : Localizer["Activate"])'
                                    @onclick="() => ToggleActive(user)"
                                    disabled="@IsWriteBlocked">
                                <i class="@(user.IsActive ? AppIcons.UserSlash : AppIcons.UserCheck)" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_actionResult != null)
        {
            <div class="alert @(_actionSuccess ? "alert-success" : "alert-danger") mt-2">@_actionResult</div>
        }
    }
</div>

<EmailPreviewModal Preview="_emailPreview" OnClose="CloseEmailPreview" />

@code {
    private List<UserDto> _users = new();
    private List<UserDto> _pendingUsers = new();
    private Dictionary<int, List<GroupMembershipDto>> _membershipsByUser = new();
    private List<GroupDto> _availableGroups = new();
    private List<CountryDto> _countries = new();
    private readonly Dictionary<int, bool> _hasRegistrationHistoryByUser = new();
    private readonly HashSet<int> _expandedPendingUserIds = new();
    private HashSet<int> _managedGroupIds = new();
    private HashSet<int> _selectedGroupIds = new();
    private AppRuntimeModeDto _runtimeMode = new();
    private bool _isSuperAdmin;
    private bool _loading = true;
    private bool _showForm;
    private int _editUserId;
    private int? _busyUserId;
    private string _formFirstName = string.Empty;
    private string _formLastName = string.Empty;
    private string _formEmail = string.Empty;
    private string _formPassword = string.Empty;
    private string _formRole = "User";
    private string _formGender = "Other";
    private DateTime? _formBirthday;
    private string _formMobile = string.Empty;
    private string _formCity = string.Empty;
    private int? _formCountryId;
    private string _formWelcomeMessage = string.Empty;
    private string _formNewPassword = string.Empty;
    private string _passwordValidationError = string.Empty;
    private DateTime? _formEntryDate;
    private string? _formError;
    private bool _actionSuccess;
    private string? _actionResult;
    private EmailPreviewDto? _emailPreview;

    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
        await LoadUsers();

        if (!IsWriteBlocked && TryGetEditUserIdFromQuery(out var editUserId))
        {
            var userToEdit = _users.FirstOrDefault(u => u.Id == editUserId);
            if (userToEdit is not null)
            {
                EditUser(userToEdit);
                return;
            }
        }

        if (ShouldOpenCreateFormFromQuery() && !IsWriteBlocked)
        {
            ShowCreateForm();
        }
    }

    private async Task LoadUsers()
    {
        _loading = true;
        _expandedPendingUserIds.Clear();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;
        _isSuperAdmin = currentUser.HasClaim("SuperAdmin", "true");
        _managedGroupIds = currentUser.Claims
            .Where(c => c.Type.StartsWith("GroupRole::", StringComparison.Ordinal) && c.Value == "Admin")
            .Select(c => int.TryParse(c.Type["GroupRole::".Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();

        var allGroups = (await GroupService.GetAllAsync()).OrderBy(g => g.Name).ToList();
        _availableGroups = _isSuperAdmin
            ? allGroups
            : allGroups.Where(g => _managedGroupIds.Contains(g.Id)).ToList();

        _countries = (await CountryService.GetAllAsync()).ToList();

        var allUsers = (await UserService.GetAllAsync()).ToList();
        var pendingUsers = (await UserRegistrationService.GetPendingApprovalsAsync()).ToList();
        await LoadMembershipsAsync(allUsers.Select(u => u.Id).Concat(pendingUsers.Select(u => u.Id)));

        if (_isSuperAdmin)
        {
            _users = allUsers;
            _pendingUsers = pendingUsers;
        }
        else
        {
            _users = allUsers
                .Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Approved &&
                    m.IsActive &&
                    _managedGroupIds.Contains(m.GroupId)))
                .ToList();

            _pendingUsers = pendingUsers
                .Where(user => GetMemberships(user.Id).Any(m =>
                    m.Status == GroupMembershipStatus.Pending &&
                    _managedGroupIds.Contains(m.GroupId)))
                .ToList();
        }

        await LoadRegistrationHistoryAsync(_users.Select(u => u.Id));

        _loading = false;
    }

    private async Task LoadMembershipsAsync(IEnumerable<int> userIds)
    {
        _membershipsByUser.Clear();
        foreach (var userId in userIds.Distinct())
        {
            _membershipsByUser[userId] = (await GroupService.GetAllMembershipsForUserAsync(userId)).ToList();
        }
    }

    private async Task LoadRegistrationHistoryAsync(IEnumerable<int> userIds)
    {
        _hasRegistrationHistoryByUser.Clear();
        foreach (var userId in userIds.Distinct())
        {
            var hasHistory = (await RegistrationService.GetByUserIdAsync(userId)).Any();
            _hasRegistrationHistoryByUser[userId] = hasHistory;
        }
    }

    private List<GroupMembershipDto> GetMemberships(int userId) =>
        _membershipsByUser.TryGetValue(userId, out var memberships) ? memberships : [];

    private bool CanDeleteUser(int userId) =>
        !_hasRegistrationHistoryByUser.GetValueOrDefault(userId);

    private void ShowCreateForm()
    {
        _editUserId = 0;
        _formFirstName = _formLastName = _formEmail = _formPassword = string.Empty;
        _formRole = "User";
        _formGender = "Other";
        _formBirthday = null;
        _formMobile = _formCity = _formWelcomeMessage = _formNewPassword = string.Empty;
        _formCountryId = null;
        _formEntryDate = null;
        _selectedGroupIds.Clear();
        _passwordValidationError = string.Empty;
        _formError = null;
        _showForm = true;
    }

    private bool ShouldOpenCreateFormFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        if (!query.TryGetValue("create", out var createValue))
        {
            return false;
        }

        var value = createValue.ToString();
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) || value == "1";
    }

    private bool TryGetEditUserIdFromQuery(out int userId)
    {
        userId = 0;
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        if (!query.TryGetValue("editUserId", out var editUserIdValue))
        {
            return false;
        }

        return int.TryParse(editUserIdValue.ToString(), out userId) && userId > 0;
    }

    private void EditUser(UserDto user)
    {
        _editUserId = user.Id;
        _formFirstName = user.FirstName;
        _formLastName = user.LastName;
        _formEmail = user.Email;
        _formRole = user.Role.ToString();
        _formGender = user.Gender.ToString();
        _formBirthday = user.Birthday.HasValue ? user.Birthday.Value.ToDateTime(TimeOnly.MinValue) : null;
        _formMobile = user.Mobile ?? string.Empty;
        _formCity = user.City ?? string.Empty;
        _formCountryId = user.CountryId;
        _formWelcomeMessage = user.WelcomeMessage ?? string.Empty;
        _formEntryDate = user.EntryDate;
        _selectedGroupIds = GetMemberships(user.Id)
            .Where(m => _isSuperAdmin || _managedGroupIds.Contains(m.GroupId))
            .Select(m => m.GroupId)
            .ToHashSet();
        _formNewPassword = string.Empty;
        _passwordValidationError = string.Empty;
        _formError = null;
        _showForm = true;
    }

    private async Task SaveUser()
    {
        _formError = null;
        _passwordValidationError = string.Empty;

        if (!_isSuperAdmin && _selectedGroupIds.Count == 0)
        {
            _formError = Localizer["AssignUserToManagedGroup"];
            return;
        }

        try
        {
            var birthday = _formBirthday.HasValue ? DateOnly.FromDateTime(_formBirthday.Value) : (DateOnly?)null;
            var userId = _editUserId;

            if (_editUserId == 0)
            {
                var createdUser = await UserService.CreateAsync(new CreateUserDto
                {
                    FirstName = _formFirstName,
                    LastName = _formLastName,
                    Email = _formEmail,
                    Password = _formPassword,
                    Role = Enum.Parse<UserRole>(_formRole),
                    Gender = Enum.Parse<Gender>(_formGender),
                    Birthday = birthday,
                    Mobile = string.IsNullOrWhiteSpace(_formMobile) ? null : _formMobile,
                    City = string.IsNullOrWhiteSpace(_formCity) ? null : _formCity,
                    CountryId = _formCountryId
                });
                userId = createdUser.Id;
            }
            else
            {
                var user = _users.First(u => u.Id == _editUserId);
                await UserService.UpdateAsync(new UpdateUserDto
                {
                    Id = _editUserId,
                    FirstName = _formFirstName,
                    LastName = _formLastName,
                    Email = _formEmail,
                    Role = Enum.Parse<UserRole>(_formRole),
                    Gender = Enum.Parse<Gender>(_formGender),
                    IsActive = user.IsActive,
                    Birthday = birthday,
                    Mobile = string.IsNullOrWhiteSpace(_formMobile) ? null : _formMobile,
                    City = string.IsNullOrWhiteSpace(_formCity) ? null : _formCity,
                    CountryId = _formCountryId,
                    EntryDate = _formEntryDate,
                    WelcomeMessage = string.IsNullOrWhiteSpace(_formWelcomeMessage) ? null : _formWelcomeMessage
                });
            }

            await SyncUserGroupsAsync(userId);

            if (!string.IsNullOrWhiteSpace(_formNewPassword) && _editUserId != 0)
            {
                if (!ValidatePassword(_formNewPassword, out var pwError))
                {
                    _passwordValidationError = Localizer[pwError];
                    return;
                }

                await UserService.ChangePasswordAsync(_editUserId, _formNewPassword);
                _formNewPassword = string.Empty;
                _passwordValidationError = string.Empty;
            }

            _showForm = false;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
    }

    private async Task SyncUserGroupsAsync(int userId)
    {
        var availableGroupIds = _availableGroups.Select(g => g.Id).ToHashSet();
        var memberships = (await GroupService.GetAllMembershipsForUserAsync(userId))
            .Where(m => availableGroupIds.Contains(m.GroupId))
            .ToList();

        foreach (var membership in memberships.Where(m => !_selectedGroupIds.Contains(m.GroupId)))
        {
            await GroupService.RemoveMemberAsync(membership.Id);
        }

        foreach (var groupId in _selectedGroupIds)
        {
            var groupMemberships = memberships.Where(m => m.GroupId == groupId).ToList();
            if (groupMemberships.Any(m => m.Status == GroupMembershipStatus.Approved && m.IsActive))
            {
                continue;
            }

            foreach (var membership in groupMemberships)
            {
                await GroupService.RemoveMemberAsync(membership.Id);
            }

            await GroupService.AddMemberAsync(new AddGroupMemberDto
            {
                GroupId = groupId,
                UserId = userId,
                Role = GroupMemberRole.Participant
            });
        }
    }

    private async Task ToggleActive(UserDto user)
    {
        await UserService.UpdateAsync(new UpdateUserDto
        {
            Id = user.Id,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            Role = user.Role,
            Gender = user.Gender,
            IsActive = !user.IsActive,
            Birthday = user.Birthday,
            Mobile = user.Mobile,
            City = user.City,
            CountryId = user.CountryId,
            EntryDate = user.EntryDate,
            WelcomeMessage = user.WelcomeMessage
        });
        await LoadUsers();
    }

    private async Task DeleteUserAsync(UserDto user)
    {
        if (!CanDeleteUser(user.Id))
        {
            _actionSuccess = false;
            _actionResult = Localizer["UserCannotBeDeletedDueToRegistrations", user.DisplayName];
            return;
        }

        try
        {
            var memberships = (await GroupService.GetAllMembershipsForUserAsync(user.Id)).ToList();
            foreach (var membership in memberships)
            {
                await GroupService.RemoveMemberAsync(membership.Id);
            }

            await UserService.DeleteAsync(user.Id);

            if (_editUserId == user.Id)
            {
                CancelForm();
            }

            _actionSuccess = true;
            _actionResult = Localizer["UserWasDeleted", user.DisplayName];
            await LoadUsers();
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = Localizer["FailedMessage", ex.Message];
        }
    }

    private async Task ApproveUser(UserDto user)
    {
        await UserRegistrationService.ApproveUserAsync(user.Id, 0);
        await LoadUsers();
    }

    private async Task RejectUser(UserDto user)
    {
        await UserRegistrationService.RejectUserAsync(user.Id, 0);
        await LoadUsers();
    }

    private async Task SendAccountMail(UserDto user)
    {
        _actionResult = null;
        _busyUserId = user.Id;

        try
        {
            var result = await UserRegistrationService.ResendEmailConfirmationAsync(user.Id);
            _actionSuccess = true;
            _actionResult = result.Preview is null
                ? Localizer["AccountEmailSentTo", user.Email]
                : Localizer["NoEmailModePreviewShown", user.Email];
            _emailPreview = result.Preview;
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = Localizer["FailedMessage", ex.Message];
        }
        finally
        {
            _busyUserId = null;
        }
    }

    private void TogglePendingExpand(int userId)
    {
        if (_expandedPendingUserIds.Contains(userId))
        {
            _expandedPendingUserIds.Remove(userId);
        }
        else
        {
            _expandedPendingUserIds.Add(userId);
        }
    }

    private void ToggleGroup(int groupId, bool selected)
    {
        if (selected)
        {
            _selectedGroupIds.Add(groupId);
        }
        else
        {
            _selectedGroupIds.Remove(groupId);
        }
    }

    private Task CloseEmailPreview()
    {
        _emailPreview = null;
        return Task.CompletedTask;
    }

    private bool IsUserBusy(int userId) => _busyUserId == userId;

    private string FormatApprovedGroups(int userId)
    {
        var names = GetMemberships(userId)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .Select(m => _availableGroups.FirstOrDefault(g => g.Id == m.GroupId)?.Name ?? $"Group #{m.GroupId}")
            .Distinct()
            .ToList();

        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private string FormatPendingGroups(int userId)
    {
        var names = GetMemberships(userId)
            .Where(m => m.Status == GroupMembershipStatus.Pending)
            .Select(m => _availableGroups.FirstOrDefault(g => g.Id == m.GroupId)?.Name ?? $"Group #{m.GroupId}")
            .Distinct()
            .ToList();

        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private string GetCountryLabel(int? countryId)
    {
        if (!countryId.HasValue)
        {
            return "—";
        }

        var country = _countries.FirstOrDefault(c => c.Id == countryId.Value);
        return country is null ? "—" : $"{country.Code} — {country.Name}";
    }

    private void CancelForm()
    {
        _showForm = false;
        _formNewPassword = string.Empty;
        _passwordValidationError = string.Empty;
    }

    private void GeneratePassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghjkmnpqrstuvwxyz";
        const string digits = "23456789";
        const string special = "!@#$%^&*";
        const string all = upper + lower + digits + special;

        using var rng = System.Security.Cryptography.RandomNumberGenerator.Create();
        var bytes = new byte[12];
        rng.GetBytes(bytes);

        var chars = new char[12];
        chars[0] = upper[bytes[0] % upper.Length];
        chars[1] = lower[bytes[1] % lower.Length];
        chars[2] = digits[bytes[2] % digits.Length];
        chars[3] = special[bytes[3] % special.Length];
        for (var i = 4; i < 12; i++)
        {
            chars[i] = all[bytes[i] % all.Length];
        }

        for (var i = chars.Length - 1; i > 0; i--)
        {
            var j = bytes[i % bytes.Length] % (i + 1);
            (chars[i], chars[j]) = (chars[j], chars[i]);
        }

        _formNewPassword = new string(chars);
        _passwordValidationError = string.Empty;
    }

    private static bool ValidatePassword(string password, out string error)
    {
        error = string.Empty;
        if (password.Length < 8) { error = "PasswordValidationMinLength"; return false; }
        if (!password.Any(char.IsUpper)) { error = "PasswordValidationUppercase"; return false; }
        if (!password.Any(char.IsLower)) { error = "PasswordValidationLowercase"; return false; }
        if (!password.Any(char.IsDigit)) { error = "PasswordValidationDigit"; return false; }
        if (!password.Any(c => "!@#$%^&*()-_=+[]{}|;:',.<>?".Contains(c))) { error = "PasswordValidationSpecialCharacter"; return false; }
        return true;
    }

    private string GetDisplayRole(UserDto user)
    {
        if (user.Role == UserRole.SuperAdmin)
        {
            return Localizer["SuperAdmin"];
        }

        var memberships = GetMemberships(user.Id)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .ToList();

        if (memberships.Any(m => m.Role == GroupMemberRole.Admin))
        {
            return Localizer["GroupAdmin"];
        }

        if (memberships.Any(m => m.Role == GroupMemberRole.Trainer))
        {
            return Localizer["Trainer"];
        }

        return Localizer["User"];
    }

    private string GetRoleAbbreviation(UserDto user)
    {
        if (user.Role == UserRole.SuperAdmin)
        {
            return "S";
        }

        var memberships = GetMemberships(user.Id)
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
            .ToList();

        if (memberships.Any(m => m.Role == GroupMemberRole.Admin))
        {
            return "A";
        }

        if (memberships.Any(m => m.Role == GroupMemberRole.Trainer))
        {
            return "T";
        }

        return "U";
    }

    private string RoleBadge(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "bg-dark",
        _ => "bg-secondary"
    };
