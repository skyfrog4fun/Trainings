@page "/statistics"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupAdmin")]
@using Trainings.Web.Auth
@inject IStatisticsService StatisticsService
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["Statistics"]</PageTitle>

<div class="container px-2 px-md-4">
    <PageHeader Title='@Localizer["Statistics"]'>
        <Actions>
            <span class="badge bg-secondary">@_scopeLabel</span>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardStatCard Title='@Localizer["Groups"]'
                                   Value="@_stats.TotalGroups.ToString()"
                                   IconClass="@AppIcons.Group"
                                   BadgeToneClass="dashboard-icon-badge-secondary" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardStatCard Title='@Localizer["StatisticsActiveUsers"]'
                                   Value="@_stats.ActiveUsers.ToString()"
                                   IconClass="@AppIcons.Users"
                                   BadgeToneClass="dashboard-icon-badge-primary" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardStatCard Title='@Localizer["StatisticsUsersNotInGroup"]'
                                   Value="@_stats.UsersNotInGroup.ToString()"
                                   IconClass="@AppIcons.UserMinus"
                                   BadgeToneClass="dashboard-icon-badge-secondary" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardStatCard Title='@Localizer["Trainings"]'
                                   Value="@_stats.TotalTrainings.ToString()"
                                   IconClass="@AppIcons.Fire"
                                   BadgeToneClass="dashboard-icon-badge-highlight" />
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <DashboardStatCard Title='@Localizer["StatisticsTotalRegistrations"]'
                                   Value="@_stats.TotalRegistrations.ToString()"
                                   IconClass="@AppIcons.ClipboardList"
                                   BadgeToneClass="dashboard-icon-badge-secondary" />
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-bold">@Localizer["StatisticsAnnualIndicators", DateTime.UtcNow.Year]</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">@Localizer["StatisticsAvgUsersPerGroup"]</div>
                            <div class="fs-3">@_stats.AverageUsersPerGroup.ToString("0.##")</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">@Localizer["StatisticsAvgParticipantsPerTraining"]</div>
                            <div class="fs-3">@_stats.AverageParticipantsPerTraining.ToString("0.##")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private StatisticsDto _stats = new();
    private bool _loading = true;
    private string _scopeLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var isSuperAdmin = user.HasClaim(AppClaimTypes.SuperAdmin, "true");
        var managedGroupIds = user.Claims
            .Where(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Admin")
            .Select(c => int.TryParse(c.Type[AppClaimTypes.GroupRolePrefix.Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .Distinct()
            .ToList();

        _stats = await StatisticsService.GetStatisticsAsync(isSuperAdmin, managedGroupIds);
        _scopeLabel = isSuperAdmin ? Localizer["StatisticsScopeGlobal"] : Localizer["StatisticsScopeManagedGroups"];
        _loading = false;
    }
}
