@page "/trainings/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupMember")]
@using Trainings.Web.Auth
@inject ITrainingService TrainingService
@inject IRegistrationService RegistrationService
@inject IUserService UserService
@inject IEmailService EmailService
@inject IDateTimeFormatService DateTimeFormatService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@(_training?.Title ?? "Training")</PageTitle>

<div class="container px-2 px-md-4">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_training == null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-info")">@(_message ?? "Training not found.")</div>
    }
    else
    {
        <div class="my-3 d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <a href="/trainings" class="btn btn-sm btn-outline-secondary"><i class="@AppIcons.Back me-1" aria-hidden="true"></i>Back</a>
            @if (_isAdmin)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="PromptDeleteTraining"
                        disabled="@_deleteInProgress">
                    <i class="@AppIcons.Trash me-1" aria-hidden="true"></i>Delete
                </button>
            }
        </div>
        @if (_showDeleteConfirm)
        {
            <div class="confirmation-panel confirmation-panel-danger mb-3">
                <div class="fw-semibold mb-2">Are you sure?</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelDeleteTraining" disabled="@_deleteInProgress">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteTraining" disabled="@_deleteInProgress">
                        <i class="@AppIcons.Trash me-1" aria-hidden="true"></i>Delete
                    </button>
                    @if (HasRegisteredParticipants)
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="NotifyAndDeleteTraining" disabled="@_deleteInProgress">
                            <i class="@AppIcons.Envelope me-1" aria-hidden="true"></i>Notify & Delete
                        </button>
                    }
                </div>
            </div>
        }
        <div class="card shadow mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <span class="fw-semibold text-truncate training-detail-title">@_training.Title</span>
                    <span class="text-nowrap text-muted small">
                        <i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@_training.DateTime.ToString("dd.MM.yy")
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="text-muted mb-3">
                    @if (_training.GroupName != null)
                    {
                        <div class="mb-2"><i class="@AppIcons.Group me-1" aria-hidden="true"></i>@_training.GroupName</div>
                    }
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                        <span class="text-truncate"><i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@FormatTrainingDate(_training)</span>
                        <span class="text-nowrap"><i class="@AppIcons.Stopwatch me-1" aria-hidden="true"></i>@FormatDuration(_training.DurationMinutes)</span>
                    </div>
                    <div class="mb-2"><i class="@AppIcons.Location me-1" aria-hidden="true"></i>@(_training.LocationName ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(_training.SpecialLocationDescription))
                    {
                        <div class="mb-2"><i class="@AppIcons.LocationCrosshairs me-1" aria-hidden="true"></i>@_training.SpecialLocationDescription</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_training.MeetingPoint))
                    {
                        <div class="mb-2"><i class="@AppIcons.MapPin me-1" aria-hidden="true"></i>@_training.MeetingPoint</div>
                    }
                    <div class="mb-2"><i class="@AppIcons.User me-1" aria-hidden="true"></i>Trainer: @_training.TrainerName</div>
                    <div><i class="@AppIcons.Users me-1" aria-hidden="true"></i>@_training.RegisteredCount / @_training.Capacity registered</div>
                </div>

                <p class="mb-4">@_training.Description</p>

                @if (_isTrainer && _training.TrainerId == _userId)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <a href="/trainings/@_training.Id/run" class="btn btn-success"><i class="@AppIcons.Check me-1" aria-hidden="true"></i>Run Training</a>
                        <a href="/trainings/@_training.Id/attendance" class="btn btn-primary">Record Attendance</a>
                        <a href="/trainings/@_training.Id/edit" class="btn btn-outline-secondary">Edit</a>
                    </div>
                }
            </div>
            @if (_canRegister)
            {
                <div class="card-footer training-detail-registration-footer @GetRegistrationFooterCssClass()">
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-end training-detail-footer-content">
                        @if (_registrationFooterState == RegistrationFooterState.ConfirmUnregister)
                        {
                            <span class="fw-semibold">Are you sure?</span>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmSelfUnregister">Confirm</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelSelfUnregister">Cancel</button>
                        }
                        else if (_registrationFooterState == RegistrationFooterState.RegisteredSuccess)
                        {
                            <span class="fw-semibold">Successfully registered</span>
                        }
                        else if (_registrationFooterState == RegistrationFooterState.UnregisteredSuccess)
                        {
                            <span class="fw-semibold">Registration cancelled</span>
                        }
                        else if (_isRegistered)
                        {
                            <button class="btn btn-danger" @onclick="PromptSelfUnregister"><i class="@AppIcons.Unregister me-1" aria-hidden="true"></i>Unregister</button>
                        }
                        else if (_training.RegisteredCount < _training.Capacity)
                        {
                            <button class="btn btn-primary" @onclick="Register"><i class="@AppIcons.Register me-1" aria-hidden="true"></i>Register</button>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Training Full</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_message != null)
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_message</div>
        }

        @if (_training.Blocks.Any())
        {
            <h4>Training Blocks (@_training.Blocks.Count)</h4>
            <div class="row g-3 mb-4">
                @for (var i = 0; i < _training.Blocks.Count; i++)
                {
                    var block = _training.Blocks[i];
                    var num = i + 1;
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title">@num. @block.Title</h6>
                                @if (!string.IsNullOrEmpty(block.Description))
                                {
                                    <p class="card-text text-muted small">@block.Description</p>
                                }
                                <div class="small text-muted">
                                    <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>Planned: @block.PlannedDurationMinutes min
                                    @if (block.EffectiveDurationMinutes.HasValue)
                                    {
                                        <text> · Actual: @block.EffectiveDurationMinutes min</text>
                                    }
                                </div>
                                @if (block.Tags.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var tag in block.Tags)
                                        {
                                            <span class="badge bg-info text-dark me-1">@tag.Name</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="card shadow mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <span class="fw-semibold participants-card-title text-truncate">Registered Participants</span>
                    <span class="text-nowrap text-muted small">
                        <i class="@AppIcons.Participants me-1" aria-hidden="true"></i>@RegisteredParticipants.Count / @_training.Capacity
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (RegisteredParticipants.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var reg in RegisteredParticipants)
                        {
                            <li class="list-group-item @(_pendingUnregisterUserId == reg.UserId ? "confirmation-danger-subtle" : string.Empty)">
                                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                    <div class="d-flex flex-column">
                                        <span>@reg.UserName</span>
                                        <span class="text-muted small participant-registered-at">@reg.RegisteredAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                    @if (CanActOnParticipant(reg))
                                    {
                                        <div class="d-inline-flex gap-2 ms-auto">
                                            @if (_pendingUnregisterUserId == reg.UserId)
                                            {
                                                <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmParticipantUnregister" title="Confirm">
                                                    <i class="@AppIcons.Check" aria-hidden="true"></i>
                                                    <span class="participant-action-text ms-1">Confirm</span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelParticipantUnregister" title="Cancel">
                                                    <i class="@AppIcons.XMark" aria-hidden="true"></i>
                                                    <span class="participant-action-text ms-1">Cancel</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => PromptParticipantUnregister(reg)" title="Unregister">
                                                    <i class="@AppIcons.Unregister" aria-hidden="true"></i>
                                                    <span class="participant-action-text ms-1">Unregister</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-muted">No one has signed up yet — this training is currently winning the hide-and-seek championship.</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private enum RegistrationFooterState
    {
        Normal,
        ConfirmUnregister,
        RegisteredSuccess,
        UnregisteredSuccess
    }

    private static readonly TimeSpan RegistrationStatusDisplayDuration = TimeSpan.FromSeconds(7);

    [Parameter] public int Id { get; set; }

    private TrainingDto? _training;
    private bool _loading = true;
    private bool _isRegistered;
    private bool _isTrainer;
    private bool _isAdmin;
    private bool _canRegister;
    private bool _showDeleteConfirm;
    private bool _deleteInProgress;
    private int _userId;
    private int? _pendingUnregisterUserId;
    private List<RegistrationDto> _registrations = new();
    private string? _message;
    private bool _isError;
    private string _userCountry = "CH";
    private RegistrationFooterState _registrationFooterState;
    private CancellationTokenSource? _registrationFooterResetCts;

    private List<RegistrationDto> RegisteredParticipants =>
        _registrations.Where(registration => registration.Status == RegistrationStatus.Registered).ToList();
    private bool HasRegisteredParticipants => RegisteredParticipants.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        CancelParticipantUnregister();
        _showDeleteConfirm = false;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var isSuperAdmin = user.HasClaim(AppClaimTypes.SuperAdmin, "true");

        _userId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (_userId > 0)
        {
            _userCountry = (await UserService.GetByIdAsync(_userId))?.CountryCode ?? DateTimeFormatService.GetDefaultCountry();
        }

        _training = await TrainingService.GetByIdAsync(Id);
        if (_training == null)
        {
            _loading = false;
            return;
        }

        _isAdmin = isSuperAdmin || (_training.GroupId.HasValue && user.HasClaim(AppClaimTypes.GroupRole(_training.GroupId.Value), "Admin"));
        _isTrainer = _isAdmin || (_training.GroupId.HasValue && user.HasClaim(AppClaimTypes.GroupRole(_training.GroupId.Value), "Trainer"));
        _canRegister = isSuperAdmin || (_training.GroupId.HasValue && user.Claims.Any(claim =>
            claim.Type == AppClaimTypes.GroupRole(_training.GroupId.Value) &&
            (claim.Value == "Participant" || claim.Value == "Trainer" || claim.Value == "Admin")));

        if (_canRegister && _userId > 0)
        {
            _isRegistered = await RegistrationService.IsRegisteredAsync(_userId, Id);
        }
        else
        {
            _isRegistered = false;
        }

        _registrations = (await RegistrationService.GetByTrainingIdAsync(Id)).ToList();

        _loading = false;
    }

    private async Task Register()
    {
        try
        {
            await RegistrationService.RegisterAsync(_userId, Id);
            await LoadAsync();
            _registrationFooterState = RegistrationFooterState.RegisteredSuccess;
            _ = ScheduleRegistrationFooterResetAsync(RegistrationFooterState.RegisteredSuccess);
            _message = null;
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private void PromptSelfUnregister()
    {
        _message = null;
        _showDeleteConfirm = false;
        _pendingUnregisterUserId = null;
        _registrationFooterState = RegistrationFooterState.ConfirmUnregister;
    }

    private async Task ConfirmSelfUnregister()
    {
        try
        {
            await RegistrationService.CancelAsync(_userId, Id);
            await LoadAsync();
            _registrationFooterState = RegistrationFooterState.UnregisteredSuccess;
            _ = ScheduleRegistrationFooterResetAsync(RegistrationFooterState.UnregisteredSuccess);
            _message = null;
            _isError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private void PromptParticipantUnregister(RegistrationDto registration)
    {
        _message = null;
        _showDeleteConfirm = false;
        _registrationFooterState = RegistrationFooterState.Normal;
        _pendingUnregisterUserId = registration.UserId;
    }

    private async Task ConfirmParticipantUnregister()
    {
        if (!_pendingUnregisterUserId.HasValue)
        {
            return;
        }

        try
        {
            await RegistrationService.CancelAsync(_pendingUnregisterUserId.Value, Id);
            _registrations.RemoveAll(registration =>
                registration.UserId == _pendingUnregisterUserId.Value &&
                registration.Status == RegistrationStatus.Registered);
            if (_training is not null && _training.RegisteredCount > 0)
            {
                _training.RegisteredCount--;
            }

            if (_pendingUnregisterUserId == _userId)
            {
                _isRegistered = false;
                _registrationFooterState = RegistrationFooterState.UnregisteredSuccess;
                _ = ScheduleRegistrationFooterResetAsync(RegistrationFooterState.UnregisteredSuccess);
            }

            _message = null;
            _isError = false;
            CancelParticipantUnregister();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private void CancelParticipantUnregister()
    {
        _pendingUnregisterUserId = null;
    }

    private void CancelSelfUnregister()
    {
        _registrationFooterState = RegistrationFooterState.Normal;
    }

    private void PromptDeleteTraining()
    {
        CancelParticipantUnregister();
        _registrationFooterState = RegistrationFooterState.Normal;
        _message = null;
        _showDeleteConfirm = true;
    }

    private void CancelDeleteTraining()
    {
        _showDeleteConfirm = false;
    }

    private async Task DeleteTraining() => await DeleteTrainingInternalAsync(notifyParticipants: false);

    private async Task NotifyAndDeleteTraining() => await DeleteTrainingInternalAsync(notifyParticipants: true);

    private async Task DeleteTrainingInternalAsync(bool notifyParticipants)
    {
        if (_training is null)
        {
            return;
        }

        try
        {
            _deleteInProgress = true;

            if (notifyParticipants)
            {
                var appUrl = Navigation.BaseUri.TrimEnd('/');
                var recipientIds = _registrations
                    .Where(registration => registration.Status == RegistrationStatus.Registered)
                    .Select(registration => registration.UserId)
                    .ToHashSet();

                var recipientUsers = (await UserService.GetAllAsync())
                    .Where(user => recipientIds.Contains(user.Id) && !string.IsNullOrWhiteSpace(user.Email))
                    .ToList();

                foreach (var user in recipientUsers)
                {
                    var sendResult = await EmailService.SendTrainingCancellationAsync(
                        user.Email,
                        _training.Title,
                        _training.DateTime,
                        appUrl);

                    if (!sendResult.IsSuccess)
                    {
                        throw new InvalidOperationException($"Failed to notify {user.Email}.");
                    }
                }
            }

            await TrainingService.DeleteAsync(_training.Id);
            Navigation.NavigateTo("/trainings");
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _deleteInProgress = false;
        }
    }

    private string FormatTrainingDate(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return training.DateTime.ToString("f", culture);
    }

    private static string FormatDuration(int? durationMinutes) =>
        durationMinutes.HasValue ? $"{durationMinutes.Value} min" : "-";

    private bool CanActOnParticipant(RegistrationDto registration) =>
        _isTrainer || _isAdmin || registration.UserId == _userId;

    private string GetRegistrationFooterCssClass() => _registrationFooterState switch
    {
        RegistrationFooterState.ConfirmUnregister => "training-detail-footer-confirm",
        RegistrationFooterState.RegisteredSuccess => "training-detail-footer-success",
        RegistrationFooterState.UnregisteredSuccess => "training-detail-footer-danger",
        _ => string.Empty
    };

    private async Task ScheduleRegistrationFooterResetAsync(RegistrationFooterState sourceState)
    {
        var newCts = new CancellationTokenSource();
        var previousCts = Interlocked.Exchange(ref _registrationFooterResetCts, newCts);
        previousCts?.Cancel();
        previousCts?.Dispose();
        var ct = newCts.Token;

        try
        {
            await Task.Delay(RegistrationStatusDisplayDuration, ct);
            if (!ct.IsCancellationRequested && _registrationFooterState == sourceState)
            {
                _registrationFooterState = RegistrationFooterState.Normal;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }
}
