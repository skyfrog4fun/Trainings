@page "/config/mail"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "SuperAdmin")]
@using System.Globalization
@using Microsoft.JSInterop
@using Trainings.Application.DTOs
@using Trainings.Domain.Entities
@using Trainings.Domain.Enums
@inject IMailConfigurationService MailConfigService
@inject IEmailService EmailService
@inject IAppRuntimeModeService AppRuntimeModeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService UserService
@inject IDateTimeFormatService DateTimeFormatService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Configuration</PageTitle>

<div class="container px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2><i class="@AppIcons.Gear me-2" aria-hidden="true"></i>Configuration</h2>
    </div>

    <p class="text-muted">Define SMTP server configurations used to send emails. Regular email sending still uses active configurations in priority order. Test email can run against all configurations or one selected configuration.</p>

    <div class="card mb-4">
        <div class="card-header fw-bold">Running Mode</div>
        <div class="card-body">
            <p class="text-muted mb-3">
                Override the startup configuration defaults for the current session.
                Changes take effect immediately for all users and are reset to the configured defaults on application restart.
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chkReadOnly" @bind="_modeReadOnly" />
                        <label class="form-check-label" for="chkReadOnly">
                            <strong>Read Only</strong>
                            <span class="text-muted small d-block">Blocks write operations for everyone except SuperAdmins</span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chkNoEmail" @bind="_modeNoEmail" />
                        <label class="form-check-label" for="chkNoEmail">
                            <strong>No E-Mail</strong>
                            <span class="text-muted small d-block">Suppresses outgoing email and shows an in-app preview instead</span>
                        </label>
                    </div>
                </div>
                <div class="col-12 col-lg-2 d-flex align-items-end justify-content-lg-end">
                    <button class="btn btn-primary me-2" @onclick="ApplyModes">Apply</button>
                    <button class="btn btn-outline-secondary" @onclick="ResetModesToDefaults" title="Reset to startup configuration defaults">Reset to Defaults</button>
                </div>
            </div>
            @if (_modeActionResult is not null)
            {
                <div class="alert @(_modeActionSuccess ? "alert-success" : "alert-danger") mt-3 mb-0">@_modeActionResult</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center fw-bold">
            <span>Server/Client Time</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshDateTimesAsync">Refresh</button>
        </div>
        <div class="card-body">
            <div class="row g-2 small">
                <div class="col-12 col-md-6">
                    <strong>Server date/time:</strong> @_serverDateTime
                </div>
                <div class="col-12 col-md-6">
                    <strong>Client date/time:</strong> @_clientDateTime
                </div>
            </div>
            @if (_timeError is not null)
            {
                <div class="alert alert-warning mt-3 mb-0">@_timeError</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center fw-bold">
            <span>Mail Configuration</span>
            <button class="btn btn-success btn-sm" @onclick="ShowCreateForm"><i class="@AppIcons.Plus me-1" aria-hidden="true"></i>New Configuration</button>
        </div>
        <div class="card-body">
            <p class="text-muted mb-0">Manage SMTP endpoints used by notification delivery and fallback retry order.</p>
        </div>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4">
            <div class="card-header fw-bold">@(_editId == 0 ? "New Mail Configuration" : "Edit Mail Configuration")</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Name *</label>
                        <input class="form-control" placeholder="e.g. Primary SMTP" @bind="_formName" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Priority *</label>
                        <input class="form-control" type="number" min="1" @bind="_formPriority" />
                        <div class="form-text">1 = highest priority</div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label d-block">&nbsp;</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="_formIsActive" id="chkActive" />
                            <label class="form-check-label" for="chkActive">Active</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">SMTP Host *</label>
                        <input class="form-control" placeholder="smtp.example.com" @bind="_formHost" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Port *</label>
                        <input class="form-control" type="number" @bind="_formPort" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Username</label>
                        <input class="form-control" placeholder="SMTP username" @bind="_formUsername" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Password</label>
                        <input class="form-control" type="password" placeholder="SMTP password" @bind="_formPassword" />
                        @if (_editId != 0)
                        {
                            <div class="form-text">Leave blank to keep the existing password.</div>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">From Address *</label>
                        <input class="form-control" type="email" placeholder="noreply@example.com" @bind="_formFromAddress" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="SaveConfig">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                </div>
                @if (_formError != null)
                {
                    <div class="alert alert-danger mt-2">@_formError</div>
                }
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else if (!_configs.Any())
    {
        <div class="alert alert-info">
            No mail configurations defined yet. Add at least one SMTP configuration to enable email notifications.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var config in _configs)
            {
                <div class="col-12">
                    <div class="card @(config.IsActive ? "" : "border-secondary opacity-75")">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                @config.Name
                                <span class="badge bg-secondary ms-2">Priority @config.Priority</span>
                                @if (config.IsActive)
                                {
                                    <span class="badge bg-success ms-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">Inactive</span>
                                }
                            </span>
                            <div>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditConfig(config)">Edit</button>
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => ToggleActive(config)">
                                    @(config.IsActive ? "Deactivate" : "Activate")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteConfig(config)">Delete</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 small">
                                <div class="col-12 col-md-4">
                                    <strong>Host:</strong> @config.Host:@config.Port
                                </div>
                                <div class="col-12 col-md-4">
                                    <strong>Username:</strong> @config.Username
                                </div>
                                <div class="col-12 col-md-4">
                                    <strong>From:</strong> @config.FromAddress
                                </div>
                                <div class="col-12 col-md-4">
                                    <strong>Created:</strong> @FormatServerDateTime(config.CreatedAt)
                                </div>
                                <div class="col-12 col-md-4">
                                    <strong>Last Success Sent:</strong> @FormatServerDateTime(config.LastSuccessSentAt)
                                </div>
                                <div class="col-12 col-md-4">
                                    <strong>Status:</strong>
                                    <span class="badge @GetStatusBadgeClass(config.Status) ms-1">@FormatStatus(config.Status)</span>
                                </div>
                                @if (config.Status != MailConfigurationStatus.Successful && !string.IsNullOrWhiteSpace(config.LastError))
                                {
                                    <div class="col-12 text-danger">
                                        <strong>Latest Error:</strong> @config.LastError
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (_actionResult != null)
    {
        <div class="alert @(_actionSuccess ? "alert-success" : "alert-danger") mt-3">@_actionResult</div>
    }

    <div class="card mt-4">
        <div class="card-header fw-bold"><i class="@AppIcons.Envelope me-2" aria-hidden="true"></i>Test Email</div>
        <div class="card-body">
            <p class="text-muted mb-2">Send a test email against all configurations in priority order or against a single selected configuration.</p>
            <div class="row g-2 align-items-start">
                <div class="col-12 col-md-4">
                    <label class="form-label">Recipient Email</label>
                    <input class="form-control" type="email" @bind="_testEmail" placeholder="you@example.com" />
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label">Mail Configuration</label>
                    <select class="form-select" @bind="_selectedTestTarget">
                        <option value="@AllConfigurationsValue">All configurations</option>
                        @foreach (var config in _configs)
                        {
                            <option value="@config.Id">@GetConfigOptionLabel(config)</option>
                        }
                    </select>
                    <div class="form-text">Inactive configurations remain selectable for targeted testing.</div>
                </div>
                <div class="col-12 col-md-3 d-flex">
                    <div class="w-100 d-flex align-items-end">
                        <button class="btn btn-info w-100" @onclick="SendTestEmail" disabled="@_testEmailSending">
                            @if (_testEmailSending)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Send Test Email
                        </button>
                    </div>
                </div>
            </div>
            @if (_testEmailResult is not null)
            {
                <div class="alert @(_testEmailResult.IsSuccess ? "alert-success" : "alert-danger") mt-3">
                    @GetTestResultSummary()
                </div>

                @if (_testEmailResult.Attempts.Any())
                {
                    <ul class="list-group">
                        @foreach (var attempt in _testEmailResult.Attempts)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <span class="@(attempt.IsSuccess ? "text-success" : "text-danger")">@attempt.Message</span>
                                @if (!attempt.IsActive)
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
</div>

@code {
    private const string AllConfigurationsValue = "all";

    private List<MailConfiguration> _configs = new();
    private bool _loading = true;
    private bool _showForm;
    private int _editId;
    private string _formName = string.Empty;
    private string _formHost = string.Empty;
    private string _formUsername = string.Empty;
    private string _formPassword = string.Empty;
    private string _formFromAddress = string.Empty;
    private int _formPort = 587;
    private int _formPriority = 1;
    private bool _formIsActive = true;
    private string? _formError;
    private bool _actionSuccess;
    private string? _actionResult;

    private string _testEmail = string.Empty;
    private bool _testEmailSending;
    private string _selectedTestTarget = AllConfigurationsValue;
    private EmailSendResult? _testEmailResult;

    private string _serverDateTime = "Loading...";
    private string _clientDateTime = "Loading...";
    private string? _timeError;
    private CultureInfo _userCulture = CultureInfo.CurrentCulture;

    private bool _modeReadOnly;
    private bool _modeNoEmail;
    private bool _modeActionSuccess;
    private string? _modeActionResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigs();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _testEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty;
        var userId = int.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        var countryCode = userId > 0
            ? (await UserService.GetByIdAsync(userId))?.CountryCode
            : null;
        _userCulture = DateTimeFormatService.GetCultureForCountry(countryCode);

        var current = AppRuntimeModeService.GetCurrent();
        _modeReadOnly = current.IsReadOnly;
        _modeNoEmail = current.IsNoEmail;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshDateTimesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadConfigs()
    {
        _loading = true;
        _configs = (await MailConfigService.GetAllAsync()).ToList();
        _loading = false;
    }

    private void ShowCreateForm()
    {
        _editId = 0;
        _formName = string.Empty;
        _formHost = string.Empty;
        _formUsername = string.Empty;
        _formPassword = string.Empty;
        _formFromAddress = string.Empty;
        _formPort = 587;
        _formPriority = _configs.Any() ? _configs.Max(c => c.Priority) + 1 : 1;
        _formIsActive = true;
        _formError = null;
        _showForm = true;
    }

    private void EditConfig(MailConfiguration config)
    {
        _editId = config.Id;
        _formName = config.Name;
        _formHost = config.Host;
        _formPort = config.Port;
        _formUsername = config.Username;
        _formPassword = string.Empty;
        _formFromAddress = config.FromAddress;
        _formPriority = config.Priority;
        _formIsActive = config.IsActive;
        _formError = null;
        _showForm = true;
    }

    private async Task SaveConfig()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formHost) || string.IsNullOrWhiteSpace(_formFromAddress))
        {
            _formError = "Name, Host, and From Address are required.";
            return;
        }

        try
        {
            if (_editId == 0)
            {
                if (string.IsNullOrWhiteSpace(_formPassword))
                {
                    _formError = "Password is required for a new configuration.";
                    return;
                }

                await MailConfigService.CreateAsync(new MailConfiguration
                {
                    Name = _formName,
                    Host = _formHost,
                    Port = _formPort,
                    Username = _formUsername,
                    Password = _formPassword,
                    FromAddress = _formFromAddress,
                    Priority = _formPriority,
                    IsActive = _formIsActive
                });
            }
            else
            {
                var existing = await MailConfigService.GetByIdAsync(_editId)
                    ?? throw new InvalidOperationException("Configuration not found.");

                existing.Name = _formName;
                existing.Host = _formHost;
                existing.Port = _formPort;
                existing.Username = _formUsername;
                existing.FromAddress = _formFromAddress;
                existing.Priority = _formPriority;
                existing.IsActive = _formIsActive;

                if (!string.IsNullOrWhiteSpace(_formPassword))
                {
                    existing.Password = _formPassword;
                }

                await MailConfigService.UpdateAsync(existing);
            }

            _showForm = false;
            await LoadConfigs();
            _actionSuccess = true;
            _actionResult = "Configuration saved successfully.";
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
    }

    private async Task ToggleActive(MailConfiguration config)
    {
        _actionResult = null;
        try
        {
            config.IsActive = !config.IsActive;
            await MailConfigService.UpdateAsync(config);
            await LoadConfigs();
            _actionSuccess = true;
            _actionResult = $"Configuration '{config.Name}' {(config.IsActive ? "activated" : "deactivated")}.";
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = $"Failed: {ex.Message}";
        }
    }

    private async Task DeleteConfig(MailConfiguration config)
    {
        _actionResult = null;
        try
        {
            await MailConfigService.DeleteAsync(config.Id);
            await LoadConfigs();
            _actionSuccess = true;
            _actionResult = $"Configuration '{config.Name}' deleted.";
        }
        catch (Exception ex)
        {
            _actionSuccess = false;
            _actionResult = $"Failed: {ex.Message}";
        }
    }

    private void CancelForm() => _showForm = false;

    private async Task SendTestEmail()
    {
        _testEmailResult = null;
        if (string.IsNullOrWhiteSpace(_testEmail))
        {
            _testEmailResult = new EmailSendResult
            {
                IsSuccess = false,
                Attempts =
                [
                    new EmailSendAttemptResult
                    {
                        MailConfigurationId = 0,
                        ConfigurationName = "Mail Test",
                        IsActive = true,
                        IsSuccess = false,
                        Message = "Please enter a recipient email address."
                    }
                ]
            };
            return;
        }

        _actionResult = null;
        _testEmailSending = true;

        try
        {
            _testEmailResult = await EmailService.SendTestEmailAsync(_testEmail, GetSelectedTestConfigurationId());
            await LoadConfigs();
        }
        catch (Exception ex)
        {
            _testEmailResult = new EmailSendResult
            {
                IsSuccess = false,
                Attempts =
                [
                    new EmailSendAttemptResult
                    {
                        MailConfigurationId = 0,
                        ConfigurationName = "Mail Test",
                        IsActive = true,
                        IsSuccess = false,
                        Message = ex.Message
                    }
                ]
            };
        }
        finally
        {
            _testEmailSending = false;
        }
    }

    private async Task RefreshDateTimesAsync()
    {
        _timeError = null;

        try
        {
            _serverDateTime = DateTimeOffset.Now.ToString("f", _userCulture);
            var clientIsoDateTime = await JSRuntime.InvokeAsync<string>("trainings.mailConfig.getClientLocalDateTime");
            _clientDateTime = DateTimeOffset.TryParse(clientIsoDateTime, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var parsed)
                ? parsed.ToString("f", _userCulture)
                : DateTimeOffset.Now.ToString("f", _userCulture);
        }
        catch (Exception ex)
        {
            _timeError = $"Unable to refresh server/client date and time: {ex.Message}";
        }
    }

    private int? GetSelectedTestConfigurationId()
        => _selectedTestTarget == AllConfigurationsValue ? null : int.Parse(_selectedTestTarget);

    private string GetTestResultSummary()
    {
        var targetLabel = GetSelectedTestConfigurationId().HasValue ? "selected configuration" : "configured fallback order";

        return _testEmailResult?.IsSuccess == true
            ? $"Test email sent successfully using the {targetLabel}."
            : $"Test email failed using the {targetLabel}.";
    }

    private static string GetConfigOptionLabel(MailConfiguration config)
        => config.IsActive
            ? $"{config.Priority}. {config.Name}"
            : $"{config.Priority}. {config.Name} (inactive)";

    private string FormatServerDateTime(DateTime? value)
        => value.HasValue
            ? value.Value.ToLocalTime().ToString("f", _userCulture)
            : "Never";

    private static string FormatStatus(MailConfigurationStatus status)
        => status switch
        {
            MailConfigurationStatus.Successful => "Successful",
            MailConfigurationStatus.Failed => "Failed",
            _ => "Unknown"
        };

    private static string GetStatusBadgeClass(MailConfigurationStatus status)
        => status switch
        {
            MailConfigurationStatus.Successful => "bg-success",
            MailConfigurationStatus.Failed => "bg-danger",
            _ => "bg-secondary"
        };

    private void ApplyModes()
    {
        _modeActionResult = null;
        try
        {
            AppRuntimeModeService.SetModes(_modeReadOnly, _modeNoEmail);
            _modeActionSuccess = true;
            _modeActionResult = "Running modes updated successfully.";
        }
        catch (Exception ex)
        {
            _modeActionSuccess = false;
            _modeActionResult = $"Failed to update modes: {ex.Message}";
        }
    }

    private void ResetModesToDefaults()
    {
        _modeActionResult = null;
        try
        {
            AppRuntimeModeService.ResetToDefaults();
            var defaults = AppRuntimeModeService.GetDefaults();
            _modeReadOnly = defaults.IsReadOnly;
            _modeNoEmail = defaults.IsNoEmail;
            _modeActionSuccess = true;
            _modeActionResult = "Running modes reset to startup configuration defaults.";
        }
        catch (Exception ex)
        {
            _modeActionSuccess = false;
            _modeActionResult = $"Failed to reset modes: {ex.Message}";
        }
    }
}
