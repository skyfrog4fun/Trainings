@page "/style"

@rendermode InteractiveServer

@attribute [Authorize(Policy = "SuperAdmin")]

@using Trainings.Domain.Entities

<PageTitle>Style Guide</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3 style-guide-page">
    <div class="alert alert-warning mb-4" role="alert">
        <strong>Internal:</strong> This page is for visual component review only.
    </div>

    <div class="row g-4">
        <aside class="col-12 col-xl-3">
            <div class="card shadow-sm position-sticky" style="top: 5rem;">
                <div class="card-header fw-bold">On this page</div>
                <div class="card-body p-2">
                    <nav aria-label="Style guide sections">
                        <a class="btn btn-link text-start w-100" href="#buttons">Buttons</a>
                        <a class="btn btn-link text-start w-100" href="#cards">Cards</a>
                        <a class="btn btn-link text-start w-100" href="#forms">Forms</a>
                        <a class="btn btn-link text-start w-100" href="#tables">Tables</a>
                        <a class="btn btn-link text-start w-100" href="#alerts-spinners">Alerts and Spinners</a>
                        <a class="btn btn-link text-start w-100" href="#shared-components">Shared Components</a>
                        <a class="btn btn-link text-start w-100" href="#dashboard-widgets">Dashboard Widgets</a>
                        <a class="btn btn-link text-start w-100" href="#icons">Icons</a>
                    </nav>
                </div>
            </div>
        </aside>

        <section class="col-12 col-xl-9 d-flex flex-column gap-4">
            <article id="buttons" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Buttons</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary">Primary</button>
                        <button type="button" class="btn btn-secondary">Secondary</button>
                        <button type="button" class="btn btn-success">Success</button>
                        <button type="button" class="btn btn-warning">Warning</button>
                        <button type="button" class="btn btn-danger">Danger</button>
                        <button type="button" class="btn btn-outline-primary">Outline</button>
                        <button type="button" class="btn btn-dark">Dark</button>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button" class="btn btn-primary btn-sm">Small</button>
                        <button type="button" class="btn btn-primary">Default</button>
                        <button type="button" class="btn btn-primary btn-lg">Large</button>
                        <button type="button" class="btn btn-primary" disabled>Disabled</button>
                    </div>
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <BackButton Href="/" Label="Back button component" />
                    </div>
                </div>
            </article>

            <article id="cards" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Cards</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-success bg-opacity-10">Simple card</div>
                                <div class="card-body">
                                    <p class="mb-0 text-muted">Example card structure used across the app.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <DashboardStatCard
                                Title="Upcoming Trainings"
                                Value="12"
                                Subtitle="Next 30 days"
                                IconClass="@AppIcons.Calendar"
                                BadgeToneClass="dashboard-icon-badge-success" />
                        </div>
                        <div class="col-12 col-md-6 col-xl-4">
                            <DashboardStatCard
                                Title="Participants"
                                Value="84"
                                Subtitle="Active members"
                                IconClass="@AppIcons.Users"
                                BadgeToneClass="dashboard-icon-badge-secondary" />
                        </div>
                    </div>
                </div>
            </article>

            <article id="forms" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Forms</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Training title</label>
                            <input class="form-control" value="Evening Cardio Session" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Date</label>
                            <input class="form-control" type="date" value="2026-07-14" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Capacity</label>
                            <input class="form-control" type="number" value="20" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Group</label>
                            <select class="form-select">
                                <option>Zurich Beginners</option>
                                <option>Bern Runners</option>
                                <option>Basel Strength</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="3">Warm-up, intervals, cooldown.</textarea>
                        </div>
                    </div>
                </div>
            </article>

            <article id="tables" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Tables</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Alex Miller</td>
                                    <td><span class="badge bg-success">Active</span></td>
                                    <td>Trainer</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary">View</button></td>
                                </tr>
                                <tr>
                                    <td>Jamie Clark</td>
                                    <td><span class="badge bg-warning text-dark">Pending</span></td>
                                    <td>Participant</td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary">View</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>

            <article id="alerts-spinners" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Alerts and Spinners</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <ActionAlert IsSuccess="true" Message="Operation succeeded." />
                    <ActionAlert IsSuccess="false" Message="Operation failed." />
                    <div class="d-flex flex-wrap gap-4 align-items-center">
                        <LoadingSpinner Inline="true" Small="true" Label="Small inline loading" />
                        <LoadingSpinner Inline="true" Label="Inline loading" />
                    </div>
                    <LoadingSpinner Label="Centered loading" />
                </div>
            </article>

            <article id="shared-components" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Shared Components</h2>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <PageHeader Title="PageHeader component">
                        <Actions>
                            <button type="button" class="btn btn-sm btn-outline-primary">
                                <i class="@AppIcons.Plus me-1" aria-hidden="true"></i>Add
                            </button>
                        </Actions>
                    </PageHeader>

                    <div class="alert alert-info mb-0">
                        TrainingBlockEditor is shown in read-only preview mode with TrainingId=0 to avoid backend loading on this page.
                    </div>
                    <TrainingBlockEditor TrainingId="0" IsWriteBlocked="true" />
                </div>
            </article>

            <article id="dashboard-widgets" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Dashboard Widgets</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-xxl-6">
                            <DashboardSystemPanel
                                MailConfigurationCount="2"
                                LocationCount="5"
                                GroupCount="8"
                                UserCount="42"
                                TrainingCount="16" />
                        </div>
                        <div class="col-12 col-xxl-6">
                            <DashboardNotificationPanel
                                Logs="@SampleLogs"
                                SuccessCount="3"
                                FailureCount="1"
                                IsExpanded="true"
                                DisplayLimit="5"
                                OnToggle="@OnDashboardToggle"
                                OnReset="@OnDashboardReset" />
                        </div>
                        <div class="col-12">
                            <DashboardPlanningPanel
                                PlanningByGroup="@SamplePlanning"
                                IsExpanded="true"
                                UserCountry="CH"
                                OnToggle="@OnDashboardToggle" />
                        </div>
                    </div>
                </div>
            </article>

            <article id="icons" class="card shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">Icon Preview</h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Icon</th>
                                    <th>Friendly name</th>
                                    <th>Class</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var icon in AppIcons.All)
                                {
                                    <tr>
                                        <td><i class="@icon.CssClass" aria-hidden="true"></i></td>
                                        <td>@icon.FriendlyName</td>
                                        <td><code>@icon.CssClass</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </article>
        </section>
    </div>
</div>

@code {
    private static IReadOnlyList<NotificationLog> SampleLogs { get; } =
    [
        new NotificationLog
        {
            Id = 101,
            Action = NotificationAction.Registration,
            RecipientEmail = "trainer@example.com",
            IsSuccess = true,
            CreatedAt = DateTime.UtcNow.AddMinutes(-10)
        },
        new NotificationLog
        {
            Id = 100,
            Action = NotificationAction.TrainingCancellation,
            RecipientEmail = "participant@example.com",
            IsSuccess = false,
            ErrorMessage = "Mailbox unavailable",
            CreatedAt = DateTime.UtcNow.AddMinutes(-35)
        },
        new NotificationLog
        {
            Id = 99,
            Action = NotificationAction.EmailConfirmation,
            RecipientEmail = "admin@example.com",
            IsSuccess = true,
            CreatedAt = DateTime.UtcNow.AddHours(-2)
        }
    ];

    private static Dictionary<string, List<TrainingDto>> SamplePlanning { get; } =
        new()
        {
            ["Zurich Beginners"] =
            [
                new TrainingDto
                {
                    Id = 1,
                    Title = "Core Basics",
                    DateTime = DateTime.Today.AddDays(2).AddHours(18),
                    LocationName = "Main Hall",
                    TrainerName = "Chris Novak",
                    Status = TrainingStatus.Planned,
                    GroupCountry = "CH"
                },
                new TrainingDto
                {
                    Id = 2,
                    Title = "Mobility Session",
                    DateTime = DateTime.Today.AddDays(5).AddHours(19),
                    LocationName = "Studio 2",
                    TrainerName = "Robin Allen",
                    Status = TrainingStatus.Planning,
                    GroupCountry = "CH"
                }
            ]
        };

    private static Task OnDashboardToggle() => Task.CompletedTask;

    private static Task OnDashboardReset() => Task.CompletedTask;
}
