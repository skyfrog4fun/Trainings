@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using Trainings.Web.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject ITrainingService TrainingService
@inject IRegistrationService RegistrationService
@inject INotificationLogService NotificationLogService
@inject IGroupService GroupService
@inject ILocationService LocationService
@inject IMailConfigurationService MailConfigurationService
@inject IUserService UserService
@inject IUserRegistrationService UserRegistrationService
@inject IDateTimeFormatService DateTimeFormatService

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid px-2 px-md-4">
    <div class="my-3 d-flex flex-wrap justify-content-between gap-2 align-items-start">
        <div>
            <h2 class="mb-1">Welcome, @_userFirstName!</h2>
            @if (!string.IsNullOrWhiteSpace(_highestRoleLabel))
            {
                <span class="badge bg-dark">@_highestRoleLabel</span>
            }
        </div>
        <div>
            @if (_emailConfirmed)
            {
                <span class="badge bg-success"><i class="@AppIcons.Check me-1" aria-hidden="true"></i>Email verified</span>
            }
            else
            {
                <span class="badge bg-warning text-dark me-2"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>Email not verified</span>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ResendVerificationAsync">Resend verification</button>
            }
        </div>
    </div>

    @if (_verificationActionMessage is not null)
    {
        <div class="alert @(_verificationActionSuccess ? "alert-success" : "alert-danger")">@_verificationActionMessage</div>
    }

    <div class="row g-3 mb-4">
        @if (_isSuperAdmin)
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header dashboard-card-header">
                        <span class="fw-bold">System Overview</span>
                        <span class="dashboard-card-counter">
                            <i class="@AppIcons.Gear" aria-hidden="true"></i> 5
                        </span>
                    </div>
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Mail Configuration: @_mailConfigurationCount</span>
                            <div class="d-flex gap-1">
                                <a class="btn btn-primary btn-sm" href="/config/mail" title="Open mail configuration overview">
                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-success btn-sm" href="/config/mail?create=true" title="Create mail configuration">
                                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Locations: @_locationCount</span>
                            <div class="d-flex gap-1">
                                <a class="btn btn-primary btn-sm" href="/config/locations" title="Open locations overview">
                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-success btn-sm" href="/config/locations?create=true" title="Create location">
                                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Groups: @_groupCount</span>
                            <div class="d-flex gap-1">
                                <a class="btn btn-primary btn-sm" href="/groups" title="Open groups overview">
                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-success btn-sm" href="/groups?create=true" title="Create group">
                                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>Users: @_userCount</span>
                            <div class="d-flex gap-1">
                                <a class="btn btn-primary btn-sm" href="/users" title="Open users overview">
                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-success btn-sm" href="/users?create=true" title="Create user">
                                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2">
                            <span>Trainings: @_trainingCount</span>
                            <div class="d-flex gap-1">
                                <a class="btn btn-primary btn-sm" href="/trainings" title="Open trainings overview">
                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                </a>
                                <a class="btn btn-success btn-sm" href="/trainings/create" title="Create training">
                                    <i class="@AppIcons.Plus" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header dashboard-card-header">
                    <span class="fw-bold">My next trainings (enrolled/assigned)</span>
                    <span class="dashboard-card-counter">
                        <i class="@AppIcons.CalendarCheck" aria-hidden="true"></i> @Math.Min(_myNextTrainings.Count, DashboardDisplayLimit)/@_myNextTrainings.Count
                    </span>
                </div>
                <div class="card-body">
                    @if (_myNextTrainings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var training in _myNextTrainings.Take(DashboardDisplayLimit))
                                    {
                                        <tr>
                                            <td class="small">@FormatDashboardDateTime(training)</td>
                                            <td>@training.Title</td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary" href="/trainings/@training.Id" title="Open training details">
                                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No upcoming trainings.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header dashboard-card-header">
                    <span class="fw-bold">Next trainings available to attend</span>
                    <span class="dashboard-card-counter">
                        <i class="@AppIcons.ListCheck" aria-hidden="true"></i> @Math.Min(_availableNextTrainings.Count, DashboardDisplayLimit)/@_availableNextTrainings.Count
                    </span>
                </div>
                <div class="card-body">
                    @if (_availableTrainingActionMessage is not null)
                    {
                        <div class="alert @(_availableTrainingActionError ? "alert-danger" : "alert-success") py-2">@_availableTrainingActionMessage</div>
                    }

                    @if (_availableNextTrainings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Group</th>
                                        <th>Name</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var training in _availableNextTrainings.Take(DashboardDisplayLimit))
                                    {
                                        <tr>
                                            <td class="small">@FormatTrainingDate(training)</td>
                                            <td class="small">@(training.GroupName ?? "-")</td>
                                            <td>@training.Title</td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary me-2" href="/trainings/@training.Id" title="Open training details">
                                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-sm btn-primary"
                                                        title="@(training.RegisteredCount >= training.Capacity ? "Training full" : "Register for training")"
                                                        @onclick="() => RegisterForTrainingAsync(training.Id)"
                                                        disabled="@(training.RegisteredCount >= training.Capacity)">
                                                    <i class="@AppIcons.ClipboardList" aria-hidden="true"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a href="/trainings" class="btn btn-sm btn-outline-primary mt-3">Browse trainings</a>
                    }
                    else
                    {
                        <div class="text-muted">No available upcoming trainings.</div>
                    }
                </div>
            </div>
        </div>

        @if (_isGroupTrainer)
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header dashboard-card-header">
                        <span class="fw-bold">My trainings to plan</span>
                        <span class="dashboard-card-counter">
                            <i class="@AppIcons.Trainer" aria-hidden="true"></i> @Math.Min(_planLeadTrainings.Count, DashboardDisplayLimit)/@_planLeadTrainings.Count
                        </span>
                    </div>
                    <div class="card-body">
                        @if (_planLeadTrainings.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var training in _planLeadTrainings.Take(DashboardDisplayLimit))
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="me-2">@training.DateTime.ToString("ddd dd.MM. HH:mm")</span>
                                            <span class="text-muted small">@(training.LocationName ?? "-")</span>
                                        </div>
                                        <a class="btn btn-sm btn-outline-primary" href="/trainings/@training.Id/edit">
                                            <i class="@AppIcons.Edit me-1" aria-hidden="true"></i>Plan
                                        </a>
                                    </li>
                                }
                            </ul>
                            <a href="/plan-training" class="btn btn-sm btn-primary mt-3">All trainings</a>
                        }
                        else
                        {
                            <div class="text-muted">No trainings to plan.</div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_isGroupAdmin)
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100">
                    <div class="card-header dashboard-card-header">
                        <span class="fw-bold">Outstanding users to approve</span>
                        <span class="dashboard-card-counter">
                            <i class="@AppIcons.UserClock" aria-hidden="true"></i> @Math.Min(_outstandingApprovals.Count, DashboardDisplayLimit)/@_outstandingApprovals.Count
                        </span>
                    </div>
                    <div class="card-body">
                        @if (_outstandingApprovals.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var user in _outstandingApprovals.Take(DashboardDisplayLimit))
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        <span>@user.DisplayName <span class="text-muted small">(@user.RequestedGroup)</span></span>
                                        <a class="btn btn-sm btn-outline-primary" href="/users">Review</a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted">No outstanding approvals.</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_isGroupAdmin && _planningOverviewByGroup.Any())
    {
        @foreach (var (groupName, trainings) in _planningOverviewByGroup)
        {
            <div class="card collapsible-card mb-4">
                <div class="card-header collapsible-card-header dashboard-card-header">
                    <button type="button" class="collapsible-card-toggle" @onclick="TogglePlanningOverview">
                        <span class="fw-bold">Planning Overview: @groupName</span>
                        <i class="@(_planningOverviewExpanded ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
                    </button>
                    <div class="collapsible-card-meta small">
                        <span class="dashboard-card-counter">
                            <i class="@AppIcons.CalendarCheck" aria-hidden="true"></i> @trainings.Count
                        </span>
                    </div>
                </div>
                @if (_planningOverviewExpanded)
                {
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Date</th><th>Location</th><th>Trainer</th><th>Status</th><th class="text-end">Actions</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var training in trainings)
                                    {
                                        <tr>
                                            <td class="small">@FormatDashboardDateTime(training)</td>
                                            <td class="small">@(training.LocationName ?? "-")</td>
                                            <td class="small">@training.TrainerName</td>
                                            <td><span class="badge @GetStatusBadgeClass(training.Status)">@training.Status</span></td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary" href="/trainings/@training.Id">
                                                    <i class="@AppIcons.CircleInfo" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (_isSuperAdmin)
    {
        <div class="card collapsible-card mb-4">
            <div class="card-header collapsible-card-header dashboard-card-header">
                <button type="button" class="collapsible-card-toggle" @onclick="ToggleNotifications">
                    <span class="fw-bold">Notification Activity</span>
                    <i class="@(_notificationsExpanded ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
                </button>
                <div class="collapsible-card-meta small">
                    <span class="dashboard-card-counter me-3">
                        <i class="@AppIcons.Bell" aria-hidden="true"></i> @Math.Min(_recentLogs.Count, NotificationDisplayLimit)/@_recentLogs.Count
                    </span>
                    <span class="text-success me-3"><i class="@AppIcons.Check" aria-hidden="true"></i> @_notificationSuccessCount</span>
                    <span class="text-danger"><i class="@AppIcons.XMark" aria-hidden="true"></i> @_notificationFailureCount</span>
                </div>
            </div>
            @if (_notificationsExpanded)
            {
                <div class="card-body">
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetNotificationPointerAsync">Reset pointer</button>
                    </div>

                    @if (_recentLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr><th>Log ID</th><th>Date (UTC)</th><th>Action</th><th>Recipient</th><th>Status</th><th>Error</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in _recentLogs.Take(NotificationDisplayLimit))
                                    {
                                        <tr>
                                            <td class="small">#@log.Id</td>
                                            <td class="small">@log.CreatedAt.ToString("MMM d, HH:mm") UTC</td>
                                            <td class="small">@log.Action</td>
                                            <td class="small text-muted">@log.RecipientEmail</td>
                                            <td>
                                                @if (log.IsSuccess)
                                                {
                                                    <i class="@AppIcons.Check text-success" aria-hidden="true"></i>
                                                }
                                                else
                                                {
                                                    <i class="@AppIcons.XMark text-danger" aria-hidden="true"></i>
                                                }
                                            </td>
                                            <td class="small text-danger">@log.ErrorMessage</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No notification activity since the current reset pointer.</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string _userFirstName = "User";
    private int _userId;
    private bool _isSuperAdmin;
    private bool _isGroupAdmin;
    private bool _isGroupTrainer;
    private bool _isGroupMember;
    private string _highestRoleLabel = string.Empty;
    private bool _emailConfirmed;
    private string? _verificationActionMessage;
    private bool _verificationActionSuccess;
    private string? _availableTrainingActionMessage;
    private bool _availableTrainingActionError;
    private string _userCountry = "CH";

    private List<TrainingDto> _myNextTrainings = new();
    private List<TrainingDto> _availableNextTrainings = new();
    private List<TrainingDto> _planLeadTrainings = new();
    private Dictionary<string, List<TrainingDto>> _planningOverviewByGroup = new();
    private bool _planningOverviewExpanded = true;
    private List<OutstandingApprovalViewModel> _outstandingApprovals = new();

    private IReadOnlyList<Trainings.Domain.Entities.NotificationLog> _recentLogs = Array.Empty<Trainings.Domain.Entities.NotificationLog>();
    private int? _notificationPointerLogId;
    private bool _notificationsExpanded = true;
    private int _notificationSuccessCount;
    private int _notificationFailureCount;
    private int _mailConfigurationCount;
    private int _locationCount;
    private int _groupCount;
    private int _userCount;
    private int _trainingCount;
    private const int DashboardDisplayLimit = 5;
    private const int NotificationDisplayLimit = 10;

    private sealed record OutstandingApprovalViewModel(string DisplayName, string RequestedGroup);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var fullName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
        _userFirstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
        _userId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        _isSuperAdmin = user.HasClaim(AppClaimTypes.SuperAdmin, "true");
        _isGroupAdmin = _isSuperAdmin || user.Claims.Any(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Admin");
        _isGroupTrainer = _isGroupAdmin || user.Claims.Any(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Trainer");
        _isGroupMember = _isGroupTrainer || user.Claims.Any(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Participant");

        _highestRoleLabel = _isSuperAdmin
            ? "SuperAdmin"
            : _isGroupAdmin
                ? "Group Admin"
                : _isGroupTrainer
                    ? "Trainer"
                    : string.Empty;

        var userDto = _userId > 0 ? await UserService.GetByIdAsync(_userId) : null;
        _emailConfirmed = userDto?.EmailConfirmedAt.HasValue == true;
        _userCountry = userDto?.CountryCode ?? DateTimeFormatService.GetDefaultCountry();

        var now = DateTime.UtcNow;
        var allActiveTrainings = (await TrainingService.GetActiveAsync())
            .Where(t => t.DateTime >= now)
            .OrderBy(t => t.DateTime)
            .ToList();

        var accessibleGroupIds = user.Claims
            .Where(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal))
            .Select(c => int.TryParse(c.Type[AppClaimTypes.GroupRolePrefix.Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();

        var trainerTrainings = _isGroupTrainer
            ? (await TrainingService.GetByTrainerIdAsync(_userId)).Where(t => t.DateTime >= now).OrderBy(t => t.DateTime).ToList()
            : new List<TrainingDto>();

        var myRegistrationIds = new HashSet<int>();
        if (_isGroupMember)
        {
            var myRegistrations = (await RegistrationService.GetByUserIdAsync(_userId)).ToList();
            foreach (var registration in myRegistrations.Where(r => r.Status == RegistrationStatus.Registered))
            {
                myRegistrationIds.Add(registration.TrainingId);
            }
        }

        var registeredTrainings = new List<TrainingDto>();
        foreach (var trainingId in myRegistrationIds)
        {
            var training = await TrainingService.GetByIdAsync(trainingId);
            if (training is not null && training.DateTime >= now)
            {
                registeredTrainings.Add(training);
            }
        }

        _myNextTrainings = trainerTrainings
            .Concat(registeredTrainings)
            .GroupBy(t => t.Id)
            .Select(g => g.First())
            .OrderBy(t => t.DateTime)
            .ToList();

        _planLeadTrainings = trainerTrainings
            .Where(t => t.Status != TrainingStatus.Planned)
            .ToList();

        _availableNextTrainings = (_isSuperAdmin || _isGroupMember)
            ? allActiveTrainings
                .Where(t =>
                    !myRegistrationIds.Contains(t.Id) &&
                    (_isSuperAdmin || (t.GroupId.HasValue && accessibleGroupIds.Contains(t.GroupId.Value))) &&
                    (t.Status == TrainingStatus.Planned
                        ? t.DateTime <= now.AddDays(28)
                        : t.DateTime <= now.AddDays(4)))
                .ToList()
            : new List<TrainingDto>();

        if (_isGroupAdmin)
        {
            var utcToday = DateTime.UtcNow.Date;
            var dayOffset = utcToday.DayOfWeek == DayOfWeek.Sunday ? 6 : (int)utcToday.DayOfWeek - 1;
            var startOfWeek = utcToday.AddDays(-dayOffset);
            var planningOverviewTrainings = _isSuperAdmin
                ? (await TrainingService.GetAllAsync())
                : (await TrainingService.GetActiveAsync());

            _planningOverviewByGroup = planningOverviewTrainings
                .Where(t => t.DateTime.Date >= startOfWeek &&
                            t.GroupId.HasValue &&
                            (_isSuperAdmin || accessibleGroupIds.Contains(t.GroupId.Value)))
                .OrderBy(t => t.DateTime)
                .GroupBy(t => t.GroupName ?? "Unknown Group")
                .ToDictionary(g => g.Key, g => g.ToList());

            var pendingUsers = (await UserRegistrationService.GetPendingApprovalsAsync()).ToList();
            var allGroups = (await GroupService.GetAllAsync()).ToDictionary(g => g.Id, g => g.Name);
            _outstandingApprovals = new List<OutstandingApprovalViewModel>();

            foreach (var pendingUser in pendingUsers)
            {
                var membership = (await GroupService.GetAllMembershipsForUserAsync(pendingUser.Id))
                    .FirstOrDefault(m => m.Status == GroupMembershipStatus.Pending);
                var requestedGroup = membership is null
                    ? "Unknown"
                    : allGroups.TryGetValue(membership.GroupId, out var groupName) ? groupName : $"Group #{membership.GroupId}";

                _outstandingApprovals.Add(new OutstandingApprovalViewModel(pendingUser.DisplayName, requestedGroup));
            }
        }
        else
        {
            _planningOverviewByGroup.Clear();
            _outstandingApprovals.Clear();
        }

        if (_isSuperAdmin)
        {
            _mailConfigurationCount = (await MailConfigurationService.GetAllAsync()).Count;
            _locationCount = (await LocationService.GetAllAsync()).Count();
            _groupCount = (await GroupService.GetAllAsync()).Count();
            _userCount = (await UserService.GetAllAsync()).Count();
            _trainingCount = (await TrainingService.GetAllAsync()).Count();

            _notificationPointerLogId = await NotificationLogService.GetResetPointerLogIdAsync();
            _recentLogs = await NotificationLogService.GetRecentLogsAsync(50, _notificationPointerLogId);
            _notificationSuccessCount = _recentLogs.Count(x => x.IsSuccess);
            _notificationFailureCount = _recentLogs.Count(x => !x.IsSuccess);
        }
        else
        {
            _mailConfigurationCount = 0;
            _locationCount = 0;
            _groupCount = 0;
            _userCount = 0;
            _trainingCount = 0;
        }
    }

    private async Task ResendVerificationAsync()
    {
        _verificationActionMessage = null;
        try
        {
            await UserRegistrationService.ResendEmailConfirmationAsync(_userId);
            _verificationActionSuccess = true;
            _verificationActionMessage = "Verification email sent.";
        }
        catch (Exception ex)
        {
            _verificationActionSuccess = false;
            _verificationActionMessage = $"Failed to resend verification email: {ex.Message}";
        }
    }

    private void ToggleNotifications()
    {
        _notificationsExpanded = !_notificationsExpanded;
    }

    private void TogglePlanningOverview()
    {
        _planningOverviewExpanded = !_planningOverviewExpanded;
    }

    private async Task RegisterForTrainingAsync(int trainingId)
    {
        _availableTrainingActionMessage = null;

        try
        {
            await RegistrationService.RegisterAsync(_userId, trainingId);
            await LoadAsync();
            _availableTrainingActionError = false;
            _availableTrainingActionMessage = "Successfully registered.";
        }
        catch (Exception ex)
        {
            _availableTrainingActionError = true;
            _availableTrainingActionMessage = ex.Message;
        }
    }

    private string FormatTrainingDate(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return training.DateTime.ToString("g", culture);
    }

    private string FormatDashboardDateTime(TrainingDto training)
    {
        var culture = DateTimeFormatService.GetCultureForCountry(training.GroupCountry ?? _userCountry);
        return training.DateTime.ToString("dd.MM. HH:mm", culture);
    }

    private static string GetStatusBadgeClass(TrainingStatus status) => status switch
    {
        TrainingStatus.Planned => "bg-success",
        TrainingStatus.Planning => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private async Task ResetNotificationPointerAsync()
    {
        var latestLogId = _recentLogs.Any() ? _recentLogs.Max(x => x.Id) : _notificationPointerLogId;
        await NotificationLogService.SetResetPointerLogIdAsync(latestLogId);
        await LoadAsync();
    }
}
