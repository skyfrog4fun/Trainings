@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "GroupAdmin")]
@using System.Globalization
@inject IGroupService GroupService
@inject ILocationService LocationService
@inject ICountryService CountryService
@inject IDateTimeFormatService DateTimeFormatService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["Groups"]</PageTitle>

<div class="container px-2 px-md-4">
    <div class="d-flex justify-content-between align-items-center my-3">
        <h2>@Localizer["Groups"]</h2>
        <button class="btn btn-app-primary" @onclick="ShowCreateForm"><i class="@AppIcons.Plus me-1" aria-hidden="true"></i>@Localizer["Add"]</button>
    </div>

    @if (_showForm)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@(_editGroupId == 0 ? Localizer["CreateGroup"] : Localizer["EditGroup"])</h5>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer["Name"]</label>
                        <input class="form-control" @bind="_formName" placeholder='@Localizer["GroupName"]' />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Localizer["Slug"]</label>
                        <input class="form-control" @bind="_formSlug" placeholder='@Localizer["GroupSlugExample"]' />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">&nbsp;</label>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" @bind="_formIsActive" id="grpActive" />
                            <label class="form-check-label" for="grpActive">@Localizer["Active"]</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Localizer["Description"]</label>
                        <textarea class="form-control" rows="2" @bind="_formDescription"></textarea>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["Location"]</label>
                        <select class="form-select" @bind="_formLocationId">
                            <option value="">@Localizer["SelectLocation"]</option>
                            @foreach (var location in _formLocations)
                            {
                                <option value="@location.Id">@(string.IsNullOrWhiteSpace(location.CityName) ? location.Name : $"{location.Name} – {location.CityName}")</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["MaxParticipants"]</label>
                        <input class="form-control" type="number" min="1" @bind="_formMaxParticipants" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["Weekday"]</label>
                        <select class="form-select" @bind="_formWeekday" @bind:after="CalculateGroupEndTime">
                            <option value="">@Localizer["SelectDay"]</option>
                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                            {
                                <option value="@day">@day</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["Start"]</label>
                        <input class="form-control" type="time" @bind="_formStartTime" @bind:after="CalculateGroupEndTime" />
                        <div class="form-text">@Localizer["Localized"]: @FormatLocalizedTime(_formStartTime)</div>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["DurationMinutes"]</label>
                        <input class="form-control" type="number" min="1" @bind="FormDurationMinutesValue" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["End"]</label>
                        <input class="form-control" type="time" value="@_formEndTime" readonly />
                        <div class="form-text">@Localizer["Localized"]: @FormatLocalizedEndTime()</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["Country"]</label>
                        <select class="form-select" @bind="_formCountryId">
                            <option value="">@Localizer["SelectCountry"]</option>
                            @foreach (var country in _countries)
                            {
                                <option value="@country.Id">@country.Code — @country.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="SaveGroup"><i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Save"]</button>
                    <button class="btn btn-secondary" @onclick="CancelForm"><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Cancel"]</button>
                </div>
                @if (_formError != null)
                {
                    <div class="alert alert-danger mt-2">@_formError</div>
                }
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else
    {
        <div class="app-overview-grid">
            @foreach (var group in _groups)
            {
                <div class="app-overview-card">
                    <div class="app-overview-main">
                        <div class="app-overview-title text-break">@group.Name</div>
                        <div class="app-overview-meta">@(string.IsNullOrWhiteSpace(group.Description) ? "-" : group.Description)</div>
                        <div class="app-overview-meta mt-1">
                            <span class="me-3"><i class="@AppIcons.Participants me-1" aria-hidden="true"></i>@group.MemberCount</span>
                            @if (group.IsActive)
                            {
                                <span><i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span><i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["No"]</span>
                            }
                        </div>
                    </div>
                    <div class="app-overview-actions">
                        <a href="/groups/@group.Slug/members" class="btn btn-sm btn-app-icon btn-app-outline-primary" title='@Localizer["View"]' aria-label='@Localizer["View"]'>
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </a>
                        <button class="btn btn-sm btn-app-icon btn-app-outline-secondary" title='@Localizer["Edit"]' aria-label='@Localizer["Edit"]' @onclick="() => EditGroup(group)">
                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        </button>
                        <button class="btn btn-sm btn-app-icon btn-app-outline-danger" title='@Localizer["Delete"]' aria-label='@Localizer["Delete"]' @onclick="() => DeleteGroup(group)">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        @if (!_groups.Any())
        {
            <div class="alert alert-info">@Localizer["NoGroupsYet"]</div>
        }
    }
</div>

@code {
    private List<GroupDto> _groups = new();
    private List<LocationDto> _locations = new();
    private List<LocationDto> _formLocations = new();
    private List<CountryDto> _countries = new();
    private bool _loading = true;
    private bool _showForm;
    private int _editGroupId;
    private string _formName = string.Empty;
    private string _formSlug = string.Empty;
    private string _formDescription = string.Empty;
    private bool _formIsActive = true;
    private DayOfWeek? _formWeekday;
    private int? _formLocationId;
    private TimeOnly? _formStartTime = new(19, 0);
    private int? _formDurationMinutes = 90;
    private string _formEndTime = "20:30";
    private int? _formMaxParticipants = 10;
    private int? _formCountryId;
    private string? _formError;

    private int? FormDurationMinutesValue
    {
        get => _formDurationMinutes;
        set
        {
            _formDurationMinutes = value;
            CalculateGroupEndTime();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();

        if (ShouldOpenCreateFormFromQuery())
        {
            ShowCreateForm();
        }
    }

    private async Task LoadGroups()
    {
        _loading = true;
        _groups = (await GroupService.GetAllAsync()).ToList();
        _locations = (await LocationService.GetAllAsync()).Where(l => l.IsActive && !l.IsSystemWide).OrderBy(l => l.Name).ToList();
        _countries = (await CountryService.GetAllAsync()).ToList();
        _loading = false;
    }

    private void ShowCreateForm()
    {
        _editGroupId = 0;
        _formName = _formSlug = _formDescription = string.Empty;
        _formIsActive = true;
        _formWeekday = null;
        _formLocationId = null;
        _formStartTime = new TimeOnly(19, 0);
        _formDurationMinutes = 90;
        _formCountryId = null;
        _formMaxParticipants = 10;
        _formError = null;
        _formLocations = _locations;
        CalculateGroupEndTime();
        _showForm = true;
    }

    private bool ShouldOpenCreateFormFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        if (!query.TryGetValue("create", out var createValue))
        {
            return false;
        }

        var value = createValue.ToString();
        return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) || value == "1";
    }

    private void EditGroup(GroupDto group)
    {
        _editGroupId = group.Id;
        _formName = group.Name;
        _formSlug = group.Slug;
        _formDescription = group.Description ?? string.Empty;
        _formIsActive = group.IsActive;
        _formWeekday = group.Weekday;
        _formLocationId = group.LocationId;
        _formStartTime = group.StartTime ?? new TimeOnly(19, 0);
        _formDurationMinutes = group.DurationMinutes ?? 90;
        _formCountryId = group.CountryId;
        _formMaxParticipants = group.MaxParticipants;
        _formError = null;
        _formLocations = group.AllowedLocationIds.Count > 0
            ? _locations.Where(l => group.AllowedLocationIds.Contains(l.Id)).ToList()
            : _locations;
        CalculateGroupEndTime();
        _showForm = true;
    }

    private void CalculateGroupEndTime()
    {
        var duration = _formDurationMinutes.GetValueOrDefault(0);
        if (duration <= 0)
        {
            duration = 1;
        }

        var start = _formStartTime ?? new TimeOnly(19, 0);

        _formEndTime = start.AddMinutes(duration).ToString("HH:mm");
    }

    private CultureInfo GetSelectedGroupCulture()
    {
        var countryCode = _countries.FirstOrDefault(c => c.Id == _formCountryId)?.Code
            ?? DateTimeFormatService.GetDefaultCountry();
        return DateTimeFormatService.GetCultureForCountry(countryCode);
    }

    private string FormatLocalizedTime(TimeOnly? value)
    {
        var time = value ?? new TimeOnly(19, 0);
        return time.ToString("t", GetSelectedGroupCulture());
    }

    private string FormatLocalizedEndTime()
    {
        if (!TimeOnly.TryParse(_formEndTime, out var parsed))
        {
            return _formEndTime;
        }

        return parsed.ToString("t", GetSelectedGroupCulture());
    }

    private async Task SaveGroup()
    {
        _formError = null;

        var startTime = _formStartTime;

        try
        {
            if (_editGroupId == 0)
            {
                await GroupService.CreateAsync(new CreateGroupDto
                {
                    Name = _formName,
                    Slug = string.IsNullOrWhiteSpace(_formSlug) ? null : _formSlug,
                    Description = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription,
                    Weekday = _formWeekday,
                    LocationId = _formLocationId,
                    StartTime = startTime,
                    DurationMinutes = _formDurationMinutes,
                    MaxParticipants = _formMaxParticipants,
                    CountryId = _formCountryId,
                    AllowedLocationIds = []
                });
            }
            else
            {
                var group = _groups.First(g => g.Id == _editGroupId);
                await GroupService.UpdateAsync(new UpdateGroupDto
                {
                    Id = _editGroupId,
                    Name = _formName,
                    Slug = string.IsNullOrWhiteSpace(_formSlug) ? null : _formSlug,
                    Description = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription,
                    Weekday = _formWeekday,
                    LocationId = _formLocationId,
                    StartTime = startTime,
                    DurationMinutes = _formDurationMinutes,
                    MaxParticipants = _formMaxParticipants,
                    CountryId = _formCountryId,
                    AllowedLocationIds = group.AllowedLocationIds,
                    IsActive = _formIsActive
                });
            }

            _showForm = false;
            await LoadGroups();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
    }

    private async Task DeleteGroup(GroupDto group)
    {
        await GroupService.DeleteAsync(group.Id);
        await LoadGroups();
    }

    private void CancelForm() => _showForm = false;
}
