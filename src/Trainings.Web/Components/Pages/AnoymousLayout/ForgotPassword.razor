@page "/forgot-password"
@layout AnonymousLayout
@attribute [AllowAnonymous]

@rendermode InteractiveServer

@inject IPasswordResetService PasswordResetService
@inject IAppRuntimeModeService AppRuntimeModeService

<PageTitle>@Localizer["ForgotPassword_PageTitle"]</PageTitle>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3">@Localizer["ForgotPassword_Title"]</h4>

                    @if (_submitted)
                    {
                        <div class="alert alert-success">
                            @Localizer["ForgotPassword_SuccessMessage"]
                        </div>
                        <a href="/login" class="btn btn-outline-primary w-100">@Localizer["ForgotPassword_BackToLogin"]</a>
                    }
                    else
                    {
                        @if (_runtimeMode.IsReadOnly)
                        {
                            <div class="alert alert-warning">
                                @Localizer["ForgotPassword_ReadOnlyModeMessage"]
                            </div>
                        }

                        <p class="text-muted small">@Localizer["ForgotPassword_Description"]</p>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["ForgotPassword_EmailLabel"]</label>
                            <input type="email" class="form-control form-control-lg" @bind="_email" placeholder="@Localizer["ForgotPassword_EmailPlaceholder"]" />
                        </div>
                        @if (_error != null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }
                        <button class="btn btn-primary btn-lg w-100" @onclick="Submit" disabled="@(_loading || _runtimeMode.IsReadOnly)">
                            @if (_loading) { <LoadingSpinner Inline="true" Small="true" SpinnerClass="me-1" /> }
                            @Localizer["ForgotPassword_SendResetLink"]
                        </button>
                        <div class="mt-3 text-center">
                            <a href="/login" class="text-decoration-none small">@Localizer["ForgotPassword_BackToLogin"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private bool _loading, _submitted;
    private string? _error;
    private AppRuntimeModeDto _runtimeMode = new();

    protected override void OnInitialized()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
    }

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = Localizer["ForgotPassword_EmailRequired"];
            return;
        }

        _loading = true;
        try
        {
            await PasswordResetService.RequestResetAsync(_email);
            _submitted = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
