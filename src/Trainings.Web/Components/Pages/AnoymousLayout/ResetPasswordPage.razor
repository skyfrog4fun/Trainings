@page "/reset-password"
@layout AnonymousLayout
@attribute [AllowAnonymous]

@rendermode InteractiveServer

@inject IPasswordResetService PasswordResetService

<PageTitle>@Localizer["ResetPasswordPage_PageTitle"]</PageTitle>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3">@Localizer["ResetPasswordPage_Title"]</h4>

                    @if (_success)
                    {
                        <div class="alert alert-success">
                            @Localizer["ResetPasswordPage_SuccessMessage"]
                        </div>
                        <a href="/login" class="btn btn-primary w-100">@Localizer["ResetPasswordPage_LoginLink"]</a>
                    }
                    else if (string.IsNullOrEmpty(_token))
                    {
                        <div class="alert alert-danger">@Localizer["ResetPasswordPage_InvalidToken"]</div>
                        <a href="/forgot-password" class="btn btn-outline-primary w-100">@Localizer["ResetPasswordPage_RequestNewLink"]</a>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">@Localizer["ResetPasswordPage_NewPasswordLabel"]</label>
                            <input type="password" class="form-control form-control-lg" @bind="_newPassword" placeholder="@Localizer["ResetPasswordPage_NewPasswordPlaceholder"]" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["ResetPasswordPage_ConfirmPasswordLabel"]</label>
                            <input type="password" class="form-control form-control-lg" @bind="_confirmPassword" placeholder="@Localizer["ResetPasswordPage_ConfirmPasswordPlaceholder"]" />
                        </div>
                        @if (_error != null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }
                        <button class="btn btn-primary btn-lg w-100" @onclick="Submit" disabled="@_loading">
                            @if (_loading) { <LoadingSpinner Inline="true" Small="true" SpinnerClass="me-1" /> }
                            @Localizer["ResetPasswordPage_Button"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _token = "";
    private string _newPassword = "", _confirmPassword = "";
    private bool _loading, _success;
    private string? _error;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        _token = query.TryGetValue("token", out var t) ? t.ToString() : "";
    }

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = Localizer["ResetPasswordPage_NewPasswordRequired"];
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _error = Localizer["ResetPasswordPage_PasswordsDoNotMatch"];
            return;
        }
        if (_newPassword.Length < 6)
        {
            _error = Localizer["ResetPasswordPage_PasswordTooShort"];
            return;
        }

        _loading = true;
        try
        {
            await PasswordResetService.ResetPasswordAsync(_token, _newPassword);
            _success = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}

