@page "/trainings/{Slug}/{Id:int}"

@namespace Trainings.Web.Components.Pages.TrainingsPages

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupMember")]

@using Trainings.Web.Auth

@inject ITrainingService TrainingService
@inject IRegistrationService RegistrationService
@inject IUserService UserService
@inject IGroupService GroupService
@inject IEmailService EmailService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(_training?.Title ?? Localizer["TrainingDetailPage_PageTitleFallback"].Value)</PageTitle>

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<div class="container px-2 px-md-4">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_training == null)
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-info")">@(_message ?? Localizer["TrainingDetailPage_NotFound"].Value)</div>
    }
    else
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["TrainingDetailPage_Back"]" OnButtonClick="GoBack" />

        <CardComponent Collapsed="false" ShowFooter="@(ShowManagementRow || ShowParticipationRow || ShowTrainerOpsRow)">
            <Title>@Localizer["TrainingDetailPage_InfoTitle"]</Title>
            <TitleMeta><span class="badge @GetStatusBadgeClass(_training.Status)">@_training.Status</span></TitleMeta>
            <Body>
                <div class="text-muted mb-3">
                    @if (_training.GroupName != null)
                    {
                        <div class="mb-2"><i class="@AppIcons.Group me-1" aria-hidden="true"></i>@_training.GroupName</div>
                    }
                    <div class="mb-2"><i class="@AppIcons.Calendar me-1" aria-hidden="true"></i>@FormatTrainingDateRange(_training)</div>
                    <div class="mb-2"><i class="@AppIcons.Location me-1" aria-hidden="true"></i>@FormatLocation(_training)</div>
                    @if (_fullDetailAllowed && !string.IsNullOrWhiteSpace(_training.SpecialLocationDescription))
                    {
                        <div class="mb-2"><i class="@AppIcons.LocationCrosshairs me-1" aria-hidden="true"></i>@_training.SpecialLocationDescription</div>
                    }
                    @if (_fullDetailAllowed && !string.IsNullOrWhiteSpace(_training.MeetingPoint))
                    {
                        <div class="mb-2"><i class="@AppIcons.MapPin me-1" aria-hidden="true"></i>@_training.MeetingPoint</div>
                    }
                    <div class="mb-2">
                        <i class="@AppIcons.User me-1" aria-hidden="true"></i>
                        @(_training.TrainerId.HasValue ? string.Format(Localizer["TrainingDetailPage_TrainerLabel"].Value, _training.TrainerName) : Localizer["TrainingDetailPage_Unassigned"].Value)
                    </div>
                    <div><i class="@AppIcons.Users me-1" aria-hidden="true"></i>@string.Format(Localizer["TrainingDetailPage_RegisteredCount"].Value, _training.RegisteredCount, _training.Capacity)</div>
                </div>

                @if (!_fullDetailAllowed)
                {
                    <div class="alert alert-info mb-0">@Localizer["TrainingDetailPage_LimitedPreviewNotice"]</div>
                }
                else if (!string.IsNullOrWhiteSpace(_training.Description))
                {
                    <div class="mt-3">
                        <div class="text-muted fw-normal mb-1">@Localizer["TrainingDetailPage_DescriptionLabel"]</div>
                        <ExpandableTextComponent Text="@_training.Description"
                                                  MaxLines="3"
                                                  StartCollapsed="true"
                                                  ShowMoreLabel="@Localizer["Shared_ShowMore"]"
                                                  ShowLessLabel="@Localizer["Shared_ShowLess"]" />
                    </div>
                }
            </Body>
            <Footer>
                @if (ShowManagementRow)
                {
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <a href="@TrainingEditUrl()" class="btn btn-sm btn-primary">
                            <i class="@AppIcons.Edit me-1" aria-hidden="true"></i>@Localizer["Shared_Edit"]
                        </a>
                        @if (_isAdmin)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="PromptDeleteTraining" disabled="@_deleteInProgress">
                                <i class="@AppIcons.Trash me-1" aria-hidden="true"></i>@Localizer["Shared_Delete"]
                            </button>
                        }
                    </div>
                }
                @if (ShowManagementRow && ShowParticipationRow)
                {
                    <hr class="my-2" />
                }
                @if (ShowParticipationRow)
                {
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            @if (_canTake)
                            {
                                <button type="button" class="btn btn-sm btn-success" @onclick="TakeTraining">
                                    <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_Take"]
                                </button>
                            }
                        </div>
                        <div>
                            @if (_canRegister)
                            {
                                @if (_isRegistered)
                                {
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="PromptSelfUnregister">
                                        <i class="@AppIcons.Unregister me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_Unregister"]
                                    </button>
                                }
                                else if (_training.RegisteredCount < _training.Capacity)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="Register">
                                        <i class="@AppIcons.Register me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_Register"]
                                    </button>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["TrainingDetailPage_TrainingFull"]</span>
                                }
                            }
                        </div>
                    </div>
                }
                @if (ShowParticipationRow && ShowTrainerOpsRow)
                {
                    <hr class="my-2" />
                }
                @if (ShowTrainerOpsRow)
                {
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            @if (_training.Status is TrainingStatus.Planned or TrainingStatus.InProgress or TrainingStatus.Done)
                            {
                                <a href="@TrainingRunUrl()" class="btn btn-sm btn-success">
                                    <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_Run"]
                                </a>
                            }
                        </div>
                        <div>
                            @if (_training.Status is TrainingStatus.InProgress or TrainingStatus.Done)
                            {
                                <a href="@TrainingAttendanceUrl()" class="btn btn-sm btn-primary">
                                    <i class="@AppIcons.ListCheck me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_Attendance"]
                                </a>
                            }
                        </div>
                    </div>
                }
            </Footer>
        </CardComponent>

        @if (_fullDetailAllowed)
        {
            <CardComponent Collapsed="false">
                <Title>@Localizer["TrainingDetailPage_RegisteredParticipants"]</Title>
                <TitleMeta>@RegisteredParticipants.Count / @_training.Capacity</TitleMeta>
                <Body>
                    @if (_isAdmin)
                    {
                        <div class="d-flex justify-content-end mb-3">
                            <button type="button" class="btn btn-success btn-sm" @onclick="ToggleAddParticipantForm">
                                <i class="@AppIcons.Plus me-1" aria-hidden="true"></i>@Localizer["TrainingDetailPage_AddParticipant"]
                            </button>
                        </div>
                    }

                    @if (_isAdmin && _showAddParticipantForm)
                    {
                        <CardComponent Collapsed="false" IsCollapsable="false" ShowFooter="true" CssClass="mb-3">
                            <Title>@Localizer["TrainingDetailPage_AddParticipant"]</Title>
                            <Body>
                                <SelectDropdownComponent TItem="GroupMembershipDto" TValue="int?"
                                                         @bind-Value="_addParticipantUserId"
                                                         Items="_eligibleParticipants"
                                                         ValueSelector="m => (int?)m.UserId"
                                                         TextSelector="@(m => m.UserDisplayName)"
                                                         SubTextSelector="@(m => m.UserEmail)"
                                                         Searchable="true"
                                                         SearchPlaceholder="@Localizer["TrainingDetailPage_SearchParticipantPlaceholder"]"
                                                         NoResultsText="@Localizer["TrainingDetailPage_NoParticipantsFound"]"
                                                         PlaceholderText="@Localizer["TrainingDetailPage_SelectParticipant"]" />
                                @if (_eligibleParticipants.Count == 0)
                                {
                                    <div class="form-text text-muted">@Localizer["TrainingDetailPage_NoEligibleParticipants"]</div>
                                }
                            </Body>
                            <Footer>
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-primary btn-sm" @onclick="AddParticipant">@Localizer["TrainingDetailPage_AddButton"]</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelAddParticipant">@Localizer["TrainingDetailPage_CancelButton"]</button>
                                </div>
                            </Footer>
                        </CardComponent>
                    }

                    @if (RegisteredParticipants.Any())
                    {
                        <div class="app-overview-grid">
                            @foreach (var reg in RegisteredParticipants)
                            {
                                <div class="app-overview-card">
                                    <div class="app-overview-main w-100 d-flex flex-row justify-content-between align-items-center gap-2">
                                        <div class="app-overview-title text-break">@reg.UserName</div>
                                        <div class="app-overview-meta text-nowrap">@FormatRegisteredAt(reg.RegisteredAt)</div>
                                    </div>
                                    @if (CanActOnParticipant(reg))
                                    {
                                        <div class="app-overview-actions app-overview-actions-center">
                                            <button type="button" class="btn btn-sm btn-app-icon btn-app-outline-danger" title="@Localizer["TrainingDetailPage_Unregister"]" aria-label="@Localizer["TrainingDetailPage_Unregister"]" @onclick="() => PromptParticipantUnregister(reg)">
                                                <i class="@AppIcons.Unregister" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">@Localizer["TrainingDetailPage_NoOneSignedUpYet"]</div>
                    }
                </Body>
            </CardComponent>

            @if (_training.Blocks.Any())
            {
                <CardComponent Collapsed="false">
                    <Title>@string.Format(Localizer["TrainingDetailPage_TrainingBlocksHeading"].Value, _training.Blocks.Count)</Title>
                    <Body>
                        <div class="row g-3">
                            @for (var i = 0; i < _training.Blocks.Count; i++)
                            {
                                var block = _training.Blocks[i];
                                var num = i + 1;
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h6 class="card-title">@num. @block.Title</h6>
                                            @if (!string.IsNullOrEmpty(block.Description))
                                            {
                                                <p class="card-text text-muted small">@block.Description</p>
                                            }
                                            <div class="small text-muted">
                                                <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>@string.Format(Localizer["TrainingDetailPage_PlannedMinutes"].Value, block.PlannedDurationMinutes)
                                                @if (block.EffectiveDurationMinutes.HasValue)
                                                {
                                                    <text> · @string.Format(Localizer["TrainingDetailPage_ActualMinutes"].Value, block.EffectiveDurationMinutes)</text>
                                                }
                                            </div>
                                            @if (block.Tags.Any())
                                            {
                                                <div class="mt-2">
                                                    @foreach (var tag in block.Tags)
                                                    {
                                                        <span class="badge bg-info text-dark me-1">@tag.Name</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </Body>
                </CardComponent>
            }
        }
    }
</div>

<ConfirmDialogComponent IsVisible="_showDeleteConfirm"
                        Title="@Localizer["TrainingDetailPage_DeleteConfirmTitle"]"
                        Message="@FormatDeleteConfirmMessage()"
                        ConfirmText="@Localizer["Shared_Delete"]"
                        CancelText="@Localizer["Shared_Cancel"]"
                        SecondaryConfirmText="@(HasRegisteredParticipants ? Localizer["TrainingDetailPage_NotifyAndDelete"].Value : null)"
                        IsBusy="_deleteInProgress"
                        OnConfirm="DeleteTraining"
                        OnCancel="CancelDeleteTraining"
                        OnSecondaryConfirm="NotifyAndDeleteTraining" />

<ConfirmDialogComponent IsVisible="_showUnregisterConfirm"
                        Title="@Localizer["TrainingDetailPage_UnregisterConfirmTitle"]"
                        Message="@FormatUnregisterConfirmMessage()"
                        ConfirmText="@Localizer["TrainingDetailPage_Unregister"]"
                        CancelText="@Localizer["Shared_Cancel"]"
                        OnConfirm="ConfirmUnregisterAsync"
                        OnCancel="CancelUnregisterConfirm" />

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private TrainingDto? _training;
    private bool _loading = true;
    private bool _isRegistered;
    private bool _isTrainer;
    private bool _isAdmin;
    private bool _isAssignedTrainer;
    private bool _canRegister;
    private bool _canTake;
    private bool _fullDetailAllowed;
    private bool _showDeleteConfirm;
    private bool _deleteInProgress;
    private int _userId;
    private List<RegistrationDto> _registrations = new();
    private List<GroupMembershipDto> _groupMembers = new();
    private List<GroupMembershipDto> _eligibleParticipants = new();
    private bool _showAddParticipantForm;
    private int? _addParticipantUserId;
    private bool _showUnregisterConfirm;
    private int? _pendingUnregisterUserId;
    private string? _pendingUnregisterUserName;
    private string? _message;
    private bool _isError;
    private ToastComponent? _toast;

    private List<RegistrationDto> RegisteredParticipants =>
        _registrations.Where(registration => registration.Status == RegistrationStatus.Registered).ToList();
    private bool HasRegisteredParticipants => RegisteredParticipants.Count > 0;
    private RegistrationDto? OwnRegistration => RegisteredParticipants.FirstOrDefault(r => r.UserId == _userId);
    private bool ShowManagementRow => _isAdmin || _isAssignedTrainer;
    private bool ShowParticipationRow => _canTake || _canRegister;
    private bool ShowTrainerOpsRow => _isAssignedTrainer &&
        _training is not null &&
        _training.Status is TrainingStatus.Planned or TrainingStatus.InProgress or TrainingStatus.Done;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _showDeleteConfirm = false;
        _showUnregisterConfirm = false;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var isSuperAdmin = user.HasClaim(AppClaimTypes.SuperAdmin, "true");

        _userId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

        _training = await TrainingService.GetByIdAsync(Id);
        if (_training == null)
        {
            _loading = false;
            return;
        }

        _isAdmin = isSuperAdmin || user.HasClaim(AppClaimTypes.GroupRole(_training.GroupId), "Admin");
        _isTrainer = _isAdmin || user.HasClaim(AppClaimTypes.GroupRole(_training.GroupId), "Trainer");
        _isAssignedTrainer = _isTrainer && _training.TrainerId == _userId;
        _canRegister = isSuperAdmin || user.Claims.Any(claim =>
            claim.Type == AppClaimTypes.GroupRole(_training.GroupId) &&
            (claim.Value == "Participant" || claim.Value == "Trainer" || claim.Value == "Admin"));

        _fullDetailAllowed = _isTrainer || _isAdmin || _training.Status >= TrainingStatus.Planned;
        _canTake = _isTrainer && !_training.TrainerId.HasValue && _training.Status == TrainingStatus.New;

        if (_canRegister && _userId > 0)
        {
            _isRegistered = await RegistrationService.IsRegisteredAsync(_userId, Id);
        }
        else
        {
            _isRegistered = false;
        }

        _registrations = (await RegistrationService.GetByTrainingIdAsync(Id)).ToList();

        if (_isAdmin)
        {
            _groupMembers = (await GroupService.GetMembersAsync(_training.GroupId))
                .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive)
                .GroupBy(m => m.UserId)
                .Select(g => g.First())
                .ToList();
            UpdateEligibleParticipants();
        }

        _loading = false;
    }

    private void UpdateEligibleParticipants()
    {
        var registeredUserIds = RegisteredParticipants.Select(r => r.UserId).ToHashSet();
        _eligibleParticipants = _groupMembers
            .Where(m => !registeredUserIds.Contains(m.UserId))
            .OrderBy(m => m.UserDisplayName)
            .ToList();

        if (_addParticipantUserId is not null && !_eligibleParticipants.Any(m => m.UserId == _addParticipantUserId))
        {
            _addParticipantUserId = null;
        }
    }

    private void ToggleAddParticipantForm()
    {
        _showAddParticipantForm = !_showAddParticipantForm;
        if (_showAddParticipantForm)
        {
            UpdateEligibleParticipants();
        }
    }

    private void CancelAddParticipant()
    {
        _showAddParticipantForm = false;
        _addParticipantUserId = null;
    }

    private async Task AddParticipant()
    {
        if (!_isAdmin || _training is null)
        {
            return;
        }

        if (_addParticipantUserId is null)
        {
            await ShowToastAsync(Localizer["TrainingDetailPage_SelectParticipantError"], ToastComponent.ToastVariant.Danger);
            return;
        }

        var addedMember = _groupMembers.FirstOrDefault(m => m.UserId == _addParticipantUserId);

        try
        {
            await RegistrationService.RegisterAsync(_addParticipantUserId.Value, Id);
            _showAddParticipantForm = false;
            _addParticipantUserId = null;
            await LoadAsync();
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_ParticipantAddedToast"].Value, addedMember?.UserDisplayName ?? string.Empty), ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_FailedMessage"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task Register()
    {
        try
        {
            await RegistrationService.RegisterAsync(_userId, Id);
            await LoadAsync();
            await ShowToastAsync(Localizer["TrainingDetailPage_SuccessfullyRegistered"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_FailedMessage"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task TakeTraining()
    {
        try
        {
            await TrainingService.TakeAsync(Id, _userId);
            await LoadAsync();
            await ShowToastAsync(Localizer["TrainingDetailPage_TakeSuccess"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_FailedMessage"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
    }

    private void PromptSelfUnregister()
    {
        var ownRegistration = OwnRegistration;
        if (ownRegistration is not null)
        {
            PromptParticipantUnregister(ownRegistration);
        }
    }

    private void PromptParticipantUnregister(RegistrationDto registration)
    {
        _showDeleteConfirm = false;
        _pendingUnregisterUserId = registration.UserId;
        _pendingUnregisterUserName = registration.UserName;
        _showUnregisterConfirm = true;
    }

    private string FormatUnregisterConfirmMessage() =>
        string.Format(Localizer["TrainingDetailPage_UnregisterConfirmMessage"].Value, _pendingUnregisterUserName ?? string.Empty);

    private async Task ConfirmUnregisterAsync()
    {
        _showUnregisterConfirm = false;

        if (!_pendingUnregisterUserId.HasValue)
        {
            return;
        }

        var unregisteredUserId = _pendingUnregisterUserId.Value;
        var unregisteredUserName = _pendingUnregisterUserName ?? string.Empty;
        var wasSelf = unregisteredUserId == _userId;
        _pendingUnregisterUserId = null;
        _pendingUnregisterUserName = null;

        if (!_isAdmin && !_isAssignedTrainer && !wasSelf)
        {
            await ShowToastAsync(Localizer["TrainingDetailPage_UnregisterNotAllowed"], ToastComponent.ToastVariant.Danger);
            return;
        }

        try
        {
            await RegistrationService.CancelAsync(unregisteredUserId, Id);
            await LoadAsync();
            await ShowToastAsync(
                wasSelf
                    ? Localizer["TrainingDetailPage_RegistrationCancelled"].Value
                    : string.Format(Localizer["TrainingDetailPage_ParticipantUnregisteredToast"].Value, unregisteredUserName),
                ToastComponent.ToastVariant.Info);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_FailedMessage"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
    }

    private void CancelUnregisterConfirm()
    {
        _showUnregisterConfirm = false;
        _pendingUnregisterUserId = null;
        _pendingUnregisterUserName = null;
    }

    private void PromptDeleteTraining()
    {
        _showUnregisterConfirm = false;
        _showDeleteConfirm = true;
    }

    private string FormatDeleteConfirmMessage() => HasRegisteredParticipants
        ? string.Format(Localizer["TrainingDetailPage_DeleteConfirmMessageWithParticipants"].Value, RegisteredParticipants.Count)
        : Localizer["TrainingDetailPage_DeleteConfirmMessage"].Value;

    private void CancelDeleteTraining()
    {
        _showDeleteConfirm = false;
    }

    private async Task DeleteTraining() => await DeleteTrainingInternalAsync(notifyParticipants: false);

    private async Task NotifyAndDeleteTraining() => await DeleteTrainingInternalAsync(notifyParticipants: true);

    private async Task DeleteTrainingInternalAsync(bool notifyParticipants)
    {
        if (_training is null)
        {
            return;
        }

        try
        {
            _deleteInProgress = true;

            if (notifyParticipants)
            {
                var appUrl = NavigationManager.BaseUri.TrimEnd('/');
                var recipientIds = _registrations
                    .Where(registration => registration.Status == RegistrationStatus.Registered)
                    .Select(registration => registration.UserId)
                    .ToHashSet();

                var recipientUsers = (await UserService.GetAllAsync())
                    .Where(user => recipientIds.Contains(user.Id) && !string.IsNullOrWhiteSpace(user.Email))
                    .ToList();

                foreach (var user in recipientUsers)
                {
                    var sendResult = await EmailService.SendTrainingCancellationAsync(
                        user.Email,
                        _training.Title,
                        _training.DateTime,
                        appUrl);

                    if (!sendResult.IsSuccess)
                    {
                        throw new InvalidOperationException(string.Format(Localizer["TrainingDetailPage_FailedToNotify"].Value, user.Email));
                    }
                }
            }

            await TrainingService.DeleteAsync(_training.Id);
            NavigationManager.NavigateTo("/trainings");
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["TrainingDetailPage_FailedMessage"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
        finally
        {
            _deleteInProgress = false;
        }
    }

    private static string FormatTrainingDateRange(TrainingDto training)
    {
        var start = training.DateTime;
        var text = start.ToString("dd.MM.yyyy HH:mm");
        if (training.DurationMinutes.HasValue)
        {
            var end = start.AddMinutes(training.DurationMinutes.Value);
            text += $" - {end:HH:mm}";
        }

        return text;
    }

    private static string FormatLocation(TrainingDto training)
    {
        if (string.IsNullOrWhiteSpace(training.LocationName))
        {
            return "-";
        }

        return string.IsNullOrWhiteSpace(training.LocationCity)
            ? training.LocationName
            : $"{training.LocationName}, {training.LocationCity}";
    }

    private static string FormatRegisteredAt(DateTime registeredAtUtc) =>
        DateTime.SpecifyKind(registeredAtUtc, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm");

    private string TrainingEditUrl() => $"/trainings/{_training!.GroupSlug}/{_training.Id}/edit";

    private string TrainingRunUrl() => $"/trainings/{_training!.GroupSlug}/{_training.Id}/run";

    private string TrainingAttendanceUrl() => $"/trainings/{_training!.GroupSlug}/{_training.Id}/attendance";

    private static string GetStatusBadgeClass(TrainingStatus status) => status switch
    {
        TrainingStatus.Planned => "bg-success",
        TrainingStatus.InPlanning => "bg-warning text-dark",
        TrainingStatus.InProgress => "bg-primary",
        TrainingStatus.Done => "bg-secondary",
        _ => "bg-light text-dark border"
    };

    private bool CanActOnParticipant(RegistrationDto registration) =>
        _isAdmin || _isAssignedTrainer || registration.UserId == _userId;

    private void GoBack() => NavigationManager.NavigateTo("/trainings");

    private async Task ShowToastAsync(string message, ToastComponent.ToastVariant variant)
    {
        if (_toast is not null)
        {
            await _toast.Show(message, variant);
        }
    }
}
