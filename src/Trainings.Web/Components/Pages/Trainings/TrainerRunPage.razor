@page "/trainings/{Slug}/{Id:int}/run"

@namespace Trainings.Web.Components.Pages.TrainingsPages

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupTrainer")]

@inject ITrainingService TrainingService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationHelper AuthorizationHelper

<PageTitle>@Localizer["TrainerRunPage_PageTitle"]</PageTitle>

<div class="container px-2 px-md-3">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["TrainerRunPage_AccessDenied"]</div>
    }
    else if (_training == null)
    {
        <div class="alert alert-danger">@Localizer["TrainerRunPage_TrainingNotFound"]</div>
    }
    else if (!_blocks.Any())
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />
        <div class="alert alert-warning mt-3">@Localizer["TrainerRunPage_NoBlocksWarning"] <a href="/trainings/@Slug/@Id/edit">@Localizer["TrainerRunPage_AddBlocksFirst"]</a></div>
    }
    else if (_training.Status is TrainingStatus.New or TrainingStatus.InPlanning)
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />
        <div class="alert alert-warning mt-3">@Localizer["TrainerRunPage_NotPlannedYet"]</div>
    }
    else if (_training.Status == TrainingStatus.Planned && !_previewMode)
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />
        <div class="card shadow-lg text-center">
            <div class="card-body py-5">
                <h4 class="mb-3">@Localizer["TrainerRunPage_ReadyToStart"]</h4>
                <div class="d-grid gap-2 col-12 col-sm-8 col-md-6 mx-auto">
                    <button type="button" class="btn btn-warning btn-lg mt-4" @onclick="EnterPreviewMode">
                        <i class="@AppIcons.Eye me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_PreviewBlocks"]
                    </button>
                    <button type="button" class="btn btn-success btn-lg mt-3" @onclick="StartTrainingAsync" disabled="@_starting">
                        @if (_starting) { <LoadingSpinner Inline="true" Small="true" SpinnerClass="me-1" /> }
                        <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_StartTraining"]
                    </button>
                </div>
                <div class="mt-2">
                    <ActionAlert IsSuccess="false" Message="@_startError" />
                </div>
            </div>
        </div>
    }
    else if (_currentIndex >= _blocks.Count)
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />
        <div class="card shadow-lg text-center">
            <div class="card-body py-5">
                @if (_training.Status == TrainingStatus.Planned)
                {
                    <h4 class="mb-3">@Localizer["TrainerRunPage_PlanReviewed"]</h4>
                    <p class="text-muted">@Localizer["TrainerRunPage_PlanReviewedHint"]</p>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ExitPreviewMode">
                        <i class="@AppIcons.Back me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_BackToStartScreen"]
                    </button>
                }
                else
                {
                    <h4 class="mb-3">@Localizer["TrainerRunPage_TrainingComplete"]</h4>
                    <p>@string.Format(Localizer["TrainerRunPage_AllBlocksFinished"].Value, _blocks.Count)</p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-3">
                        <a href="@($"/trainings/{Slug}/{Id}/attendance")" class="btn btn-primary">
                            <i class="@AppIcons.ListCheck me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_GoToAttendance"]
                        </a>
                        @if (_training.Status == TrainingStatus.Done)
                        {
                            <a href="@($"/trainings/{Slug}/{Id}/feedback")" class="btn btn-outline-primary">
                                <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_GoToFeedback"]
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary" disabled title="@Localizer["TrainerRunPage_FeedbackAvailableAfterDone"]">
                                <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_GoToFeedback"]
                            </button>
                        }
                    </div>
                }
                @if (_currentIndex > 0)
                {
                    <div class="mt-4">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousBlock">
                            <i class="@AppIcons.Back me-1" aria-hidden="true"></i>@Localizer["TrainerRunPage_Previous"]
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        var currentBlock = _blocks[_currentIndex];
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@_training.Title" ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />

        <div class="text-muted small mb-2">@string.Format(Localizer["TrainerRunPage_BlockOfCount"].Value, _currentIndex + 1, _blocks.Count)</div>
        <div class="progress progress-thin mb-3">
            <div class="progress-bar" style="width: @(((_currentIndex + 1) * 100) / (_blocks.Count + 1))%"></div>
        </div>

        <div class="card shadow-lg text-center">
            <div class="card-body py-5">
                <div class="text-muted small mb-2">@string.Format(Localizer["TrainerRunPage_BlockLabel"].Value, _currentIndex + 1)</div>
                <h2 class="card-title mb-3">@currentBlock.Title</h2>
                @if (!string.IsNullOrEmpty(currentBlock.Description))
                {
                    <p class="text-muted">@currentBlock.Description</p>
                }
                <div class="badge bg-light text-dark border fs-6 mb-4">
                    <i class="@AppIcons.CircleInfo me-1" aria-hidden="true"></i>@string.Format(Localizer["TrainerRunPage_DurationMinutesSuffix"].Value, currentBlock.PlannedDurationMinutes)
                </div>
                <div class="mb-3 text-muted small">@FormatBlockType(currentBlock)</div>
            </div>
            <div class="card-footer">
                <div class="d-flex gap-2">
                    @if (_currentIndex > 0)
                    {
                        <button class="btn btn-outline-secondary btn-lg" @onclick="PreviousBlock">
                            <i class="@AppIcons.Back" aria-hidden="true"></i>
                        </button>
                    }
                    <button class="btn btn-success btn-lg flex-fill" @onclick="NextBlock">
                        @Localizer["TrainerRunPage_NextBlock"]
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private TrainingDto? _training;
    private List<TrainingBlockDto> _blocks = new();
    private int _currentIndex;
    private bool _previewMode;
    private bool _loading = true;
    private bool _isAccessDenied;
    private bool _starting;
    private string? _startError;
    private int _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        _training = await TrainingService.GetByIdAsync(Id);
        if (_training != null)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _currentUserId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

            bool isAssignedTrainer = _training.TrainerId == _currentUserId;
            bool isGroupAdmin = AuthorizationHelper.IsGroupAdmin(user, _training.GroupId);
            if (!isAssignedTrainer && !isGroupAdmin)
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            _blocks = _training.Blocks.OrderBy(b => b.OrderIndex).ToList();
        }
        _loading = false;
    }

    // /run is purely navigational: the only state-changing call it ever makes is StartAsync,
    // which is the RUN action itself (Planned -> InProgress). Block browsing, forward/back
    // navigation, and the terminal step never touch training state.
    private async Task StartTrainingAsync()
    {
        if (_training == null)
        {
            return;
        }

        _starting = true;
        _startError = null;
        try
        {
            await TrainingService.StartAsync(_training.Id, _currentUserId);
            _training = await TrainingService.GetByIdAsync(Id);
            _previewMode = false;
            _currentIndex = 0;
        }
        catch (Exception ex)
        {
            _startError = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    private void GoBack() => NavigationManager.NavigateTo($"/trainings/{Slug}/{Id}");

    private void EnterPreviewMode()
    {
        _previewMode = true;
        _currentIndex = 0;
    }

    private void ExitPreviewMode()
    {
        _previewMode = false;
        _currentIndex = 0;
    }

    private void NextBlock()
    {
        if (_currentIndex < _blocks.Count)
        {
            _currentIndex++;
        }
    }

    private void PreviousBlock()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
        }
    }

    private static string FormatBlockType(TrainingBlockDto block)
        => block.GameDisplayText is null
            ? block.TagDisplayText
            : $"{block.TagDisplayText} · {block.GameDisplayText}";
}
