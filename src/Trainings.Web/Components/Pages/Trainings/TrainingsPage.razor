@page "/trainings"
@namespace Trainings.Web.Components.Pages.TrainingsPages

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupMember")]

@using Trainings.Web.Auth

@inject ITrainingService TrainingService
@inject IRegistrationService RegistrationService
@inject IUserService UserService
@inject IGroupService GroupService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@Localizer["Shared_Trainings"]</PageTitle>

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<div class="container-fluid px-2 px-md-4">
    <PageTitleComponent Icon="@AppIcons.Fire" Text="@Localizer["Shared_Trainings"]"
                        ButtonText="@(_canCreateTraining ? Localizer["Shared_Add"].Value : null)"
                        ButtonIcon="@AppIcons.Plus" OnButtonClick="GoToCreateTraining"
                        ShowFilterButton="true" @bind-FilterOpen="_showFilter"
                        OnApplyFilters="ApplyFilters" OnClearFilters="ClearFilters">
        <Filter>
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-6">
                    <select class="form-select" @bind="_pendingGroupId">
                        <option value="">@Localizer["TrainingsPage_AllGroups"]</option>
                        @foreach (var group in _filterGroups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <select class="form-select" @bind="_pendingTrainerId">
                        <option value="">@Localizer["TrainingsPage_AllTrainers"]</option>
                        <option value="-1">@Localizer["TrainingList_Unassigned"]</option>
                        @foreach (var trainer in _filterTrainers)
                        {
                            <option value="@trainer.Id">@trainer.Name</option>
                        }
                    </select>
                </div>
            </div>
        </Filter>
    </PageTitleComponent>


    @if (_loading)
    {
        <LoadingSpinner />
    }
    else
    {
        @if (FilteredRecentTrainings.Any())
        {
            <TrainingList Trainings="FilteredRecentTrainings" UserCountry="_userCountry" RegisteredTrainingIds="_registeredTrainingIds">
                <Actions Context="training">
                    <a href="/trainings/@training.Id" class="btn btn-sm btn-app-icon btn-app-outline-primary" title='@Localizer["Shared_View"]' aria-label='@Localizer["Shared_View"]'>
                        <i class="@AppIcons.Eye" aria-hidden="true"></i>
                    </a>
                    @if (CanTake(training))
                    {
                        <button type="button"
                                class="btn btn-sm btn-app-outline-success"
                                @onclick="() => TakeTrainingAsync(training)"
                                title='@Localizer["TrainingsPage_Take"]'
                                aria-label='@Localizer["TrainingsPage_Take"]'>
                            <i class="@AppIcons.Check me-1" aria-hidden="true"></i>@Localizer["TrainingsPage_Take"]
                        </button>
                    }
                    @if (CanRegister(training))
                    {
                        <button type="button"
                                class="btn btn-sm @(_registeredTrainingIds.Contains(training.Id) ? "btn-app-danger" : "btn-app-success") ms-auto"
                                @onclick="() => ToggleRegistrationAsync(training)"
                                disabled="@IsRegistrationDisabled(training)">
                            <i class="@(_registeredTrainingIds.Contains(training.Id) ? AppIcons.Unregister : AppIcons.Register) me-1" aria-hidden="true"></i>@(_registeredTrainingIds.Contains(training.Id) ? Localizer["Shared_Unregister"] : Localizer["Shared_Register"])
                        </button>
                    }
                </Actions>
            </TrainingList>
        }
        else if (FilteredArchivedTrainings.Any())
        {
            <div class="alert alert-info mt-3">@Localizer["TrainingsPage_NoRecentTrainingsMatchCurrentFilters"]</div>
        }
        else if (_showFilter)
        {
            <div class="alert alert-info mt-3">@Localizer["TrainingsPage_NoTrainingsMatchCurrentFilters"]</div>
        }
        else if (!_archivedTrainings.Any())
        {
            <div class="alert alert-info mt-3">@Localizer["TrainingsPage_NoTrainingsAvailable"]</div>
        }
        else
        {
            <div class="alert alert-info mt-3">@Localizer["TrainingsPage_NoTrainingsFromLastTwoWeeksAvailable"]</div>
        }

        @if (FilteredArchivedTrainings.Any())
        {
            <div class="card collapsible-card mt-4">
                <div class="card-header collapsible-card-header">
                    <button type="button" class="btn btn-link collapsible-card-toggle" @onclick="ToggleArchivedTrainings">
                        <span>@Localizer["TrainingsPage_OlderThanTwoWeeks"]</span>
                        <i class="@(_archivedTrainingsExpanded ? AppIcons.ChevronUp : AppIcons.ChevronDown)" aria-hidden="true"></i>
                    </button>
                    <div class="collapsible-card-meta">@Localizer["TrainingCount", FilteredArchivedTrainings.Count]</div>
                </div>
                @if (_archivedTrainingsExpanded)
                {
                    <div class="card-body">
                        <TrainingList Trainings="FilteredArchivedTrainings" UserCountry="_userCountry" RegisteredTrainingIds="_registeredTrainingIds">
                            <Actions Context="training">
                                <a href="/trainings/@training.Id" class="btn btn-sm btn-app-icon btn-app-outline-primary" title='@Localizer["Shared_View"]' aria-label='@Localizer["Shared_View"]'>
                                    <i class="@AppIcons.Eye" aria-hidden="true"></i>
                                </a>
                                @if (CanRegister(training))
                                {
                                    <button type="button"
                                            class="btn btn-sm @(_registeredTrainingIds.Contains(training.Id) ? "btn-app-danger" : "btn-app-success") ms-auto"
                                            @onclick="() => ToggleRegistrationAsync(training)"
                                            disabled="@IsRegistrationDisabled(training)">
                                        <i class="@(_registeredTrainingIds.Contains(training.Id) ? AppIcons.Unregister : AppIcons.Register) me-1" aria-hidden="true"></i>@(_registeredTrainingIds.Contains(training.Id) ? Localizer["Shared_Unregister"] : Localizer["Shared_Register"])
                                    </button>
                                }
                            </Actions>
                        </TrainingList>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private sealed record FilterOption(int Id, string Name);

    private List<TrainingDto> _recentTrainings = new();
    private List<TrainingDto> _archivedTrainings = new();
    private List<GroupDto> _filterGroups = new();
    private List<FilterOption> _filterTrainers = new();
    private HashSet<int> _registeredTrainingIds = new();
    private HashSet<int> _accessibleGroupIds = new();
    private HashSet<int> _adminGroupIds = new();
    private HashSet<int> _trainerGroupIds = new();
    private bool _loading = true;
    private bool _isSuperAdmin;
    private bool _canCreateTraining;
    private bool _archivedTrainingsExpanded;
    private bool _showFilter;
    private int _userId;
    private int? _pendingGroupId;
    private int? _pendingTrainerId;
    private int? _filterGroupId;
    private int? _filterTrainerId;
    private string _userCountry = "CH";
    private ToastComponent? _toast;

    private List<TrainingDto> FilteredRecentTrainings => ApplyFilters(_recentTrainings);
    private List<TrainingDto> FilteredArchivedTrainings => ApplyFilters(_archivedTrainings);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _isSuperAdmin = auth.User.HasClaim(AppClaimTypes.SuperAdmin, "true");
        _accessibleGroupIds = auth.User.Claims
            .Where(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal))
            .Select(c => int.TryParse(c.Type[AppClaimTypes.GroupRolePrefix.Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();
        _adminGroupIds = auth.User.Claims
            .Where(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Admin")
            .Select(c => int.TryParse(c.Type[AppClaimTypes.GroupRolePrefix.Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();
        _trainerGroupIds = auth.User.Claims
            .Where(c => c.Type.StartsWith(AppClaimTypes.GroupRolePrefix, StringComparison.Ordinal) && c.Value == "Trainer")
            .Select(c => int.TryParse(c.Type[AppClaimTypes.GroupRolePrefix.Length..], out var groupId) ? groupId : 0)
            .Where(groupId => groupId > 0)
            .ToHashSet();
        _canCreateTraining = _isSuperAdmin || _adminGroupIds.Count > 0;

        _userId = int.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        if (_userId > 0)
        {
            _userCountry = (await UserService.GetByIdAsync(_userId))?.CountryCode ?? "CH";

            _registeredTrainingIds = (await RegistrationService.GetByUserIdAsync(_userId))
                .Where(r => r.Status == Trainings.Domain.Enums.RegistrationStatus.Registered)
                .Select(r => r.TrainingId)
                .ToHashSet();
        }
        else
        {
            _registeredTrainingIds.Clear();
        }

        var groups = await GroupService.GetAllAsync();
        _filterGroups = (_isSuperAdmin
                ? groups
                : groups.Where(group => _accessibleGroupIds.Contains(group.Id)))
            .Where(group => group.IsActive)
            .OrderBy(group => group.Name)
            .ToList();

        var trainings = (await TrainingService.GetActiveAsync())
            .Where(t => _isSuperAdmin || (t.GroupId.HasValue && _accessibleGroupIds.Contains(t.GroupId.Value)))
            .OrderByDescending(t => t.DateTime)
            .ToList();

        _filterTrainers = trainings
            .Where(training => training.TrainerId.HasValue)
            .DistinctBy(training => training.TrainerId)
            .Select(training => new FilterOption(training.TrainerId!.Value, training.TrainerName))
            .OrderBy(trainer => trainer.Name)
            .ToList();

        var archiveThreshold = DateTime.Now.AddDays(-14);
        _recentTrainings = trainings.Where(t => t.DateTime >= archiveThreshold).ToList();
        _archivedTrainings = trainings.Where(t => t.DateTime < archiveThreshold).ToList();
        _loading = false;
    }

    private List<TrainingDto> ApplyFilters(IEnumerable<TrainingDto> trainings)
    {
        var query = trainings;

        if (_filterGroupId.HasValue)
        {
            query = query.Where(training => training.GroupId == _filterGroupId.Value);
        }

        if (_filterTrainerId.HasValue)
        {
            query = _filterTrainerId.Value == -1
                ? query.Where(training => !training.TrainerId.HasValue)
                : query.Where(training => training.TrainerId == _filterTrainerId.Value);
        }

        return query.ToList();
    }

    private bool CanRegister(TrainingDto training) =>
        _isSuperAdmin || (training.GroupId.HasValue && _accessibleGroupIds.Contains(training.GroupId.Value));

    private bool CanTake(TrainingDto training) =>
        !training.TrainerId.HasValue && training.Status == TrainingStatus.New &&
        (_isSuperAdmin || (training.GroupId.HasValue && (_trainerGroupIds.Contains(training.GroupId.Value) || _adminGroupIds.Contains(training.GroupId.Value))));

    private async Task TakeTrainingAsync(TrainingDto training)
    {
        try
        {
            await TrainingService.TakeAsync(training.Id, _userId);
            await ShowToastAsync(Localizer["TrainingsPage_TakeSuccess"], ToastComponent.ToastVariant.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync(ex.Message, ToastComponent.ToastVariant.Danger);
        }
    }

    private bool IsRegistrationDisabled(TrainingDto training) =>
        !_registeredTrainingIds.Contains(training.Id) && training.RegisteredCount >= training.Capacity;

    private async Task ToggleRegistrationAsync(TrainingDto training)
    {
        try
        {
            if (_registeredTrainingIds.Contains(training.Id))
            {
                await RegistrationService.CancelAsync(_userId, training.Id);
                await ShowToastAsync(Localizer["TrainingsPage_RegistrationCancelled"], ToastComponent.ToastVariant.Info);
            }
            else
            {
                await RegistrationService.RegisterAsync(_userId, training.Id);
                await ShowToastAsync(Localizer["TrainingsPage_SuccessfullyRegistered"], ToastComponent.ToastVariant.Success);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync(ex.Message, ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task ShowToastAsync(string message, ToastComponent.ToastVariant variant)
    {
        if (_toast is not null)
        {
            await _toast.Show(message, variant);
        }
    }

    private void GoToCreateTraining() => NavigationManager.NavigateTo("/trainings/create");

    private void ApplyFilters()
    {
        _filterGroupId = _pendingGroupId;
        _filterTrainerId = _pendingTrainerId;
    }

    private void ClearFilters()
    {
        _pendingGroupId = null;
        _pendingTrainerId = null;
        _filterGroupId = null;
        _filterTrainerId = null;
    }

    private void ToggleArchivedTrainings()
    {
        _archivedTrainingsExpanded = !_archivedTrainingsExpanded;
    }
}
