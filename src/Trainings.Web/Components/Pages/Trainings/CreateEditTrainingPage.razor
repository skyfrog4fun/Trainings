@page "/trainings/create"
@page "/trainings/{Id:int}/edit"
@page "/trainings/{Slug}/create"
@page "/trainings/{Slug}/{Id:int}/edit"
@namespace Trainings.Web.Components.Pages.TrainingsPages

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupTrainer")]

@inject ITrainingService TrainingService
@inject IGroupService GroupService
@inject ILocationService LocationService
@inject IAppRuntimeModeService AppRuntimeModeService
@inject IDateTimeFormatService DateTimeFormatService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationHelper AuthorizationHelper
@inject NavigationManager NavigationManager

<PageTitle>@(_isEdit ? Localizer["CreateEditTrainingPage_PageTitleEdit"] : Localizer["CreateEditTrainingPage_PageTitleNew"])</PageTitle>

<div class="container px-2 px-md-4">
    <div class="my-3">
        <BackButton Href="@BackHref" />
    </div>

    @if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["CreateEditTrainingPage_AccessDenied"]</div>
    }
    else
    {
    <h2>@(_isEdit ? Localizer["CreateEditTrainingPage_PageTitleEdit"] : Localizer["CreateEditTrainingPage_HeadingNew"])</h2>

    @if (IsWriteBlocked)
    {
        <div class="alert alert-warning">
            @Localizer["CreateEditTrainingPage_ReadOnlyAlert"]
        </div>
    }

    <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_GroupLabel"]</label>
                        <SelectDropdownComponent TItem="GroupDto" TValue="int?"
                                                  @bind-Value="_groupId"
                                                  @bind-Value:after="OnGroupChangedAsync"
                                                  Items="_availableGroups"
                                                  ValueSelector="g => (int?)g.Id"
                                                  TextSelector="@(g => g.Name)"
                                                  PlaceholderText="@Localizer["CreateEditTrainingPage_SelectGroup"]" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_TrainerLabel"]</label>
                        <SelectDropdownComponent TItem="GroupMembershipDto" TValue="int"
                                                  @bind-Value="_trainerId"
                                                  Items="_groupTrainers"
                                                  ValueSelector="t => t.UserId"
                                                  TextSelector="@(t => t.UserDisplayName)"
                                                  PlaceholderText="@Localizer["CreateEditTrainingPage_SelectTrainer"]"
                                                  PlaceholderValue="0" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_TitleLabel"]</label>
                        <input class="form-control" maxlength="64" @bind="_title" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_DateLabel"]</label>
                        <input class="form-control" type="date" @bind="_date" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_LocationLabel"]</label>
                        <SelectDropdownComponent TItem="LocationDto" TValue="int?"
                                                  @bind-Value="_locationId"
                                                  @bind-Value:after="OnLocationChanged"
                                                  Items="_availableLocations"
                                                  ValueSelector="l => (int?)l.Id"
                                                  TextSelector="@(l => l.Name)"
                                                  SubTextSelector="@(l => l.CityName)"
                                                  PlaceholderText="@Localizer["CreateEditTrainingPage_SelectLocation"]" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_MaxParticipantLabel"]</label>
                        <input class="form-control" type="number" min="1" @bind="_capacity" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_StartLabel"]</label>
                        <input class="form-control" type="time" @bind="_startTime" @bind:after="CalculateEndTime" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_DurationLabel"]</label>
                        <input class="form-control" type="number" min="1" @bind="DurationMinutesValue" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_EndLabel"]</label>
                        <input class="form-control" type="time" value="@_endTime" readonly />
                    </div>

                    @if (_isEdit)
                    {
                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_StatusLabel"]</label>
                            <div class="mt-1 d-flex flex-wrap gap-2 align-items-center">
                                <span class="badge @GetStatusBadgeClass(_status)">@_status</span>
                                @if (_status == TrainingStatus.InPlanning && _trainerId > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-success" @onclick="ConfirmPlannedAsync" title="@Localizer["CreateEditTrainingPage_ConfirmPlannedTitle"]">
                                        <i class="fa-solid fa-check me-1" aria-hidden="true"></i>@Localizer["CreateEditTrainingPage_ConfirmPlanned"]
                                    </button>
                                }
                                @if (_originalTrainerId == _currentUserId && _status is TrainingStatus.InPlanning or TrainingStatus.Planned)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ReleaseTrainerAsync" title="@Localizer["CreateEditTrainingPage_ReleaseTrainerTitle"]">
                                        <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>@Localizer["CreateEditTrainingPage_ReleaseTrainer"]
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_isSpecialLocationSelected)
                    {
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_SpecialLocationLabel"]</label>
                            <input class="form-control" @bind="_specialLocationDescription" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_MeetingPointLabel"]</label>
                            <input class="form-control" @bind="_meetingPoint" />
                        </div>
                    }

                    <div class="col-12">
                        <label class="form-label">@Localizer["CreateEditTrainingPage_DescriptionLabel"]</label>
                        <textarea class="form-control" rows="3" maxlength="512" @bind="_description"></textarea>
                    </div>
                </div>

                <div class="mt-3">
                    <ActionAlert IsSuccess="false" Message="@_error" />
                </div>

                <button type="button" class="btn btn-primary btn-lg w-100 mt-3" @onclick="Save" disabled="@IsWriteBlocked">
                    @(_isEdit ? Localizer["CreateEditTrainingPage_UpdateButton"] : Localizer["CreateEditTrainingPage_CreateButton"])
                </button>
            </div>
        </div>

    <ActionAlert IsSuccess="@_actionSuccess" Message="@_actionResult" />

    @if (_persistedTrainingId.HasValue)
    {
        <TrainingBlockEditor TrainingId="@_persistedTrainingId.Value" IsWriteBlocked="@IsWriteBlocked" />
    }
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private bool _isEdit => Id.HasValue;
    private int? _persistedTrainingId;
    private AppRuntimeModeDto _runtimeMode = new();
    private List<GroupDto> _availableGroups = new();
    private List<GroupMembershipDto> _groupTrainers = new();
    private List<LocationDto> _availableLocations = new();
    private bool _isSuperAdmin;
    private int _currentUserId;
    private bool _isAccessDenied;

    private string _title = string.Empty;
    private string _description = string.Empty;
    private int? _capacity = 10;
    private DateTime? _date = DateTime.Today.AddDays(7);
    private TimeOnly? _startTime = new(19, 0);
    private int? _durationMinutes = 90;
    private string _endTime = "20:30";
    private TrainingStatus _status = TrainingStatus.New;
    private string? _error;
    private int _trainerId;
    private int? _originalTrainerId;
    private int? _groupId;
    private int? _locationId;
    private string _specialLocationDescription = string.Empty;
    private string _meetingPoint = string.Empty;

    private bool _actionSuccess;
    private string? _actionResult;
    private CultureInfo _groupCulture = CultureInfo.InvariantCulture;

    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;
    private bool _isSpecialLocationSelected =>
        _locationId.HasValue &&
        _availableLocations.Any(x =>
            x.Id == _locationId.Value &&
            (x.Name.Equals("Special", StringComparison.OrdinalIgnoreCase) ||
             x.Name.Equals("Outside", StringComparison.OrdinalIgnoreCase)));

    private string BackHref => _isEdit
        ? (string.IsNullOrWhiteSpace(Slug) ? $"/trainings/{Id}" : $"/trainings/{Slug}/{Id}")
        : "/trainings";

    private int? DurationMinutesValue
    {
        get => _durationMinutes;
        set
        {
            _durationMinutes = value;
            CalculateEndTime();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        _isSuperAdmin = AuthorizationHelper.IsSuperAdmin(user);

        if (_isEdit && Id.HasValue)
        {
            var training = await TrainingService.GetByIdAsync(Id.Value);
            if (training is null)
            {
                _isAccessDenied = true;
                return;
            }

            bool isAssignedTrainer = training.TrainerId == _currentUserId;
            bool isGroupAdmin = training.GroupId.HasValue && AuthorizationHelper.IsGroupAdmin(user, training.GroupId.Value);
            if (!_isSuperAdmin && !isGroupAdmin && !isAssignedTrainer)
            {
                _isAccessDenied = true;
                return;
            }

            var managedGroupIds = AuthorizationHelper.GetGroupIdsForRole(user, "Admin")
                .Concat(AuthorizationHelper.GetGroupIdsForRole(user, "Trainer"))
                .ToHashSet();

            var groups = await GroupService.GetAllAsync();
            _availableGroups = _isSuperAdmin
                ? groups.Where(g => g.IsActive).OrderBy(g => g.Name).ToList()
                : groups.Where(g => g.IsActive && managedGroupIds.Contains(g.Id)).OrderBy(g => g.Name).ToList();

            _persistedTrainingId = Id.Value;
            await LoadTraining(training);
        }
        else
        {
            // Only a GroupAdmin (or SuperAdmin) may create a training.
            var adminGroupIds = AuthorizationHelper.GetGroupIdsForRole(user, "Admin").ToHashSet();
            if (!_isSuperAdmin && adminGroupIds.Count == 0)
            {
                _isAccessDenied = true;
                return;
            }

            var groups = await GroupService.GetAllAsync();
            _availableGroups = _isSuperAdmin
                ? groups.Where(g => g.IsActive).OrderBy(g => g.Name).ToList()
                : groups.Where(g => g.IsActive && adminGroupIds.Contains(g.Id)).OrderBy(g => g.Name).ToList();

            if (!string.IsNullOrWhiteSpace(Slug))
            {
                var slugGroup = _availableGroups.FirstOrDefault(g => string.Equals(g.Slug, Slug, StringComparison.OrdinalIgnoreCase));
                if (slugGroup != null)
                {
                    _groupId = slugGroup.Id;
                    await OnGroupChangedAsync();
                }
            }
            else if (_availableGroups.Count == 1)
            {
                _groupId = _availableGroups[0].Id;
                await OnGroupChangedAsync();
            }
        }

        CalculateEndTime();
    }

    private async Task LoadTraining(TrainingDto training)
    {
        _title = training.Title;
        _description = training.Description;
        _capacity = training.Capacity;
        _date = training.DateTime.Date;
        _startTime = TimeOnly.FromDateTime(training.DateTime);
        _status = training.Status;
        _groupId = training.GroupId;
        _trainerId = training.TrainerId ?? 0;
        _originalTrainerId = training.TrainerId;
        _locationId = training.LocationId;
        _specialLocationDescription = training.SpecialLocationDescription ?? string.Empty;
        _meetingPoint = training.MeetingPoint ?? string.Empty;

        await OnGroupChangedAsync();

        var selectedGroup = _availableGroups.FirstOrDefault(g => g.Id == training.GroupId);
        _durationMinutes = training.DurationMinutes ?? selectedGroup?.DurationMinutes ?? 90;
        CalculateEndTime();

    }

    private async Task OnGroupChangedAsync()
    {
        if (!_groupId.HasValue)
        {
            _groupTrainers.Clear();
            _availableLocations.Clear();
            _locationId = null;
            return;
        }

        var selectedGroup = _availableGroups.FirstOrDefault(g => g.Id == _groupId.Value);
        if (selectedGroup is null)
        {
            return;
        }

        _availableLocations = (await LocationService.GetByGroupIdAsync(_groupId.Value))
            .Where(l => l.IsActive)
            .ToList();

        _groupTrainers = (await GroupService.GetMembersAsync(_groupId.Value))
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive && (m.Role == GroupMemberRole.Trainer || m.Role == GroupMemberRole.Admin))
            .GroupBy(m => m.UserId)
            .Select(x => x.First())
            .OrderBy(x => x.UserDisplayName)
            .ToList();

        if (!_isEdit)
        {
            if (selectedGroup.Weekday.HasValue)
            {
                _date = await TrainingService.GetNextAvailableDateForGroupAsync(
                    selectedGroup.Id, selectedGroup.Weekday.Value);
            }

            if (selectedGroup.StartTime.HasValue)
            {
                _startTime = selectedGroup.StartTime.Value;
            }

            if (selectedGroup.DurationMinutes.HasValue)
            {
                _durationMinutes = selectedGroup.DurationMinutes.Value;
            }

            if (selectedGroup.MaxParticipants.HasValue)
            {
                _capacity = selectedGroup.MaxParticipants.Value;
            }

            _locationId = selectedGroup.LocationId ?? _availableLocations.FirstOrDefault()?.Id;
        }

        _groupCulture = DateTimeFormatService.GetCultureForCountry(selectedGroup.CountryCode);
        CalculateEndTime();
    }

    private void OnLocationChanged()
    {
        if (!_isSpecialLocationSelected)
        {
            _specialLocationDescription = string.Empty;
            _meetingPoint = string.Empty;
        }
    }

    private void CalculateEndTime()
    {
        var start = _startTime ?? new TimeOnly(19, 0);
        var duration = _durationMinutes ?? 0;

        var end = start.AddMinutes(duration <= 0 ? 1 : duration);
        _endTime = end.ToString("HH:mm");
    }

    private static string GetStatusBadgeClass(TrainingStatus status) => status switch
    {
        TrainingStatus.Planned => "bg-success",
        TrainingStatus.InPlanning => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string FormatLocalizedDate(DateTime? value) =>
        (value ?? DateTime.Today).ToString("d", _groupCulture);

    private string FormatLocalizedTime(TimeOnly? value)
    {
        var time = value ?? new TimeOnly(19, 0);
        return time.ToString("t", _groupCulture);
    }

    private string FormatLocalizedEndTime()
    {
        if (!TimeOnly.TryParse(_endTime, out var parsed))
        {
            return _endTime;
        }

        return parsed.ToString("t", _groupCulture);
    }

    private async Task Save()
    {
        _error = null;
        _actionResult = null;

        if (!_groupId.HasValue)
        {
            _error = Localizer["CreateEditTrainingPage_GroupRequired"];
            return;
        }

        if (!_date.HasValue)
        {
            _error = Localizer["CreateEditTrainingPage_DateRequired"];
            return;
        }

        if (!_locationId.HasValue)
        {
            _error = Localizer["CreateEditTrainingPage_LocationRequired"];
            return;
        }

        if (!_capacity.HasValue || _capacity.Value <= 0)
        {
            _error = Localizer["CreateEditTrainingPage_CapacityRequired"];
            return;
        }

        if (!_startTime.HasValue)
        {
            _error = Localizer["CreateEditTrainingPage_StartRequired"];
            return;
        }

        if (!_durationMinutes.HasValue || _durationMinutes.Value <= 0)
        {
            _error = Localizer["CreateEditTrainingPage_DurationRequired"];
            return;
        }

        var start = _startTime.Value;

        try
        {
            var dateTime = _date.Value.Date.AddHours(start.Hour).AddMinutes(start.Minute);
            var newTrainerId = _trainerId == 0 ? (int?)null : _trainerId;

            if (_isEdit && Id.HasValue)
            {
                await TrainingService.UpdateAsync(new UpdateTrainingDto
                {
                    Id = Id.Value,
                    Title = _title,
                    Description = _description,
                    LocationId = _locationId,
                    SpecialLocationDescription = string.IsNullOrWhiteSpace(_specialLocationDescription) ? null : _specialLocationDescription,
                    MeetingPoint = string.IsNullOrWhiteSpace(_meetingPoint) ? null : _meetingPoint,
                    Capacity = _capacity.Value,
                    DateTime = dateTime,
                    DurationMinutes = _durationMinutes,
                    Status = _status,
                    TrainerId = _originalTrainerId,
                    GroupId = _groupId
                });

                if (newTrainerId != _originalTrainerId)
                {
                    await TrainingService.ReassignTrainerAsync(Id.Value, newTrainerId);
                    _originalTrainerId = newTrainerId;
                }

                var refreshed = await TrainingService.GetByIdAsync(Id.Value);
                if (refreshed != null)
                {
                    _status = refreshed.Status;
                }

                _actionSuccess = true;
                _actionResult = Localizer["CreateEditTrainingPage_UpdatedSuccess"];
            }
            else
            {
                var created = await TrainingService.CreateAsync(new CreateTrainingDto
                {
                    Title = _title,
                    Description = _description,
                    LocationId = _locationId,
                    SpecialLocationDescription = string.IsNullOrWhiteSpace(_specialLocationDescription) ? null : _specialLocationDescription,
                    MeetingPoint = string.IsNullOrWhiteSpace(_meetingPoint) ? null : _meetingPoint,
                    Capacity = _capacity.Value,
                    DateTime = dateTime,
                    DurationMinutes = _durationMinutes,
                    TrainerId = newTrainerId,
                    GroupId = _groupId
                });

                _persistedTrainingId = created.Id;
                NavigationManager.NavigateTo("/trainings");
                return;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _actionSuccess = false;
            _actionResult = string.Format(Localizer["CreateEditTrainingPage_SaveFailed"].Value, ex.Message);
        }
    }

    private async Task ConfirmPlannedAsync()
    {
        if (!_persistedTrainingId.HasValue)
        {
            return;
        }

        try
        {
            await TrainingService.ConfirmPlannedAsync(_persistedTrainingId.Value);
            _status = TrainingStatus.Planned;
            _actionSuccess = true;
            _actionResult = Localizer["CreateEditTrainingPage_ConfirmPlannedSuccess"];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReleaseTrainerAsync()
    {
        if (!_persistedTrainingId.HasValue)
        {
            return;
        }

        try
        {
            await TrainingService.ReleaseTrainerAsync(_persistedTrainingId.Value, _currentUserId);
            _status = TrainingStatus.New;
            _trainerId = 0;
            _originalTrainerId = null;
            _actionSuccess = true;
            _actionResult = Localizer["CreateEditTrainingPage_ReleaseTrainerSuccess"];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

}

