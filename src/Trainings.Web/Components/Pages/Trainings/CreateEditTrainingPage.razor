@page "/trainings/create"
@page "/trainings/{Slug}/{Id:int}/edit"

@namespace Trainings.Web.Components.Pages.TrainingsPages

@rendermode InteractiveServer

@attribute [Authorize(Policy = "GroupTrainer")]

@inject ITrainingService TrainingService
@inject ITrainingBlockService TrainingBlockService
@inject IGroupService GroupService
@inject ILocationService LocationService
@inject IAppRuntimeModeService AppRuntimeModeService
@inject IDateTimeFormatService DateTimeFormatService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthorizationHelper AuthorizationHelper
@inject NavigationManager NavigationManager

<PageTitle>@(_isEdit ? Localizer["CreateEditTrainingPage_PageTitleEdit"] : Localizer["CreateEditTrainingPage_PageTitleNew"])</PageTitle>

<ToastComponent @ref="_toast" CloseLabel="@Localizer["Shared_Close"]" />

<div class="container px-2 px-md-4">
    @if (_loading)
    {
        <LoadingSpinner />
    }
    else if (_isAccessDenied)
    {
        <div class="alert alert-danger">@Localizer["CreateEditTrainingPage_AccessDenied"]</div>
    }
    else
    {
        <PageTitleComponent Icon="@AppIcons.Fire" Text="@(_isEdit ? Localizer["CreateEditTrainingPage_PageTitleEdit"] : Localizer["CreateEditTrainingPage_HeadingNew"])"
                             ButtonIcon="@AppIcons.Back" ButtonText="@Localizer["Shared_Back"]" OnButtonClick="GoBack" />

        @if (IsWriteBlocked)
        {
            <div class="alert alert-warning">
                @Localizer["CreateEditTrainingPage_ReadOnlyAlert"]
            </div>
        }

        <EditForm Model="_formModel" OnValidSubmit="SaveTrainingAsync">
            <DataAnnotationsValidator />
            <CardComponent IsCollapsable="true" Collapsed="@_hasExistingBlocks" ShowFooter="true" HeaderCssClass="card-header-nowrap">
                <Title>
                    @if (_isEdit)
                    {
                        <span class="card-title-truncate" title="@_savedTitle">@_savedTitle</span>
                    }
                    else
                    {
                        @Localizer["CreateEditTrainingPage_HeadingNew"]
                    }
                </Title>
                <TitleMeta>
                    @if (_isEdit)
                    {
                        <TrainingStatusComponent Status="_status" />
                    }
                </TitleMeta>
                <Body>
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_GroupLabel"]</label>
                            <SelectDropdownComponent TItem="GroupDto" TValue="int?"
                                                      @bind-Value="_formModel.GroupId"
                                                      @bind-Value:after="OnGroupChangedAsync"
                                                      Items="_availableGroups"
                                                      ValueSelector="g => (int?)g.Id"
                                                      TextSelector="@(g => g.Name)"
                                                      PlaceholderText="@Localizer["CreateEditTrainingPage_SelectGroup"]"
                                                      Disabled="@_isGroupLocked" />
                            <ValidationMessage For="() => _formModel.GroupId" class="text-danger small" />
                            @if (_isGroupLocked)
                            {
                                <div class="form-text">@Localizer["CreateEditTrainingPage_GroupLockedNote"]</div>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_TrainerLabel"]</label>
                            <div class="trainer-select-group">
                                <SelectDropdownComponent TItem="GroupMembershipDto" TValue="int"
                                                          @bind-Value="_formModel.TrainerId"
                                                          Items="_groupTrainers"
                                                          ValueSelector="t => t.UserId"
                                                          TextSelector="@(t => t.UserDisplayName)"
                                                          PlaceholderText="@Localizer["CreateEditTrainingPage_SelectTrainer"]"
                                                          PlaceholderValue="0" />
                                @if (_showReleaseTrainer)
                                {
                                    <button type="button" class="btn btn-outline-danger trainer-release-btn" @onclick="ReleaseTrainerAsync" title="@Localizer["CreateEditTrainingPage_ReleaseTrainerTitle"]" aria-label="@Localizer["CreateEditTrainingPage_ReleaseTrainerTitle"]">
                                        <i class="@AppIcons.ReleaseTrainer" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_TitleLabel"]</label>
                            <InputText class="form-control" maxlength="64" @bind-Value="_formModel.Title" />
                        </div>

                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-12 col-md-9 order-1">
                                    <label class="form-label">@Localizer["CreateEditTrainingPage_LocationLabel"]</label>
                                    <SelectDropdownComponent TItem="LocationDto" TValue="int?"
                                                              @bind-Value="_formModel.LocationId"
                                                              @bind-Value:after="OnLocationChanged"
                                                              Items="_availableLocations"
                                                              ValueSelector="l => (int?)l.Id"
                                                              TextSelector="@(l => l.Name)"
                                                              SubTextSelector="@(l => l.CityName)"
                                                              PlaceholderText="@Localizer["CreateEditTrainingPage_SelectLocation"]" />
                                    <ValidationMessage For="() => _formModel.LocationId" class="text-danger small" />
                                </div>

                                <div class="col-12 col-md-3 order-4 order-md-2">
                                    <label class="form-label">@Localizer["CreateEditTrainingPage_MaxParticipantLabel"]</label>
                                    <InputNumber class="form-control" @bind-Value="_formModel.Capacity" />
                                    <ValidationMessage For="() => _formModel.Capacity" class="text-danger small" />
                                </div>

                                @if (_isSpecialLocationSelected)
                                {
                                    <div class="col-12 col-md-6 order-2 order-md-3">
                                        <label class="form-label">@Localizer["CreateEditTrainingPage_SpecialLocationLabel"]</label>
                                        <InputText class="form-control" @bind-Value="_formModel.SpecialLocationDescription" />
                                        <ValidationMessage For="() => _formModel.SpecialLocationDescription" class="text-danger small" />
                                    </div>
                                    <div class="col-12 col-md-6 order-3 order-md-4">
                                        <label class="form-label">@Localizer["CreateEditTrainingPage_MeetingPointLabel"]</label>
                                        <InputText class="form-control" @bind-Value="_formModel.MeetingPoint" />
                                        <ValidationMessage For="() => _formModel.MeetingPoint" class="text-danger small" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_DateLabel"]</label>
                            <InputDate class="form-control" @bind-Value="_formModel.Date" />
                            <ValidationMessage For="() => _formModel.Date" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_StartLabel"]</label>
                            <input class="form-control" type="time" @bind="_formModel.StartTime" @bind:after="OnStartTimeChanged" />
                            <ValidationMessage For="() => _formModel.StartTime" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_DurationLabel"]</label>
                            <InputNumber class="form-control" @bind-Value="_formModel.DurationMinutes" @bind-Value:after="CalculateEndTime" />
                            <ValidationMessage For="() => _formModel.DurationMinutes" class="text-danger small" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_EndLabel"]</label>
                            <input class="form-control" type="time" @bind="_endTime" @bind:after="OnEndTimeChanged" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Localizer["CreateEditTrainingPage_DescriptionLabel"]</label>
                            <InputTextArea class="form-control" rows="3" maxlength="512" @bind-Value="_formModel.Description" />
                        </div>
                    </div>
                </Body>
                <Footer>
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@(_saving || IsWriteBlocked)">
                            <i class="@AppIcons.FloppyDisk me-1" aria-hidden="true"></i>@Localizer["Shared_Save"]
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="GoBack">
                            <i class="@AppIcons.XMark me-1" aria-hidden="true"></i>@Localizer["Shared_Cancel"]
                        </button>
                    </div>
                </Footer>
            </CardComponent>
        </EditForm>

        @if (_persistedTrainingId.HasValue)
        {
            <TrainingBlockEditor TrainingId="@_persistedTrainingId.Value" IsWriteBlocked="@IsWriteBlocked" />
        }

        @if (_showConfirmPlanned)
        {
            <hr class="my-4" />
            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-success" @onclick="ConfirmPlannedAsync" title="@Localizer["CreateEditTrainingPage_ConfirmPlannedTitle"]">
                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i>@Localizer["CreateEditTrainingPage_ConfirmPlanned"]
                </button>
            </div>
        }
    }
</div>

<ConfirmDialogComponent IsVisible="_showNoBlocksConfirm"
                        Title="@Localizer["CreateEditTrainingPage_ConfirmPlannedNoBlocksTitle"]"
                        Message="@Localizer["CreateEditTrainingPage_ConfirmPlannedNoBlocksMessage"]"
                        ConfirmText="@Localizer["CreateEditTrainingPage_ConfirmPlanned"]"
                        CancelText="@Localizer["Shared_Cancel"]"
                        OnConfirm="DoConfirmPlannedAsync"
                        OnCancel="CancelConfirmPlannedDialog" />

<ConfirmDialogComponent IsVisible="_showDurationMismatchConfirm"
                        Title="@Localizer["CreateEditTrainingPage_ConfirmPlannedDurationMismatchTitle"]"
                        Message="@string.Format(Localizer["CreateEditTrainingPage_ConfirmPlannedDurationMismatchMessage"].Value, _blocksSumMinutes, _formModel.DurationMinutes)"
                        ConfirmText="@Localizer["CreateEditTrainingPage_ConfirmPlanned"]"
                        CancelText="@Localizer["Shared_Cancel"]"
                        OnConfirm="DoConfirmPlannedAsync"
                        OnCancel="CancelConfirmPlannedDialog" />

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private bool _isEdit => Id.HasValue;
    private int? _persistedTrainingId;
    private AppRuntimeModeDto _runtimeMode = new();
    private List<GroupDto> _availableGroups = new();
    private List<GroupMembershipDto> _groupTrainers = new();
    private List<LocationDto> _availableLocations = new();
    private bool _isSuperAdmin;
    private bool _isGroupAdmin;
    private int _currentUserId;
    private bool _isAccessDenied;
    private bool _loading = true;
    private bool _saving;
    private int _registeredCount;
    private bool _hasExistingBlocks;
    private ToastComponent? _toast;
    private bool _showNoBlocksConfirm;
    private bool _showDurationMismatchConfirm;
    private int _blocksSumMinutes;

    private TimeOnly? _endTime;
    private bool _durationDrivesEnd = true;
    private TrainingStatus _status = TrainingStatus.New;
    private int? _originalTrainerId;
    private string _savedTitle = string.Empty;
    private TrainingFormModel _formModel = new();

    private CultureInfo _groupCulture = CultureInfo.InvariantCulture;

    private bool IsWriteBlocked => _runtimeMode.IsReadOnly && !_isSuperAdmin;
    private bool _isGroupLocked => _isEdit && _registeredCount > 0;
    private bool _showConfirmPlanned => _isEdit && _status == TrainingStatus.InPlanning && _formModel.TrainerId > 0;
    private bool _showReleaseTrainer => _isEdit && _originalTrainerId == _currentUserId && _status is TrainingStatus.InPlanning or TrainingStatus.Planned;
    private bool _isSpecialLocationSelected =>
        _formModel.LocationId.HasValue &&
        _availableLocations.Any(x =>
            x.Id == _formModel.LocationId.Value &&
            (x.Name.Equals("Special", StringComparison.OrdinalIgnoreCase) ||
             x.Name.Equals("Outside", StringComparison.OrdinalIgnoreCase)));

    private string BackHref => _isEdit ? $"/trainings/{Slug}/{Id}" : "/trainings";

    /// <summary>
    /// True when the current user keeps edit access purely based on being the assigned trainer
    /// (i.e. not a SuperAdmin nor a GroupAdmin for this training's group).
    /// </summary>
    private bool _isOnlyAssignedTrainer => !_isSuperAdmin && !_isGroupAdmin;

    protected override async Task OnInitializedAsync()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = int.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        _isSuperAdmin = AuthorizationHelper.IsSuperAdmin(user);

        if (_isEdit && Id.HasValue)
        {
            var training = await TrainingService.GetByIdAsync(Id.Value);
            if (training is null)
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            bool isAssignedTrainer = training.TrainerId == _currentUserId;
            _isGroupAdmin = AuthorizationHelper.IsGroupAdmin(user, training.GroupId);
            if (!_isSuperAdmin && !_isGroupAdmin && !isAssignedTrainer)
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            var managedGroupIds = AuthorizationHelper.GetGroupIdsForRole(user, "Admin")
                .Concat(AuthorizationHelper.GetGroupIdsForRole(user, "Trainer"))
                .ToHashSet();

            var groups = await GroupService.GetAllAsync();
            _availableGroups = _isSuperAdmin
                ? groups.Where(g => g.IsActive).OrderBy(g => g.Name).ToList()
                : groups.Where(g => g.IsActive && managedGroupIds.Contains(g.Id)).OrderBy(g => g.Name).ToList();

            _persistedTrainingId = Id.Value;
            _hasExistingBlocks = training.Blocks.Count > 0;
            await LoadTraining(training);
        }
        else
        {
            // Only a GroupAdmin (or SuperAdmin) may create a training.
            var adminGroupIds = AuthorizationHelper.GetGroupIdsForRole(user, "Admin").ToHashSet();
            if (!_isSuperAdmin && adminGroupIds.Count == 0)
            {
                _isAccessDenied = true;
                _loading = false;
                return;
            }

            var groups = await GroupService.GetAllAsync();
            _availableGroups = _isSuperAdmin
                ? groups.Where(g => g.IsActive).OrderBy(g => g.Name).ToList()
                : groups.Where(g => g.IsActive && adminGroupIds.Contains(g.Id)).OrderBy(g => g.Name).ToList();

            if (!string.IsNullOrWhiteSpace(Slug))
            {
                var slugGroup = _availableGroups.FirstOrDefault(g => string.Equals(g.Slug, Slug, StringComparison.OrdinalIgnoreCase));
                if (slugGroup != null)
                {
                    _formModel.GroupId = slugGroup.Id;
                    await OnGroupChangedAsync();
                }
            }
            else if (_availableGroups.Count == 1)
            {
                _formModel.GroupId = _availableGroups[0].Id;
                await OnGroupChangedAsync();
            }
        }

        CalculateEndTime();
        _loading = false;
    }

    private async Task LoadTraining(TrainingDto training)
    {
        _formModel.Title = training.Title;
        _savedTitle = training.Title;
        _formModel.Description = training.Description;
        _formModel.Capacity = training.Capacity;
        _formModel.Date = training.DateTime.Date;
        _formModel.StartTime = TimeOnly.FromDateTime(training.DateTime);
        _status = training.Status;
        _formModel.GroupId = training.GroupId;
        _formModel.TrainerId = training.TrainerId ?? 0;
        _originalTrainerId = training.TrainerId;
        _formModel.LocationId = training.LocationId;
        _formModel.SpecialLocationDescription = training.SpecialLocationDescription ?? string.Empty;
        _formModel.MeetingPoint = training.MeetingPoint ?? string.Empty;
        _registeredCount = training.RegisteredCount;
        _formModel.HasParticipants = _registeredCount > 0;
        _formModel.OriginalGroupId = training.GroupId;

        await OnGroupChangedAsync();

        var selectedGroup = _availableGroups.FirstOrDefault(g => g.Id == training.GroupId);
        _formModel.DurationMinutes = training.DurationMinutes ?? selectedGroup?.DurationMinutes ?? 90;
        CalculateEndTime();

    }

    private async Task OnGroupChangedAsync()
    {
        if (!_formModel.GroupId.HasValue)
        {
            _groupTrainers.Clear();
            _availableLocations.Clear();
            _formModel.LocationId = null;
            return;
        }

        var selectedGroup = _availableGroups.FirstOrDefault(g => g.Id == _formModel.GroupId.Value);
        if (selectedGroup is null)
        {
            return;
        }

        _availableLocations = (await LocationService.GetByGroupIdAsync(_formModel.GroupId.Value))
            .Where(l => l.IsActive)
            .ToList();

        _groupTrainers = (await GroupService.GetMembersAsync(_formModel.GroupId.Value))
            .Where(m => m.Status == GroupMembershipStatus.Approved && m.IsActive && (m.Role == GroupMemberRole.Trainer || m.Role == GroupMemberRole.Admin))
            .GroupBy(m => m.UserId)
            .Select(x => x.First())
            .OrderBy(x => x.UserDisplayName)
            .ToList();

        if (!_isEdit)
        {
            if (selectedGroup.Weekday.HasValue)
            {
                _formModel.Date = await TrainingService.GetNextAvailableDateForGroupAsync(
                    selectedGroup.Id, selectedGroup.Weekday.Value);
            }

            if (selectedGroup.StartTime.HasValue)
            {
                _formModel.StartTime = selectedGroup.StartTime.Value;
            }

            if (selectedGroup.DurationMinutes.HasValue)
            {
                _formModel.DurationMinutes = selectedGroup.DurationMinutes.Value;
            }

            if (selectedGroup.MaxParticipants.HasValue)
            {
                _formModel.Capacity = selectedGroup.MaxParticipants.Value;
            }

            _formModel.LocationId = selectedGroup.LocationId ?? _availableLocations.FirstOrDefault()?.Id;
        }

        _groupCulture = DateTimeFormatService.GetCultureForCountry(selectedGroup.CountryCode);
        _formModel.IsSpecialLocationSelected = _isSpecialLocationSelected;
        CalculateEndTime();
    }

    private void OnLocationChanged()
    {
        _formModel.IsSpecialLocationSelected = _isSpecialLocationSelected;
        if (!_isSpecialLocationSelected)
        {
            _formModel.SpecialLocationDescription = string.Empty;
            _formModel.MeetingPoint = string.Empty;
        }
    }

    private void CalculateEndTime()
    {
        _durationDrivesEnd = true;
        RecomputeEndFromDuration();
    }

    private void RecomputeEndFromDuration()
    {
        if (!_formModel.StartTime.HasValue || !_formModel.DurationMinutes.HasValue || _formModel.DurationMinutes.Value <= 0)
        {
            _endTime = null;
            return;
        }

        _endTime = _formModel.StartTime.Value.AddMinutes(_formModel.DurationMinutes.Value);
    }

    private void OnStartTimeChanged()
    {
        if (_durationDrivesEnd)
        {
            RecomputeEndFromDuration();
        }
        else
        {
            RecomputeDurationFromEnd();
        }
    }

    private void OnEndTimeChanged()
    {
        _durationDrivesEnd = false;
        RecomputeDurationFromEnd();
    }

    private void RecomputeDurationFromEnd()
    {
        if (!_formModel.StartTime.HasValue || !_endTime.HasValue)
        {
            _formModel.DurationMinutes = null;
            return;
        }

        var minutes = (_endTime.Value.ToTimeSpan() - _formModel.StartTime.Value.ToTimeSpan()).TotalMinutes;
        if (minutes <= 0)
        {
            minutes += 24 * 60; // end time crosses midnight relative to start
        }

        _formModel.DurationMinutes = (int)minutes;
    }

    private void GoBack() => NavigationManager.NavigateTo(BackHref);

    private async Task SaveTrainingAsync()
    {
        _saving = true;

        try
        {
            var start = _formModel.StartTime!.Value;
            var dateTime = _formModel.Date!.Value.Date.AddHours(start.Hour).AddMinutes(start.Minute);
            var newTrainerId = _formModel.TrainerId == 0 ? (int?)null : _formModel.TrainerId;

            if (_isEdit && Id.HasValue)
            {
                await TrainingService.UpdateAsync(new UpdateTrainingDto
                {
                    Id = Id.Value,
                    Title = _formModel.Title,
                    Description = _formModel.Description,
                    LocationId = _formModel.LocationId,
                    SpecialLocationDescription = string.IsNullOrWhiteSpace(_formModel.SpecialLocationDescription) ? null : _formModel.SpecialLocationDescription,
                    MeetingPoint = string.IsNullOrWhiteSpace(_formModel.MeetingPoint) ? null : _formModel.MeetingPoint,
                    Capacity = _formModel.Capacity!.Value,
                    DateTime = dateTime,
                    DurationMinutes = _formModel.DurationMinutes,
                    Status = _status,
                    TrainerId = _originalTrainerId,
                    GroupId = _formModel.GroupId!.Value
                });

                if (newTrainerId != _originalTrainerId)
                {
                    await TrainingService.ReassignTrainerAsync(Id.Value, newTrainerId);
                    _originalTrainerId = newTrainerId;
                }

                var refreshed = await TrainingService.GetByIdAsync(Id.Value);
                if (refreshed != null)
                {
                    _status = refreshed.Status;
                    _savedTitle = refreshed.Title;
                }

                await ShowToastAsync(Localizer["CreateEditTrainingPage_UpdatedSuccess"], ToastComponent.ToastVariant.Success);

                if (_isOnlyAssignedTrainer && newTrainerId != _currentUserId)
                {
                    // The current user is no longer the assigned trainer and has no admin
                    // rights on this training, so they lose access to the Edit page.
                    NavigationManager.NavigateTo(BackHref);
                    return;
                }
            }
            else
            {
                var created = await TrainingService.CreateAsync(new CreateTrainingDto
                {
                    Title = _formModel.Title,
                    Description = _formModel.Description,
                    LocationId = _formModel.LocationId,
                    SpecialLocationDescription = string.IsNullOrWhiteSpace(_formModel.SpecialLocationDescription) ? null : _formModel.SpecialLocationDescription,
                    MeetingPoint = string.IsNullOrWhiteSpace(_formModel.MeetingPoint) ? null : _formModel.MeetingPoint,
                    Capacity = _formModel.Capacity!.Value,
                    DateTime = dateTime,
                    DurationMinutes = _formModel.DurationMinutes,
                    TrainerId = newTrainerId,
                    GroupId = _formModel.GroupId!.Value
                });

                _persistedTrainingId = created.Id;
                NavigationManager.NavigateTo("/trainings");
                return;
            }
        }
        catch (Exception ex)
        {
            await ShowToastAsync(string.Format(Localizer["CreateEditTrainingPage_SaveFailed"].Value, ex.Message), ToastComponent.ToastVariant.Danger);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmPlannedAsync()
    {
        if (!_persistedTrainingId.HasValue)
        {
            return;
        }

        try
        {
            var blocks = (await TrainingBlockService.GetExecutionsAsync(_persistedTrainingId.Value)).ToList();
            if (blocks.Count == 0)
            {
                _showNoBlocksConfirm = true;
                return;
            }

            _blocksSumMinutes = blocks.Sum(b => b.PlannedDurationMinutes);
            if (_blocksSumMinutes != _formModel.DurationMinutes)
            {
                _showDurationMismatchConfirm = true;
                return;
            }

            await DoConfirmPlannedAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync(ex.Message, ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task DoConfirmPlannedAsync()
    {
        _showNoBlocksConfirm = false;
        _showDurationMismatchConfirm = false;

        if (!_persistedTrainingId.HasValue)
        {
            return;
        }

        try
        {
            await TrainingService.ConfirmPlannedAsync(_persistedTrainingId.Value);
            _status = TrainingStatus.Planned;
            await ShowToastAsync(Localizer["CreateEditTrainingPage_ConfirmPlannedSuccess"], ToastComponent.ToastVariant.Success);
        }
        catch (Exception ex)
        {
            await ShowToastAsync(ex.Message, ToastComponent.ToastVariant.Danger);
        }
    }

    private void CancelConfirmPlannedDialog()
    {
        _showNoBlocksConfirm = false;
        _showDurationMismatchConfirm = false;
    }

    private async Task ReleaseTrainerAsync()
    {
        if (!_persistedTrainingId.HasValue)
        {
            return;
        }

        try
        {
            await TrainingService.ReleaseTrainerAsync(_persistedTrainingId.Value, _currentUserId);
            _status = TrainingStatus.New;
            _formModel.TrainerId = 0;
            _originalTrainerId = null;
            await ShowToastAsync(Localizer["CreateEditTrainingPage_ReleaseTrainerSuccess"], ToastComponent.ToastVariant.Success);

            if (_isOnlyAssignedTrainer)
            {
                // Releasing themselves means they are no longer the assigned trainer;
                // without admin rights they lose access to the Edit page.
                NavigationManager.NavigateTo(BackHref);
                return;
            }
        }
        catch (Exception ex)
        {
            await ShowToastAsync(ex.Message, ToastComponent.ToastVariant.Danger);
        }
    }

    private async Task ShowToastAsync(string message, ToastComponent.ToastVariant variant)
    {
        if (_toast is not null)
        {
            await _toast.Show(message, variant);
        }
    }
}
