@inherits LayoutComponentBase
@inject IAppRuntimeModeService AppRuntimeModeService

<nav class="navbar sticky-top navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/"><i class="@AppIcons.Bolt me-1" aria-hidden="true"></i>Trainings</a>
        <div class="dropdown">
            <button class="btn btn-outline-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu">
                ☰
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <NavLink class="dropdown-item" href="" Match="NavLinkMatch.All"><i class="@AppIcons.Home me-2" aria-hidden="true"></i>Dashboard</NavLink>
                </li>
                <AuthorizeView Policy="GroupAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="groups"><i class="@AppIcons.Group me-2" aria-hidden="true"></i>Groups</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="users"><i class="@AppIcons.Users me-2" aria-hidden="true"></i>Users</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupMember">
                    <li>
                        <NavLink class="dropdown-item" href="trainings"><i class="@AppIcons.Fire me-2" aria-hidden="true"></i>Trainings</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupMember">
                    <li>
                        <NavLink class="dropdown-item" href="my-registrations"><i class="@AppIcons.ClipboardList me-2" aria-hidden="true"></i>My Registrations</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupTrainer">
                    <li>
                        <NavLink class="dropdown-item" href="plan-training"><i class="@AppIcons.Fire me-2" aria-hidden="true"></i>Plan Training</NavLink>
                    </li>
                </AuthorizeView>
                <li><hr class="dropdown-divider" /></li>
                <AuthorizeView Policy="SuperAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="config/mail"><i class="@AppIcons.Gear me-2" aria-hidden="true"></i>Config</NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="statistics"><i class="@AppIcons.ChartSimple me-2" aria-hidden="true"></i>Statistics</NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="config/locations"><i class="@AppIcons.Location me-2" aria-hidden="true"></i>Locations</NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <NavLink class="dropdown-item" href="user-information"><i class="@AppIcons.User me-2" aria-hidden="true"></i>User Information</NavLink>
                </li>
                <AuthorizeView Policy="SuperAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="config/icons"><i class="@AppIcons.CircleInfo me-2" aria-hidden="true"></i>Icon Overview</NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <a class="dropdown-item text-danger" href="/logout"><i class="@AppIcons.Logout me-2" aria-hidden="true"></i>Logout</a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <span class="dropdown-item-text text-muted small"><i class="@AppIcons.Tag me-2" aria-hidden="true"></i>v@_version</span>
                </li>
            </ul>
        </div>
    </div>
</nav>

@if (_runtimeMode.ActiveModes.Any())
{
    <div class="alert alert-warning rounded-0 mb-0 border-0">
        <div class="container-fluid px-2 px-md-4">
            <strong>Running mode:</strong> @string.Join(" · ", _runtimeMode.ActiveModes)
        </div>
    </div>
}

<main>
    <article class="content container-fluid px-2 px-md-4 py-3">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="container px-2 px-md-4 py-5">
                    <div class="alert alert-danger shadow-sm" role="alert">
                        <h4 class="alert-heading">Something went wrong</h4>
                        <p>An unexpected error occurred while loading this page. Please try again.</p>
                        <hr />
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-danger btn-sm" @onclick="ResetError"><i class="@AppIcons.Refresh me-1" aria-hidden="true"></i>Try Again</button>
                            <a href="/" class="btn btn-outline-secondary btn-sm"><i class="@AppIcons.Home me-1" aria-hidden="true"></i>Go to Dashboard</a>
                        </div>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload"><i class="@AppIcons.Refresh me-1" aria-hidden="true"></i>Reload</a>
    <span class="dismiss"><i class="@AppIcons.XMark" aria-hidden="true"></i></span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private AppRuntimeModeDto _runtimeMode = new();

    private string _version = System.Reflection.Assembly
        .GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0";

    protected override void OnInitialized()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
    }

    private void ResetError() => _errorBoundary?.Recover();
}
