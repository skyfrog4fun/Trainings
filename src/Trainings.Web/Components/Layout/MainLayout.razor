@inherits LayoutComponentBase
@using System.Globalization
@inject IAppRuntimeModeService AppRuntimeModeService
@inject Trainings.Web.Services.ThemeService ThemeService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResources> Localizer

<nav class="navbar app-navbar sticky-top shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand app-navbar-brand fw-bold" href="/"><i class="@AppIcons.Bolt me-2" aria-hidden="true"></i>@Localizer["Trainings"]</a>
        <div class="d-flex align-items-center gap-1 gap-md-2">
            <div class="dropdown app-language-dropdown">
                <button id="language-menu-button"
                        type="button"
                        class="btn btn-sm app-language-button dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        aria-expanded="false"
                        aria-label='@Localizer["Language"]'>
                    <i class="fa-solid fa-globe" aria-hidden="true"></i>
                    <span>@CurrentLanguageDisplayName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm app-language-menu">
                    @foreach (var option in LanguageOptions)
                    {
                        <li>
                            <a class="dropdown-item @(string.Equals(CurrentLanguage, option.Code, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                               href="@BuildCultureUrl(option.Code)">
                                @option.DisplayName
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <a class="btn app-theme-button"
               href="@BuildThemeToggleUrl()"
               role="switch"
               aria-checked="@IsDarkTheme"
               aria-label='@Localizer["DarkMode"]'>
                <i class="fa-solid @(IsDarkTheme ? "fa-moon" : "fa-sun")" aria-hidden="true"></i>
            </a>
            <div class="dropdown">
                <button class="btn app-menu-button" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label='@Localizer["OpenMenu"]'>
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm app-menu-dropdown">
                <li>
                    <NavLink class="dropdown-item" href="" Match="NavLinkMatch.All"><i class="@AppIcons.Home me-2" aria-hidden="true"></i>@Localizer["Dashboard"]</NavLink>
                </li>
                <AuthorizeView Policy="GroupAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="groups"><i class="@AppIcons.Group me-2" aria-hidden="true"></i>@Localizer["Groups"]</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="users"><i class="@AppIcons.Users me-2" aria-hidden="true"></i>@Localizer["Users"]</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupMember">
                    <li>
                        <NavLink class="dropdown-item" href="trainings"><i class="@AppIcons.Fire me-2" aria-hidden="true"></i>@Localizer["Trainings"]</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupMember">
                    <li>
                        <NavLink class="dropdown-item" href="my-registrations"><i class="@AppIcons.ClipboardList me-2" aria-hidden="true"></i>@Localizer["MyRegistrations"]</NavLink>
                    </li>
                </AuthorizeView>
                <AuthorizeView Policy="GroupTrainer">
                    <li>
                        <NavLink class="dropdown-item" href="plan-training"><i class="@AppIcons.Fire me-2" aria-hidden="true"></i>@Localizer["PlanTraining"]</NavLink>
                    </li>
                </AuthorizeView>
                <li><hr class="dropdown-divider" /></li>
                <AuthorizeView Policy="SuperAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="statistics"><i class="@AppIcons.ChartSimple me-2" aria-hidden="true"></i>@Localizer["Statistics"]</NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <NavLink class="dropdown-item" href="user-information"><i class="@AppIcons.User me-2" aria-hidden="true"></i>@Localizer["UserInformation"]</NavLink>
                </li>
                <AuthorizeView Policy="SuperAdmin">
                    <li>
                        <NavLink class="dropdown-item" href="config/mail"><i class="@AppIcons.Gear me-2" aria-hidden="true"></i>@Localizer["Config"]</NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="config/locations"><i class="@AppIcons.Location me-2" aria-hidden="true"></i>@Localizer["Locations"]</NavLink>
                    </li>
                    <li>
                        <NavLink class="dropdown-item" href="config/icons"><i class="@AppIcons.CircleInfo me-2" aria-hidden="true"></i>@Localizer["Icons"]</NavLink>
                    </li>
                </AuthorizeView>
                <li>
                    <a class="dropdown-item " href="/logout"><i class="@AppIcons.Logout me-2" aria-hidden="true"></i>@Localizer["Logout"]</a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <span class="dropdown-item-text text-muted small"><i class="@AppIcons.Tag me-2" aria-hidden="true"></i>v@_version</span>
                </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

@if (_runtimeMode.ActiveModes.Any())
{
    <div class="alert alert-warning rounded-0 mb-0 border-0">
        <div class="container-fluid px-2 px-md-4">
            <strong>Running mode:</strong> @string.Join(" · ", _runtimeMode.ActiveModes)
        </div>
    </div>
}

<main>
    <article class="content container-fluid px-2 px-md-4 py-3">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="container px-2 px-md-4 py-5">
                    <div class="alert alert-danger shadow-sm" role="alert">
                        <h4 class="alert-heading">@Localizer["SomethingWentWrong"]</h4>
                        <p>@Localizer["UnexpectedErrorLoadingPage"]</p>
                        <hr />
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-danger btn-sm" @onclick="ResetError"><i class="@AppIcons.Refresh me-1" aria-hidden="true"></i>@Localizer["TryAgain"]</button>
                            <a href="/" class="btn btn-outline-secondary btn-sm"><i class="@AppIcons.Home me-1" aria-hidden="true"></i>@Localizer["GoToDashboard"]</a>
                        </div>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["UnhandledErrorOccurred"]
    <a href="." class="reload"><i class="@AppIcons.Refresh me-1" aria-hidden="true"></i>@Localizer["Reload"]</a>
    <span class="dismiss"><i class="@AppIcons.XMark" aria-hidden="true"></i></span>
</div>

@code {
    private static readonly IReadOnlyList<(string Code, string DisplayName)> LanguageOptions =
    [
        ("de", "DE"),
        ("en", "EN")
    ];

    private ErrorBoundary? _errorBoundary;
    private AppRuntimeModeDto _runtimeMode = new();

    private string _version = System.Reflection.Assembly
        .GetExecutingAssembly().GetName().Version?.ToString(3) ?? "1.0.0";

    private bool IsDarkTheme => ThemeService.CurrentTheme == "dark";

    private string CurrentLanguage =>
        string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase)
            ? "en"
            : "de";

    private string CurrentLanguageDisplayName =>
        LanguageOptions.FirstOrDefault(x => string.Equals(x.Code, CurrentLanguage, StringComparison.OrdinalIgnoreCase)).DisplayName
        ?? "EN";

    protected override void OnInitialized()
    {
        _runtimeMode = AppRuntimeModeService.GetCurrent();
    }

    private string BuildCultureUrl(string culture)
    {
        var normalizedCulture = string.Equals(culture, "en", StringComparison.OrdinalIgnoreCase)
            ? "en"
            : "de";

        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUri)
            ? "/"
            : relativeUri.StartsWith("/", StringComparison.Ordinal) ? relativeUri : "/" + relativeUri;

        return $"/culture/set?culture={normalizedCulture}&returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private string BuildThemeToggleUrl()
    {
        var targetTheme = IsDarkTheme ? "light" : "dark";

        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativeUri)
            ? "/"
            : relativeUri.StartsWith("/", StringComparison.Ordinal) ? relativeUri : "/" + relativeUri;

        return $"/theme/set?value={targetTheme}&returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private void ResetError() => _errorBoundary?.Recover();
}
