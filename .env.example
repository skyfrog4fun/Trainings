# Environment variables for the Trainings application stack.
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.

# Initial admin user created by the database seeder on first run.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2025

# Test accounts for UI/UX testing (ui-ux-testing skill), one per practical role.
# These users are NOT auto-seeded — create them once via the SuperAdmin UI
# (Users -> Create user) with matching credentials and group role assignment.
TEST_GROUPADMIN_EMAIL=groupadmin@example.com
TEST_GROUPADMIN_PASSWORD=ChangeMe!2025
TEST_TRAINER_EMAIL=trainer@example.com
TEST_TRAINER_PASSWORD=ChangeMe!2025
TEST_PARTICIPANT_EMAIL=participant@example.com
TEST_PARTICIPANT_PASSWORD=ChangeMe!2025

# GitHub Container Registry repository (used in docker-compose.yml).
# Format: <github-username>/<repo-name>  (all lowercase)
GITHUB_REPOSITORY=skyfrog4fun/trainings

# SMTP / Email configuration is now managed via the admin panel (Mail Configurations).
# The SMTP_* environment variables are no longer needed.

# Server timezone (IANA name). Used when converting UTC timestamps to local time for display.
# Change this if your users are in a different timezone.
TZ=Europe/Zurich

# Public base URL of the application (used for links in emails).
# Set this to the publicly reachable URL, e.g. https://trainings.example.com
APP_BASE_URL=https://trainings.example.com

# Optional: Cloudflare Dynamic DNS updater
# Create a scoped API token in Cloudflare Dashboard > Profile > API Tokens
# with "Edit zone DNS" permissions for your zone only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE=example.com
# CLOUDFLARE_SUBDOMAIN=trainings
